#!/bin/sh
# Runs the self-contained publish by absolute path. No PATH or LD_LIBRARY_PATH changes: the .NET
# host finds its native libraries next to the executable, and anything exported here would be
# inherited by every game, Wine and Steam process RHI starts.
set -eu
HERE="${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
exec "$HERE/usr/bin/RHI" "$@"
