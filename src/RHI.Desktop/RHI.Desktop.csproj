<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RHI.Desktop</RootNamespace>
    <AssemblyName>RHI</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RHI.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- #192: What's new shows the fork's own changelog. -->
    <EmbeddedResource Include="../../CHANGELOG.md" LogicalName="RHI.Desktop.CHANGELOG.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RHI.Core/RHI.Core.csproj" />
    <ProjectReference Include="../RHI.Platform.Linux/RHI.Platform.Linux.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linux-only app over the Linux-only RHI.Platform.Linux; without this every call into it is CA1416. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
