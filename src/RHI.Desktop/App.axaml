<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RHI.Desktop.ViewModels"
             xmlns:dialogs="using:RHI.Desktop.Views.Dialogs"
             x:Class="RHI.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- #301: the colour brushes (RhiBackgroundBrush, RhiTextBrush, …) are put here at start-up by Theming/ThemeResources,
         in the default look or the saved colour theme, and replaced when the theme changes. Use them as DynamicResource. -->
    <ResourceDictionary>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Component dialogs bound from data templates (epic #89 unit 7): a dialog window's content is its view model. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:ProxyComponentDialogViewModel" x:DataType="vm:ProxyComponentDialogViewModel">
      <StackPanel Spacing="12" Margin="18">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Opacity="0.76"/>
        <TextBlock Text="{Binding RouteNote}" TextWrapping="Wrap" Foreground="{DynamicResource RhiWarningTextBrush}" IsVisible="{Binding HasRouteNote}"/>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12" IsVisible="{Binding HasGpu}">
          <TextBlock Text="{Binding GpuLabel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding SelectedGpu}" MinWidth="{Binding GpuMinWidth}"
                    IsEnabled="{Binding CanChoose}"/>
        </Grid>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12" IsVisible="{Binding HasProxy}">
          <TextBlock Text="{Binding ProxyLabel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <!-- #284: names in use are greyed with their component; ASI Loader's Hooked name is marked. -->
          <ComboBox Grid.Column="1" ItemsSource="{Binding ProxyNameOptions}" SelectedItem="{Binding SelectedProxyItem}" MinWidth="{Binding ProxyMinWidth}"
                    IsEnabled="{Binding CanChoose}" IsVisible="{Binding !ShowsProxyAsText}" ToolTip.Tip="{Binding ProxyTip}"
                    DisplayMemberBinding="{Binding Display, DataType=vm:ProxyNameItem}">
            <ComboBox.Styles>
              <Style Selector="ComboBoxItem" x:DataType="vm:ProxyNameItem">
                <Setter Property="IsEnabled" Value="{Binding IsFree}"/>
                <Setter Property="ToolTip.Tip" Value="{Binding Tip}"/>
              </Style>
            </ComboBox.Styles>
          </ComboBox>
          <!-- RTX Encore installed: its name cannot change, so it is plain text, not a dead dropdown (#158). -->
          <TextBlock Grid.Column="1" Text="{Binding SelectedProxy}" VerticalAlignment="Center" IsVisible="{Binding ShowsProxyAsText}"/>
        </Grid>
        <!-- w4/encore (#158): RTX Encore's Neural Rendering file; only that dialog has it. -->
        <CheckBox Content="{Binding NeuralRenderingLabel}" IsChecked="{Binding NeuralRenderingChosen}" IsVisible="{Binding HasNeuralRendering}"
                  IsEnabled="{Binding CanChangeNeuralRendering}" ToolTip.Tip="{Binding NeuralRenderingTip}"/>
        <TextBlock Text="{Binding CompatibilityText}" TextWrapping="Wrap" Opacity="0.74" IsVisible="{Binding HasCompatibility}"/>
        <!-- w14/extras-fg: headings, notes and gold warnings (Universal MFG Unlocker's plugin and XeMFG sections, #278). -->
        <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding HasLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComponentDialogLine">
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding IsHeading}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Opacity="0.74" IsVisible="{Binding IsPlain}"/>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource RhiWarningTextBrush}" IsVisible="{Binding IsWarning}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding InstalledText}" TextWrapping="Wrap" Opacity="0.74" IsVisible="{Binding IsInstalled}"/>
        <!-- w14/extras-fg: the mod's own settings by section (dropdowns or number boxes, help text under each), then its files. -->
        <ItemsControl ItemsSource="{Binding Sections}" IsVisible="{Binding HasSections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComponentSettingSection">
              <StackPanel Spacing="8" Margin="0,0,0,10">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding HasTitle}"/>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentSettingRow">
                      <StackPanel Margin="0,0,0,8">
                        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" MinWidth="240"
                                    IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsChoice}"/>
                          <TextBox Grid.Column="1" Text="{Binding NumberText, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left"
                                   IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsNumber}"/>
                        </Grid>
                        <TextBlock Text="{Binding Tip}" TextWrapping="Wrap" FontSize="11" Opacity="0.65" Margin="0,4,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding FileButtons}" IsVisible="{Binding HasFileButtons}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComponentFileButton">
              <Button Classes="rhi" Content="{Binding Label}" Command="{Binding OpenFileCommand}" IsEnabled="{Binding Exists}" Margin="0,0,8,8"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowsCheck}">
          <Button Classes="rhi" Content="{Binding CheckLabel}" Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}"/>
          <Button Classes="rhi" Content="{Binding UpdateLabel}" Command="{Binding UpdateCommand}" IsEnabled="{Binding CanUpdate}"/>
          <!-- The main window's overlay Cancel is behind this modal dialog: its own Cancel stops its update. -->
          <Button Classes="rhi" Content="{DynamicResource Ui.CancelOperation}" Command="{Binding Operations.CancelCommand}"
                  IsVisible="{Binding ShowCancel}"/>
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.82"/>
        <TextBlock Text="{Binding FooterNote}" TextWrapping="Wrap" FontSize="11" Opacity="0.65" IsVisible="{Binding FooterIsPlain}"/>
        <TextBlock Text="{Binding FooterNote}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource RhiWarningTextBrush}" Opacity="0.78" IsVisible="{Binding FooterIsWarning}"/>
      </StackPanel>
    </DataTemplate>
    <!-- Dialogs moved out of the main window's code-behind (epic #89): Views/Dialogs/*.axaml. -->
    <DataTemplate DataType="vm:DlssBatchDialogViewModel">
      <dialogs:DlssBatchDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:RenoDxSettingsDialogViewModel">
      <dialogs:RenoDxSettingsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:OptiScalerSettingsDialogViewModel">
      <dialogs:OptiScalerSettingsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:CustomGamesReviewViewModel">
      <dialogs:CustomGamesReviewDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:AddGameDialogViewModel">
      <dialogs:AddGameDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:EditGameDialogViewModel">
      <dialogs:EditGameDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ShaderAddonsDialogViewModel">
      <dialogs:ShaderAddonsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ShaderPackFilesDialogViewModel">
      <dialogs:ShaderPackFilesDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsDialogViewModel">
      <dialogs:SettingsDialogView/>
    </DataTemplate>
    <!-- w7/nvapi-launch (#211): the NVIDIA settings dialog. -->
    <DataTemplate DataType="vm:NvidiaSettingsDialogViewModel">
      <dialogs:NvidiaSettingsDialogView/>
    </DataTemplate>
    <!-- w11/nr-check (#234): the read-only Check Neural Rendering page (panel button and card menu). -->
    <DataTemplate DataType="vm:NeuralRenderingCheckDialogViewModel">
      <dialogs:NeuralRenderingCheckDialogView/>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <!-- Every generated/configuration window inherits the same RHI-Linux surface. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource RhiBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
      <Setter Property="FontFamily" Value="Inter"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
    </Style>

    <!-- Default controls intentionally match Button.rhi so code-created dialogs cannot fall back to Fluent defaults. -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiControlHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentStrongBrush}"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="{DynamicResource RhiControlPressedBrush}"/>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="{DynamicResource RhiDisabledBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiDisabledTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiDisabledBorderBrush}"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <Style Selector="Button.rhi">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
    </Style>
    <Style Selector="Button.rhi.remove">
      <Setter Property="Background" Value="{DynamicResource RhiRemoveBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiRemoveForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiRemoveBorderBrush}"/>
    </Style>
    <Style Selector="Button.rhi:disabled">
      <Setter Property="Background" Value="{DynamicResource RhiDisabledBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiDisabledTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiDisabledBorderBrush}"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="{DynamicResource RhiChipBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiChipTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiChipHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiChipHoverTextBrush}"/>
    </Style>

    <!-- #300: the active collection chip; #193's custom filter chips use the same look. -->
    <Style Selector="Button.chip.active">
      <Setter Property="Background" Value="{DynamicResource RhiChipActiveBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiChipActiveTextBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).error">
      <Setter Property="Foreground" Value="{DynamicResource RhiErrorTextBrush}"/>
    </Style>
    <!-- #301: code-built views take their colours from these classes, so they follow the colour theme. -->
    <Style Selector="Button.chip.customFilterSave">
      <Setter Property="Foreground" Value="{DynamicResource RhiChipSaveTextBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).warningText">
      <Setter Property="Foreground" Value="{DynamicResource RhiWarningTextBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).warningStatusText">
      <Setter Property="Foreground" Value="{DynamicResource RhiWarningBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).alertText">
      <Setter Property="Foreground" Value="{DynamicResource RhiAlertBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).installedText">
      <Setter Property="Foreground" Value="{DynamicResource RhiInstalledBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).updateText">
      <Setter Property="Foreground" Value="{DynamicResource RhiUpdateBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).linkText">
      <Setter Property="Foreground" Value="{DynamicResource RhiLinkBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).mutedText">
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).headingText">
      <Setter Property="Foreground" Value="{DynamicResource RhiHeadingBrush}"/>
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Background" Value="{DynamicResource RhiBorderBrush}"/>
    </Style>
    <Style Selector="Border.dividerStrong">
      <Setter Property="Background" Value="{DynamicResource RhiDividerBrush}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource RhiAccentStrongBrush}"/>
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>

    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource RhiSidebarBrush}"/>
      <Setter Property="Padding" Value="12,7"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource RhiSelectedTabBrush}"/>
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource RhiSidebarBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- The toolbar '…' overflow menu and the library card menu use the tooltip surface and the button text colour
         (scoped: other menus, e.g. text-box context menus, keep the theme defaults). -->
    <Style Selector="MenuFlyoutPresenter.toolbarOverflow">
      <Setter Property="Background" Value="{DynamicResource RhiSidebarBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="MenuItem.toolbarOverflow">
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource RhiSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
  </Application.Styles>
</Application>
