<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RHI.Desktop.ViewModels"
             xmlns:dialogs="using:RHI.Desktop.Views.Dialogs"
             xmlns:views="using:RHI.Desktop.Views"
             xmlns:l="using:RHI.Desktop.Localization"
             x:Class="RHI.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- #301: the colour brushes (RhiBackgroundBrush, RhiTextBrush, …) are put here at start-up by Theming/ThemeResources,
         in the default look or the saved colour theme, and replaced when the theme changes. Use them as DynamicResource. -->
    <ResourceDictionary>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Component dialogs bound from data templates (epic #89 unit 7): a dialog window's content is its view model. -->
  <Application.DataTemplates>
    <!-- w14/ui-settings (#297): the FG unlocks', DLSS Enabler's and RTX Encore's ⚙ on the shared ⚙ layout (Views/Cog): loose
         intro / warning text, cards, each setting's name left with its option beside it and the explanation under it (RTX
         Encore's sections two per row, as upstream), the Files card, and the status line inside the ⚙. The frame (title,
         scroll, Close) is CogWindow's. -->
    <DataTemplate DataType="vm:ProxyComponentDialogViewModel" x:DataType="vm:ProxyComponentDialogViewModel">
      <StackPanel Spacing="14">
        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Classes="cogIntro"/>
        <TextBlock Text="{Binding RouteNote}" TextWrapping="Wrap" Classes="cogWarning" IsVisible="{Binding HasRouteNote}"/>
        <views:CogCard IsVisible="{Binding HasChoiceCard}">
          <views:CogRow Label="{Binding GpuLabel}" IsVisible="{Binding HasGpu}">
            <ComboBox ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding SelectedGpu}" IsEnabled="{Binding CanChoose}"
                      ToolTip.Tip="{Binding LockedTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000"/>
          </views:CogRow>
          <views:CogRow Label="{Binding ProxyLabel}" Help="{Binding ProxyTip}" IsVisible="{Binding HasProxy}">
            <Panel>
              <!-- #284: names in use are greyed with their component; ASI Loader's Hooked name is marked. -->
              <ComboBox ItemsSource="{Binding ProxyNameOptions}" SelectedItem="{Binding SelectedProxyItem}" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding CanChoose}" IsVisible="{Binding !ShowsProxyAsText}"
                        ToolTip.Tip="{Binding ProxyChoiceTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000"
                        DisplayMemberBinding="{Binding Display, DataType=vm:ProxyNameItem}">
                <ComboBox.Styles>
                  <Style Selector="ComboBoxItem" x:DataType="vm:ProxyNameItem">
                    <Setter Property="IsEnabled" Value="{Binding IsFree}"/>
                    <Setter Property="ToolTip.Tip" Value="{Binding Tip}"/>
                  </Style>
                </ComboBox.Styles>
              </ComboBox>
              <!-- RTX Encore installed: its name cannot change, so it is plain text, not a dead dropdown (#158). -->
              <TextBlock Text="{Binding SelectedProxy}" VerticalAlignment="Center" Classes="cogLabel" IsVisible="{Binding ShowsProxyAsText}"/>
            </Panel>
          </views:CogRow>
          <!-- w4/encore (#158): RTX Encore's Neural Rendering file; only that dialog has it. -->
          <views:CogRow Label="{Binding NeuralRenderingLabel}" Help="{Binding NeuralRenderingTip}" IsVisible="{Binding HasNeuralRendering}">
            <CheckBox IsChecked="{Binding NeuralRenderingChosen}" IsEnabled="{Binding CanChangeNeuralRendering}"/>
          </views:CogRow>
          <TextBlock Text="{Binding CompatibilityText}" TextWrapping="Wrap" Classes="cogNote" IsVisible="{Binding HasCompatibility}"/>
          <TextBlock Text="{Binding InstalledText}" TextWrapping="Wrap" Classes="cogNote" IsVisible="{Binding IsInstalled}"/>
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding ShowsCheck}">
            <Button Classes="rhi secondary" Content="{Binding CheckLabel}" Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}"/>
            <Button Classes="rhi" Content="{Binding UpdateLabel}" Command="{Binding UpdateCommand}" IsEnabled="{Binding CanUpdate}"/>
            <!-- The main window's overlay Cancel is behind this modal dialog: its own Cancel stops its update. -->
            <Button Classes="rhi secondary" Content="{DynamicResource Ui.CancelOperation}" Command="{Binding Operations.CancelCommand}"
                    IsVisible="{Binding ShowCancel}"/>
          </WrapPanel>
        </views:CogCard>
        <!-- w14/extras-fg: notes and gold warnings; a heading starts its own card (Universal MFG Unlocker's plugin and XeMFG, #278). -->
        <ItemsControl ItemsSource="{Binding LineCards}" IsVisible="{Binding HasLines}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="14"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComponentLineCard">
              <Panel>
                <views:CogCard Header="{Binding Heading}" IsVisible="{Binding IsCard}">
                  <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ComponentDialogLine">
                        <Panel>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="cogIntro" IsVisible="{Binding IsPlain}"/>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="cogWarning" IsVisible="{Binding IsWarning}"/>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </views:CogCard>
                <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding IsLoose}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentDialogLine">
                      <Panel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="cogIntro" IsVisible="{Binding IsPlain}"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="cogWarning" IsVisible="{Binding IsWarning}"/>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- w14/extras-fg: the mod's own settings, one card per section; a change is saved at once and a refused one goes back. -->
        <ItemsControl ItemsSource="{Binding Sections}" IsVisible="{Binding HasSections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="14"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComponentSettingSection">
              <views:CogCard Header="{Binding Title}">
                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsListed}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentSettingRow">
                      <views:CogRow Label="{Binding Label}" Help="{Binding Tip}">
                        <Panel>
                          <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsChoice}"
                                    ToolTip.Tip="{Binding ControlTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000"/>
                          <TextBox Text="{Binding NumberText, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left"
                                   IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsNumber}"
                                   ToolTip.Tip="{Binding ControlTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000"/>
                        </Panel>
                      </views:CogRow>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding Compact}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><views:CogCompactGrid/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentSettingRow">
                      <views:CogCell Label="{Binding Label}" Help="{Binding Tip}">
                        <Panel>
                          <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsChoice}"
                                    ToolTip.Tip="{Binding ControlTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000"/>
                          <TextBox Text="{Binding NumberText, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Stretch"
                                   IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsNumber}"
                                   ToolTip.Tip="{Binding ControlTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000"/>
                        </Panel>
                      </views:CogCell>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </views:CogCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Upstream's Files card: Open <the mod's ini / log / jsonc>, disabled while the file is missing. -->
        <views:CogCard Header="{l:T Cog.Files}" IsVisible="{Binding HasFileButtons}">
          <ItemsControl ItemsSource="{Binding FileButtons}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ComponentFileButton">
                <Button Classes="rhi secondary cogOpenFile" Content="{Binding Label}" Command="{Binding OpenFileCommand}" IsEnabled="{Binding Exists}"
                        ToolTip.Tip="{Binding Path}" ToolTip.ShowDelay="2000"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </views:CogCard>
        <TextBlock Text="{Binding FooterNote}" TextWrapping="Wrap" Classes="cogNote" IsVisible="{Binding FooterIsPlain}"/>
        <TextBlock Text="{Binding FooterNote}" TextWrapping="Wrap" Classes="cogWarning" IsVisible="{Binding FooterIsWarning}"/>
        <!-- #297: results and errors inside the ⚙ (upstream's status line). -->
        <TextBlock Name="CogStatus" Text="{Binding Message}" TextWrapping="Wrap" Classes="cogStatus" IsVisible="{Binding HasMessage}"/>
      </StackPanel>
    </DataTemplate>
    <!-- Dialogs moved out of the main window's code-behind (epic #89): Views/Dialogs/*.axaml. -->
    <DataTemplate DataType="vm:DlssBatchDialogViewModel">
      <dialogs:DlssBatchDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:RenoDxSettingsDialogViewModel">
      <dialogs:RenoDxSettingsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:OptiScalerSettingsDialogViewModel">
      <dialogs:OptiScalerSettingsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:CustomGamesReviewViewModel">
      <dialogs:CustomGamesReviewDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:AddGameDialogViewModel">
      <dialogs:AddGameDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:EditGameDialogViewModel">
      <dialogs:EditGameDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ShaderAddonsDialogViewModel">
      <dialogs:ShaderAddonsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ShaderPackFilesDialogViewModel">
      <dialogs:ShaderPackFilesDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsDialogViewModel">
      <dialogs:SettingsDialogView/>
    </DataTemplate>
    <!-- w7/nvapi-launch (#211): the NVIDIA settings dialog. -->
    <DataTemplate DataType="vm:NvidiaSettingsDialogViewModel">
      <dialogs:NvidiaSettingsDialogView/>
    </DataTemplate>
    <!-- w11/nr-check (#234): the read-only Check Neural Rendering page (panel button and card menu). -->
    <DataTemplate DataType="vm:NeuralRenderingCheckDialogViewModel">
      <dialogs:NeuralRenderingCheckDialogView/>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <!-- w14/layouts-a (#301 owner decision): Custom theme colours have a real colour picker. -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>

    <!-- Every generated/configuration window inherits the same RHI-Linux surface: w14/layouts-a (#303, upstream 2.9.0) the
         dark navy page every pop-up uses (the main window keeps its own background). -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPageBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
      <Setter Property="FontFamily" Value="Inter"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
    </Style>

    <!-- Default controls intentionally match Button.rhi so code-created dialogs cannot fall back to Fluent defaults. -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiControlHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentStrongBrush}"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="{DynamicResource RhiControlPressedBrush}"/>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="{DynamicResource RhiDisabledBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiDisabledTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiDisabledBorderBrush}"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <Style Selector="Button.rhi">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
    </Style>
    <Style Selector="Button.rhi.remove">
      <Setter Property="Background" Value="{DynamicResource RhiRemoveBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiRemoveForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiRemoveBorderBrush}"/>
    </Style>
    <Style Selector="Button.rhi:disabled">
      <Setter Property="Background" Value="{DynamicResource RhiDisabledBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiDisabledTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiDisabledBorderBrush}"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="{DynamicResource RhiChipBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiChipTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiChipHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiChipHoverTextBrush}"/>
    </Style>

    <!-- #300: the active collection chip; #193's custom filter chips use the same look. -->
    <Style Selector="Button.chip.active">
      <Setter Property="Background" Value="{DynamicResource RhiChipActiveBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiChipActiveTextBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).error">
      <Setter Property="Foreground" Value="{DynamicResource RhiErrorTextBrush}"/>
    </Style>
    <!-- #301: code-built views take their colours from these classes, so they follow the colour theme. -->
    <Style Selector="Button.chip.customFilterSave">
      <Setter Property="Foreground" Value="{DynamicResource RhiChipSaveTextBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).warningText">
      <Setter Property="Foreground" Value="{DynamicResource RhiWarningTextBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).warningStatusText">
      <Setter Property="Foreground" Value="{DynamicResource RhiWarningBrush}"/>
    </Style>
    <!-- w14/layouts-a: error lines in code-built Settings rows (were Brushes.IndianRed). -->
    <Style Selector=":is(TextBlock).errorText">
      <Setter Property="Foreground" Value="{DynamicResource RhiErrorTextBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).alertText">
      <Setter Property="Foreground" Value="{DynamicResource RhiAlertBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).installedText">
      <Setter Property="Foreground" Value="{DynamicResource RhiInstalledBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).updateText">
      <Setter Property="Foreground" Value="{DynamicResource RhiUpdateBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).linkText">
      <Setter Property="Foreground" Value="{DynamicResource RhiLinkBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).mutedText">
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
    </Style>
    <Style Selector=":is(TextBlock).headingText">
      <Setter Property="Foreground" Value="{DynamicResource RhiHeadingBrush}"/>
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Background" Value="{DynamicResource RhiBorderBrush}"/>
    </Style>
    <Style Selector="Border.dividerStrong">
      <Setter Property="Background" Value="{DynamicResource RhiDividerBrush}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource RhiAccentStrongBrush}"/>
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>

    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource RhiSidebarBrush}"/>
      <Setter Property="Padding" Value="12,7"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource RhiSelectedTabBrush}"/>
    </Style>

    <!-- w14/layouts-a (#303, upstream 2.9.0): tooltips everywhere use the dark navy look. -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource RhiNavyCardBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavySecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- Flyouts (the ⚙ Game settings panel, preset rename): the theme caps the box at 456 px and scrolls content sideways,
         which cut the left of wider panels off. Room for a 520 px panel, and content wraps to the box instead of scrolling. -->
    <Style Selector="FlyoutPresenter">
      <Setter Property="MaxWidth" Value="560"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- The toolbar '…' overflow menu and the library card menu use the tooltip surface and the button text colour
         (scoped: other menus, e.g. text-box context menus, keep the theme defaults). -->
    <Style Selector="MenuFlyoutPresenter.toolbarOverflow">
      <Setter Property="Background" Value="{DynamicResource RhiNavyCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="MenuItem.toolbarOverflow">
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- w14/layouts-a (#303): menus opened from the top bar (Help, Shaders & Addons) and the game menus, navy. -->
    <Style Selector="MenuFlyoutPresenter.navy, ContextMenu.navy">
      <Setter Property="Background" Value="{DynamicResource RhiNavyCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter.navy MenuItem, ContextMenu.navy MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyControlTextBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- w14/layouts-a (#303): the top bar (mockup A tokens: 38 px controls, radius 8). -->
    <Style Selector="Border#TopBar">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
    </Style>
    <Style Selector="Button.topNav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavySecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.topNav:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiNavyNavHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
    </Style>
    <Style Selector="Button.topNav TextBlock">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
    </Style>
    <Style Selector="Border.newTag">
      <Setter Property="Background" Value="{DynamicResource RhiNavyNewTagBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="7,1"/>
    </Style>
    <Style Selector="Border.newTag TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyValueBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.topChecked">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyMutedTextBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Border#TopBar Button.rhi">
      <Setter Property="Background" Value="{DynamicResource RhiNavyIconButtonBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyControlTextBrush}"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border#TopBar Button.rhi:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiNavyNavHoverBrush}"/>
    </Style>
    <Style Selector="Button.topIcon">
      <Setter Property="MinWidth" Value="38"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="Border#TopBar Button.rhi.topIcon.on">
      <Setter Property="Background" Value="{DynamicResource RhiNavySegmentOnBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyAccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
    </Style>
    <Style Selector="Border#TopBar Button.rhi.updateAll.hasUpdates">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPurpleButtonBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyPurpleButtonBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyPurpleButtonTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border#TopBar Button.rhi.updateAll.hasUpdates:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPurpleButtonHoverBrush}"/>
    </Style>
    <!-- w14/layouts-c: "✓ All up to date" (upstream: a green tick on the quiet button) and the game list's update mark. -->
    <Style Selector="Border#TopBar Button.rhi.updateAll TextBlock.upToDateTick">
      <Setter Property="Foreground" Value="{DynamicResource RhiInstalledBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Border.gameRow">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiGameRowBorderBrush}"/>
    </Style>
    <Style Selector="Border.gameRow.hasUpdate">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiUpdateBrush}"/>
    </Style>
    <Style Selector="Border#TopBar Button.rhi TextBlock">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
    </Style>
    <Style Selector="Border.countTag">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPurpleButtonBorderBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,1"/>
    </Style>
    <Style Selector="Border.countTag TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyCountTagTextBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- w14/layouts-a (#303): the segmented switches (layout switch; All / Installed / Favourites / Hidden). -->
    <Style Selector="Border.segmentTrack">
      <Setter Property="Background" Value="{DynamicResource RhiNavyCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavySecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="views|SegmentedSwitch#LibraryMainFilter Button.segment">
      <Setter Property="Padding" Value="2,4"/>
    </Style>
    <Style Selector="Button.segment:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiNavyNavHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
    </Style>
    <Style Selector="Button.segment.on">
      <Setter Property="Background" Value="{DynamicResource RhiNavySegmentOnBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.segment:disabled">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyMutedTextBrush}"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <!-- w14/layouts-a (#303): the game list in the navy look (every layout). -->
    <Style Selector="Border#LibrarySidebar">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
    </Style>
    <Style Selector="Border#LibrarySidebar Border#LibraryFilterBar, Border#LibrarySidebar > LayoutTransformControl > Grid > Border">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPanelBrush}"/>
    </Style>
    <Style Selector="Button.addGame">
      <Setter Property="Background" Value="{DynamicResource RhiNavyGreenPillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyGreenPillBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyValueBrush}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleButton.filters">
      <Setter Property="Background" Value="{DynamicResource RhiNavyIconButtonBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyControlTextBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style Selector="ToggleButton.filters:checked /template/ ContentPresenter, ToggleButton.filters:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RhiNavySegmentOnBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
    </Style>
    <Style Selector="ListBox#GameLibraryList ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RhiNavyRowSelectedBrush}"/>
    </Style>
    <Style Selector="ListBox#GameLibraryList ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RhiNavyRowHoverBrush}"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource RhiSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- w14/layouts-a (#304): the Tabs layout (mockup A tokens: page #0B0F17, cards #121824 / #1F2737, radius 12, padding 16). -->
    <Style Selector="ScrollViewer#DetailScroller.tabsPage">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPageBrush}"/>
    </Style>
    <Style Selector="Border.card.tabsCard">
      <Setter Property="Background" Value="{DynamicResource RhiNavyCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="Border#ManagedComponentsSection.tabsCard">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ItemsControl.cards ContentPresenter > Border">
      <Setter Property="Background" Value="{DynamicResource RhiNavyCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="172"/>
    </Style>
    <Style Selector="Border.tabStrip">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="Button.tabButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="0,10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavySecondaryTextBrush}"/>
    </Style>
    <Style Selector="Button.tabButton:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
    </Style>
    <Style Selector="Button.tabButton.on">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyAccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.tabsStar">
      <Setter Property="Background" Value="{DynamicResource RhiNavyIconButtonBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyMutedTextBrush}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <!-- The favourite star: amber, its own theme key (RhiFavouriteBrush; upstream FavLook). -->
    <Style Selector="Button.tabsStar.on">
      <Setter Property="Background" Value="{DynamicResource RhiFavouriteTintBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiFavouriteBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiFavouriteBrush}"/>
    </Style>
    <Style Selector="Border.tabsTag">
      <Setter Property="Background" Value="{DynamicResource RhiNavyRowHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="Border.tabsTag TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavySecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.tabsLink">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyLinkBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.tabsLink:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
    </Style>
    <Style Selector="Button.tabsLaunch">
      <Setter Property="Background" Value="{DynamicResource RhiNavyBlueButtonBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyBlueButtonBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyBlueButtonTextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="8,0,0,8"/>
    </Style>
    <Style Selector="Button.tabsLaunch:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiNavyBlueButtonHoverBrush}"/>
    </Style>
    <Style Selector="Button.tabsLaunch.menu">
      <Setter Property="CornerRadius" Value="0,8,8,0"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="BorderThickness" Value="0,1,1,1"/>
    </Style>
    <Style Selector="TextBlock.glanceHeading">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyMutedTextBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="1"/>
    </Style>
    <Style Selector="Button.glanceTile">
      <Setter Property="Background" Value="{DynamicResource RhiNavyCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style Selector="Button.glanceTile:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiNavyRowHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
    </Style>
    <Style Selector="TextBlock.glanceTitle">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.glanceSummary">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyValueBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- Game Overrides' ReShade card (Classic+ and Tabs). -->
    <Style Selector="Border.subCard">
      <Setter Property="Background" Value="{DynamicResource RhiPanelInsetBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiPanelInsetBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="TextBlock.subCardTitle">
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- Management: one row of buttons in Classic+, tiles with a line each in Tabs (upstream). -->
    <Style Selector="Button.managementTile">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style Selector="TextBlock.tileTitle">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.tileDesc">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="views|AutoFitPanel.tiles Button.managementTile">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="views|AutoFitPanel.tiles TextBlock.tileTitle">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="views|AutoFitPanel.tiles TextBlock.tileDesc">
      <Setter Property="IsVisible" Value="True"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavySecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- The ⚙ on the page (Tabs). -->
    <Style Selector="Border.inlineCog">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPageBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyAccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>

    <!-- w14/ui-settings (#296/#297): the Settings page's one layout (upstream Themes/DarkTheme.xaml Settings* styles), from
         the theme resources only so colour themes apply. -->
    <Style Selector="Border.settingsCard">
      <Setter Property="Background" Value="{DynamicResource RhiSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,16"/>
    </Style>
    <Style Selector="Border.settingsRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0,2"/>
    </Style>
    <Style Selector="Border.settingsFooter">
      <Setter Property="Background" Value="{DynamicResource RhiSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style Selector="TextBlock.settingsHelp">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.settingsCardTitle">
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.settingsResultContext">
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
    </Style>
    <Style Selector="Button.settingsNav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Button.settingsNav.active">
      <Setter Property="Background" Value="{DynamicResource RhiControlPressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
    </Style>
    <Style Selector="Button.settingsResult">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="Button.settingsPrimary">
      <Setter Property="Background" Value="{DynamicResource RhiControlPressedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
    </Style>

    <!-- w14/ui-settings (#297): the shared component ⚙ layout (Views/Cog: CogDialog, CogWindow, CogCard, CogRow, CogCell). -->
    <Style Selector="TextBlock.cogTitle">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
    </Style>
    <Style Selector="Border.cogCard">
      <Setter Property="Background" Value="{DynamicResource RhiCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18,16"/>
    </Style>
    <Style Selector="TextBlock.cogHeading">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="0.6"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogLabel">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogHelp">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogIntro">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogEmpty">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogWarning">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiWarningTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogNote">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogStatus">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogStatus.success">
      <Setter Property="Foreground" Value="{DynamicResource RhiInstalledBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogStatus.error">
      <Setter Property="Foreground" Value="{DynamicResource RhiRemoveForegroundBrush}"/>
    </Style>
    <Style Selector="Border.cogButtonBar">
      <Setter Property="Background" Value="{DynamicResource RhiToolbarBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>
    <Style Selector="Button.rhi.secondary">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
    </Style>
    <Style Selector="Button.rhi.secondary:disabled">
      <Setter Property="Foreground" Value="{DynamicResource RhiDisabledTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiDisabledBorderBrush}"/>
    </Style>
    <!-- w14/ui-settings (small) rows -->
    <!-- #309 (upstream 2.8.9 ApplyFavouriteButtonStyle): a quiet Favourite button, amber text once favourited. -->
    <Style Selector="Button.rhi.favourite">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
    </Style>
    <Style Selector="Button.rhi.favourite.on">
      <Setter Property="Foreground" Value="{DynamicResource RhiFavouriteBrush}"/>
    </Style>
    <!-- #309 (upstream 2.8.9): a greyed library name means ReShade isn't installed for that game. -->
    <Style Selector="TextBlock.libraryName">
      <Setter Property="Foreground" Value="{DynamicResource RhiGameRowTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.libraryName.noReShade">
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
    </Style>
    <!-- #309 (upstream 2.8.9): the store badge opens the game's Steam Community page when its app id is known. -->
    <Style Selector="Border.storeLink">
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- #309 (upstream 2.9.0): a link inside the message of the day's text. -->
    <Style Selector="Button.motdLink">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.motdLink:pointerover">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- #309 (upstream 2.8.9): the Quick Start's step badges and tip boxes. -->
    <Style Selector="Border.quickStartBadge">
      <Setter Property="Background" Value="{DynamicResource RhiAccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.quickStartBadge">
      <Setter Property="Foreground" Value="{DynamicResource RhiBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.quickStartTip">
      <Setter Property="Background" Value="{DynamicResource RhiSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <!-- #309 (upstream 2.9.2): What's New's version list. -->
    <Style Selector="Button.whatsNewItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="Button.whatsNewItem.selected">
      <Setter Property="Background" Value="{DynamicResource RhiControlHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Application.Styles>
</Application>
