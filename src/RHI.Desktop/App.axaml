<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RHI.Desktop.ViewModels"
             xmlns:dialogs="using:RHI.Desktop.Views.Dialogs"
             x:Class="RHI.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="RhiBackgroundBrush">#121518</SolidColorBrush>
      <SolidColorBrush x:Key="RhiSurfaceBrush">#141820</SolidColorBrush>
      <SolidColorBrush x:Key="RhiControlBrush">#151A22</SolidColorBrush>
      <SolidColorBrush x:Key="RhiControlHoverBrush">#1A2430</SolidColorBrush>
      <SolidColorBrush x:Key="RhiControlPressedBrush">#102331</SolidColorBrush>
      <SolidColorBrush x:Key="RhiBorderBrush">#1E2630</SolidColorBrush>
      <SolidColorBrush x:Key="RhiAccentBorderBrush">#1E4858</SolidColorBrush>
      <SolidColorBrush x:Key="RhiAccentBrush">#4DC9E6</SolidColorBrush>
      <SolidColorBrush x:Key="RhiTextBrush">#E8ECF2</SolidColorBrush>
      <SolidColorBrush x:Key="RhiSecondaryTextBrush">#A0AABB</SolidColorBrush>
      <SolidColorBrush x:Key="RhiMutedTextBrush">#6B7A8E</SolidColorBrush>
      <SolidColorBrush x:Key="RhiRemoveBackgroundBrush">#281818</SolidColorBrush>
      <SolidColorBrush x:Key="RhiRemoveForegroundBrush">#E07A7A</SolidColorBrush>
      <SolidColorBrush x:Key="RhiRemoveBorderBrush">#563030</SolidColorBrush>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Component dialogs bound from data templates (epic #89 unit 7): a dialog window's content is its view model. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:ProxyComponentDialogViewModel" x:DataType="vm:ProxyComponentDialogViewModel">
      <StackPanel Spacing="12" Margin="18">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Opacity="0.76"/>
        <TextBlock Text="{Binding RouteNote}" TextWrapping="Wrap" Foreground="#D7B65A" IsVisible="{Binding HasRouteNote}"/>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12" IsVisible="{Binding HasGpu}">
          <TextBlock Text="{Binding GpuLabel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding SelectedGpu}" MinWidth="{Binding GpuMinWidth}"
                    IsEnabled="{Binding CanChoose}"/>
        </Grid>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="12">
          <TextBlock Text="{Binding ProxyLabel}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding ProxyOptions}" SelectedItem="{Binding SelectedProxy}" MinWidth="{Binding ProxyMinWidth}"
                    IsEnabled="{Binding CanChoose}" IsVisible="{Binding !ShowsProxyAsText}" ToolTip.Tip="{Binding ProxyTip}"/>
          <!-- RTX Encore installed: its name cannot change, so it is plain text, not a dead dropdown (#158). -->
          <TextBlock Grid.Column="1" Text="{Binding SelectedProxy}" VerticalAlignment="Center" IsVisible="{Binding ShowsProxyAsText}"/>
        </Grid>
        <!-- w4/encore (#158): RTX Encore's Neural Rendering file; only that dialog has it. -->
        <CheckBox Content="{Binding NeuralRenderingLabel}" IsChecked="{Binding NeuralRenderingChosen}" IsVisible="{Binding HasNeuralRendering}"
                  IsEnabled="{Binding CanChangeNeuralRendering}" ToolTip.Tip="{Binding NeuralRenderingTip}"/>
        <TextBlock Text="{Binding CompatibilityText}" TextWrapping="Wrap" Opacity="0.74" IsVisible="{Binding HasCompatibility}"/>
        <TextBlock Text="{Binding InstalledText}" TextWrapping="Wrap" Opacity="0.74" IsVisible="{Binding IsInstalled}"/>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsInstalled}">
          <Button Classes="rhi" Content="{Binding CheckLabel}" Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}"/>
          <Button Classes="rhi" Content="{Binding UpdateLabel}" Command="{Binding UpdateCommand}" IsEnabled="{Binding CanUpdate}"/>
          <!-- The main window's overlay Cancel is behind this modal dialog: its own Cancel stops its update. -->
          <Button Classes="rhi" Content="{DynamicResource Ui.CancelOperation}" Command="{Binding Operations.CancelCommand}"
                  IsVisible="{Binding ShowCancel}"/>
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.82"/>
        <TextBlock Text="{Binding FooterNote}" TextWrapping="Wrap" FontSize="11" Opacity="0.65" IsVisible="{Binding FooterIsPlain}"/>
        <TextBlock Text="{Binding FooterNote}" TextWrapping="Wrap" FontSize="11" Foreground="#D7B65A" Opacity="0.78" IsVisible="{Binding FooterIsWarning}"/>
      </StackPanel>
    </DataTemplate>
    <!-- Dialogs moved out of the main window's code-behind (epic #89): Views/Dialogs/*.axaml. -->
    <DataTemplate DataType="vm:DlssBatchDialogViewModel">
      <dialogs:DlssBatchDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:RenoDxSettingsDialogViewModel">
      <dialogs:RenoDxSettingsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:OptiScalerSettingsDialogViewModel">
      <dialogs:OptiScalerSettingsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:AddGameDialogViewModel">
      <dialogs:AddGameDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:EditGameDialogViewModel">
      <dialogs:EditGameDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ShaderAddonsDialogViewModel">
      <dialogs:ShaderAddonsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ShaderPackFilesDialogViewModel">
      <dialogs:ShaderPackFilesDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsDialogViewModel">
      <dialogs:SettingsDialogView/>
    </DataTemplate>
    <!-- w7/nvapi-launch (#211): the NVIDIA settings dialog. -->
    <DataTemplate DataType="vm:NvidiaSettingsDialogViewModel">
      <dialogs:NvidiaSettingsDialogView/>
    </DataTemplate>
    <!-- w11/nr-check (#234): the read-only Check Neural Rendering page (panel button and card menu). -->
    <DataTemplate DataType="vm:NeuralRenderingCheckDialogViewModel">
      <dialogs:NeuralRenderingCheckDialogView/>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <!-- Every generated/configuration window inherits the same RHI-Linux surface. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource RhiBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
      <Setter Property="FontFamily" Value="Inter"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
    </Style>

    <!-- Default controls intentionally match Button.rhi so code-created dialogs cannot fall back to Fluent defaults. -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiControlHoverBrush}"/>
      <Setter Property="BorderBrush" Value="#2A6378"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="{DynamicResource RhiControlPressedBrush}"/>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="#17191D"/>
      <Setter Property="Foreground" Value="#626A75"/>
      <Setter Property="BorderBrush" Value="#292D34"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <Style Selector="Button.rhi">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
    </Style>
    <Style Selector="Button.rhi.remove">
      <Setter Property="Background" Value="{DynamicResource RhiRemoveBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiRemoveForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiRemoveBorderBrush}"/>
    </Style>
    <Style Selector="Button.rhi:disabled">
      <Setter Property="Background" Value="#17191D"/>
      <Setter Property="Foreground" Value="#626A75"/>
      <Setter Property="BorderBrush" Value="#292D34"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="#1A2030"/>
      <Setter Property="Foreground" Value="#8898B0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.chip:pointerover">
      <Setter Property="Background" Value="#202A3A"/>
      <Setter Property="Foreground" Value="#B8C9E0"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="SelectionBrush" Value="#2A6378"/>
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>

    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="Background" Value="#101419"/>
      <Setter Property="Padding" Value="12,7"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="Background" Value="#14212A"/>
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#101419"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- The toolbar '…' overflow menu and the library card menu use the tooltip surface and the button text colour
         (scoped: other menus, e.g. text-box context menus, keep the theme defaults). -->
    <Style Selector="MenuFlyoutPresenter.toolbarOverflow">
      <Setter Property="Background" Value="#101419"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="MenuItem.toolbarOverflow">
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource RhiSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="#1E2430"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
  </Application.Styles>
</Application>
