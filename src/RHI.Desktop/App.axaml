<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RHI.Desktop.ViewModels"
             xmlns:dialogs="using:RHI.Desktop.Views.Dialogs"
             xmlns:views="using:RHI.Desktop.Views"
             xmlns:l="using:RHI.Desktop.Localization"
             x:Class="RHI.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="RhiBackgroundBrush">#121518</SolidColorBrush>
      <SolidColorBrush x:Key="RhiSurfaceBrush">#141820</SolidColorBrush>
      <SolidColorBrush x:Key="RhiControlBrush">#151A22</SolidColorBrush>
      <SolidColorBrush x:Key="RhiControlHoverBrush">#1A2430</SolidColorBrush>
      <SolidColorBrush x:Key="RhiControlPressedBrush">#102331</SolidColorBrush>
      <SolidColorBrush x:Key="RhiBorderBrush">#1E2630</SolidColorBrush>
      <SolidColorBrush x:Key="RhiAccentBorderBrush">#1E4858</SolidColorBrush>
      <SolidColorBrush x:Key="RhiAccentBrush">#4DC9E6</SolidColorBrush>
      <SolidColorBrush x:Key="RhiTextBrush">#E8ECF2</SolidColorBrush>
      <SolidColorBrush x:Key="RhiSecondaryTextBrush">#A0AABB</SolidColorBrush>
      <SolidColorBrush x:Key="RhiMutedTextBrush">#6B7A8E</SolidColorBrush>
      <SolidColorBrush x:Key="RhiRemoveBackgroundBrush">#281818</SolidColorBrush>
      <SolidColorBrush x:Key="RhiRemoveForegroundBrush">#E07A7A</SolidColorBrush>
      <SolidColorBrush x:Key="RhiRemoveBorderBrush">#563030</SolidColorBrush>
      <!-- w14/ui-settings (#297): the component ⚙ layout's brushes (cards, explanation text, status line, notices). -->
      <SolidColorBrush x:Key="RhiCardBrush">#161C26</SolidColorBrush>
      <SolidColorBrush x:Key="RhiCardBorderBrush">#232C3A</SolidColorBrush>
      <SolidColorBrush x:Key="RhiDialogBarBrush">#0E1217</SolidColorBrush>
      <SolidColorBrush x:Key="RhiWarningTextBrush">#D7B65A</SolidColorBrush>
      <SolidColorBrush x:Key="RhiSuccessTextBrush">#5ECB7D</SolidColorBrush>
      <SolidColorBrush x:Key="RhiDisabledForegroundBrush">#626A75</SolidColorBrush>
      <SolidColorBrush x:Key="RhiDisabledBorderBrush">#292D34</SolidColorBrush>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Component dialogs bound from data templates (epic #89 unit 7): a dialog window's content is its view model. -->
  <Application.DataTemplates>
    <!-- w14/ui-settings (#297): the FG unlocks', DLSS Enabler's and RTX Encore's ⚙ on the shared ⚙ layout (Views/Cog): loose
         intro / warning text, cards, each setting's name left with its option beside it and the explanation under it (RTX
         Encore's sections two per row, as upstream), the Files card, and the status line inside the ⚙. The frame (title,
         scroll, Close) is CogWindow's. -->
    <DataTemplate DataType="vm:ProxyComponentDialogViewModel" x:DataType="vm:ProxyComponentDialogViewModel">
      <StackPanel Spacing="14">
        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Classes="cogIntro"/>
        <TextBlock Text="{Binding RouteNote}" TextWrapping="Wrap" Classes="cogWarning" IsVisible="{Binding HasRouteNote}"/>
        <views:CogCard IsVisible="{Binding HasChoiceCard}">
          <views:CogRow Label="{Binding GpuLabel}" IsVisible="{Binding HasGpu}">
            <ComboBox ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding SelectedGpu}" IsEnabled="{Binding CanChoose}"/>
          </views:CogRow>
          <views:CogRow Label="{Binding ProxyLabel}" Help="{Binding ProxyTip}" IsVisible="{Binding HasProxy}">
            <Panel>
              <!-- #284: names in use are greyed with their component; ASI Loader's Hooked name is marked. -->
              <ComboBox ItemsSource="{Binding ProxyNameOptions}" SelectedItem="{Binding SelectedProxyItem}" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding CanChoose}" IsVisible="{Binding !ShowsProxyAsText}"
                        DisplayMemberBinding="{Binding Display, DataType=vm:ProxyNameItem}">
                <ComboBox.Styles>
                  <Style Selector="ComboBoxItem" x:DataType="vm:ProxyNameItem">
                    <Setter Property="IsEnabled" Value="{Binding IsFree}"/>
                    <Setter Property="ToolTip.Tip" Value="{Binding Tip}"/>
                  </Style>
                </ComboBox.Styles>
              </ComboBox>
              <!-- RTX Encore installed: its name cannot change, so it is plain text, not a dead dropdown (#158). -->
              <TextBlock Text="{Binding SelectedProxy}" VerticalAlignment="Center" Classes="cogLabel" IsVisible="{Binding ShowsProxyAsText}"/>
            </Panel>
          </views:CogRow>
          <!-- w4/encore (#158): RTX Encore's Neural Rendering file; only that dialog has it. -->
          <views:CogRow Label="{Binding NeuralRenderingLabel}" Help="{Binding NeuralRenderingTip}" IsVisible="{Binding HasNeuralRendering}">
            <CheckBox IsChecked="{Binding NeuralRenderingChosen}" IsEnabled="{Binding CanChangeNeuralRendering}"/>
          </views:CogRow>
          <TextBlock Text="{Binding CompatibilityText}" TextWrapping="Wrap" Classes="cogNote" IsVisible="{Binding HasCompatibility}"/>
          <TextBlock Text="{Binding InstalledText}" TextWrapping="Wrap" Classes="cogNote" IsVisible="{Binding IsInstalled}"/>
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" IsVisible="{Binding ShowsCheck}">
            <Button Classes="rhi secondary" Content="{Binding CheckLabel}" Command="{Binding CheckCommand}" IsEnabled="{Binding CanCheck}"/>
            <Button Classes="rhi" Content="{Binding UpdateLabel}" Command="{Binding UpdateCommand}" IsEnabled="{Binding CanUpdate}"/>
            <!-- The main window's overlay Cancel is behind this modal dialog: its own Cancel stops its update. -->
            <Button Classes="rhi secondary" Content="{DynamicResource Ui.CancelOperation}" Command="{Binding Operations.CancelCommand}"
                    IsVisible="{Binding ShowCancel}"/>
          </WrapPanel>
        </views:CogCard>
        <!-- w14/extras-fg: notes and gold warnings; a heading starts its own card (Universal MFG Unlocker's plugin and XeMFG, #278). -->
        <ItemsControl ItemsSource="{Binding LineCards}" IsVisible="{Binding HasLines}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="14"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComponentLineCard">
              <Panel>
                <views:CogCard Header="{Binding Heading}" IsVisible="{Binding IsCard}">
                  <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ComponentDialogLine">
                        <Panel>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="cogIntro" IsVisible="{Binding IsPlain}"/>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="cogWarning" IsVisible="{Binding IsWarning}"/>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </views:CogCard>
                <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding IsLoose}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentDialogLine">
                      <Panel>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="cogIntro" IsVisible="{Binding IsPlain}"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="cogWarning" IsVisible="{Binding IsWarning}"/>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- w14/extras-fg: the mod's own settings, one card per section; a change is saved at once and a refused one goes back. -->
        <ItemsControl ItemsSource="{Binding Sections}" IsVisible="{Binding HasSections}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="14"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComponentSettingSection">
              <views:CogCard Header="{Binding Title}">
                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsListed}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentSettingRow">
                      <views:CogRow Label="{Binding Label}" Help="{Binding Tip}">
                        <Panel>
                          <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsChoice}"/>
                          <TextBox Text="{Binding NumberText, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left"
                                   IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsNumber}"/>
                        </Panel>
                      </views:CogRow>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding Compact}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><views:CogCompactGrid/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentSettingRow">
                      <views:CogCell Label="{Binding Label}" Help="{Binding Tip}">
                        <Panel>
                          <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsChoice}"/>
                          <TextBox Text="{Binding NumberText, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Stretch"
                                   IsEnabled="{Binding IsEnabled}" IsVisible="{Binding IsNumber}"/>
                        </Panel>
                      </views:CogCell>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </views:CogCard>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Upstream's Files card: Open <the mod's ini / log / jsonc>, disabled while the file is missing. -->
        <views:CogCard Header="{l:T Cog.Files}" IsVisible="{Binding HasFileButtons}">
          <ItemsControl ItemsSource="{Binding FileButtons}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ComponentFileButton">
                <Button Classes="rhi secondary cogOpenFile" Content="{Binding Label}" Command="{Binding OpenFileCommand}" IsEnabled="{Binding Exists}"
                        ToolTip.Tip="{Binding Path}" ToolTip.ShowDelay="2000"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </views:CogCard>
        <TextBlock Text="{Binding FooterNote}" TextWrapping="Wrap" Classes="cogNote" IsVisible="{Binding FooterIsPlain}"/>
        <TextBlock Text="{Binding FooterNote}" TextWrapping="Wrap" Classes="cogWarning" IsVisible="{Binding FooterIsWarning}"/>
        <!-- #297: results and errors inside the ⚙ (upstream's status line). -->
        <TextBlock Name="CogStatus" Text="{Binding Message}" TextWrapping="Wrap" Classes="cogStatus" IsVisible="{Binding HasMessage}"/>
      </StackPanel>
    </DataTemplate>
    <!-- Dialogs moved out of the main window's code-behind (epic #89): Views/Dialogs/*.axaml. -->
    <DataTemplate DataType="vm:DlssBatchDialogViewModel">
      <dialogs:DlssBatchDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:RenoDxSettingsDialogViewModel">
      <dialogs:RenoDxSettingsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:OptiScalerSettingsDialogViewModel">
      <dialogs:OptiScalerSettingsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:CustomGamesReviewViewModel">
      <dialogs:CustomGamesReviewDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:AddGameDialogViewModel">
      <dialogs:AddGameDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:EditGameDialogViewModel">
      <dialogs:EditGameDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ShaderAddonsDialogViewModel">
      <dialogs:ShaderAddonsDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ShaderPackFilesDialogViewModel">
      <dialogs:ShaderPackFilesDialogView/>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsDialogViewModel">
      <dialogs:SettingsDialogView/>
    </DataTemplate>
    <!-- w7/nvapi-launch (#211): the NVIDIA settings dialog. -->
    <DataTemplate DataType="vm:NvidiaSettingsDialogViewModel">
      <dialogs:NvidiaSettingsDialogView/>
    </DataTemplate>
    <!-- w11/nr-check (#234): the read-only Check Neural Rendering page (panel button and card menu). -->
    <DataTemplate DataType="vm:NeuralRenderingCheckDialogViewModel">
      <dialogs:NeuralRenderingCheckDialogView/>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <!-- Every generated/configuration window inherits the same RHI-Linux surface. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource RhiBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
      <Setter Property="FontFamily" Value="Inter"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
    </Style>

    <!-- Default controls intentionally match Button.rhi so code-created dialogs cannot fall back to Fluent defaults. -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource RhiControlHoverBrush}"/>
      <Setter Property="BorderBrush" Value="#2A6378"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="{DynamicResource RhiControlPressedBrush}"/>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="#17191D"/>
      <Setter Property="Foreground" Value="#626A75"/>
      <Setter Property="BorderBrush" Value="#292D34"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <Style Selector="Button.rhi">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
    </Style>
    <Style Selector="Button.rhi.remove">
      <Setter Property="Background" Value="{DynamicResource RhiRemoveBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiRemoveForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiRemoveBorderBrush}"/>
    </Style>
    <Style Selector="Button.rhi:disabled">
      <Setter Property="Background" Value="#17191D"/>
      <Setter Property="Foreground" Value="#626A75"/>
      <Setter Property="BorderBrush" Value="#292D34"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="#1A2030"/>
      <Setter Property="Foreground" Value="#8898B0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Button.chip:pointerover">
      <Setter Property="Background" Value="#202A3A"/>
      <Setter Property="Foreground" Value="#B8C9E0"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="SelectionBrush" Value="#2A6378"/>
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource RhiControlBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style Selector="ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>

    <Style Selector="TabControl">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="Background" Value="#101419"/>
      <Setter Property="Padding" Value="12,7"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="Background" Value="#14212A"/>
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#101419"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- The toolbar '…' overflow menu and the library card menu use the tooltip surface and the button text colour
         (scoped: other menus, e.g. text-box context menus, keep the theme defaults). -->
    <Style Selector="MenuFlyoutPresenter.toolbarOverflow">
      <Setter Property="Background" Value="#101419"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="MenuItem.toolbarOverflow">
      <Setter Property="Foreground" Value="{DynamicResource RhiAccentBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource RhiSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="#1E2430"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>

    <!-- w14/ui-settings (#297): the shared component ⚙ layout (Views/Cog: CogDialog, CogWindow, CogCard, CogRow, CogCell). -->
    <Style Selector="TextBlock.cogTitle">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
    </Style>
    <Style Selector="Border.cogCard">
      <Setter Property="Background" Value="{DynamicResource RhiCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18,16"/>
    </Style>
    <Style Selector="TextBlock.cogHeading">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="0.6"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogLabel">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogHelp">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogIntro">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogEmpty">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogWarning">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiWarningTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogNote">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiMutedTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogStatus">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogStatus.success">
      <Setter Property="Foreground" Value="{DynamicResource RhiSuccessTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.cogStatus.error">
      <Setter Property="Foreground" Value="{DynamicResource RhiRemoveForegroundBrush}"/>
    </Style>
    <Style Selector="Border.cogButtonBar">
      <Setter Property="Background" Value="{DynamicResource RhiDialogBarBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>
    <Style Selector="Button.rhi.secondary">
      <Setter Property="Foreground" Value="{DynamicResource RhiSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiBorderBrush}"/>
    </Style>
    <Style Selector="Button.rhi.secondary:disabled">
      <Setter Property="Foreground" Value="{DynamicResource RhiDisabledForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiDisabledBorderBrush}"/>
    </Style>
  </Application.Styles>
</Application>
