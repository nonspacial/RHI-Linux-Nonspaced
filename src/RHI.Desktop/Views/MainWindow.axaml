<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RHI.Desktop.ViewModels"
        xmlns:views="using:RHI.Desktop.Views"
        xmlns:l="using:RHI.Desktop.Localization"
        x:Class="RHI.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel" x:CompileBindings="True"
        Width="1450" Height="900" MinWidth="640" MinHeight="480"
        Title="{DynamicResource Ui.WindowTitle}"
        Background="{DynamicResource RhiBackgroundBrush}"
        DragDrop.AllowDrop="True" DragDrop.DragOver="GameFiles_DragOver" DragDrop.Drop="GameFiles_Drop">
  <Window.Styles>
    <!-- One dim for the whole library-overlay backdrop: over the main content and over the status bar. -->
    <Style Selector="Border.libraryBackdrop">
      <Setter Property="Background" Value="{DynamicResource RhiStatusBarBrush}"/>
      <Setter Property="Opacity" Value="0.75"/>
    </Style>
    <!-- w14/layouts-b (#305, upstream 2.9.0 Spotlight, mockup D tokens): the strip, the covers, the banner, the tiles and the
         side panel, from the theme resources only. -->
    <Style Selector="Border.spotStrip">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="Border.spotStrip.bottom">
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>
    <Style Selector="Border.spotStrip.plain">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPageBrush}"/>
    </Style>
    <Style Selector="ToggleButton.spotFilters">
      <Setter Property="MinWidth" Value="40"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ListBox.shelf ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="ListBox.shelf ListBoxItem /template/ ContentPresenter, ListBox.shelf ListBoxItem:selected /template/ ContentPresenter, ListBox.shelf ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.shelfCover">
      <Setter Property="Background" Value="{DynamicResource RhiNavyCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
    </Style>
    <Style Selector="ListBox.shelf ListBoxItem:pointerover Border.shelfCover">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
    </Style>
    <Style Selector="Border.shelfCover.update">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiUpdateBrush}"/>
    </Style>
    <Style Selector="ListBox.shelf ListBoxItem:selected Border.shelfCover">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyAccentBrush}"/>
    </Style>
    <Style Selector="Border.shelfBadge">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPurpleButtonBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiUpdateBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.shelfBadge TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyPurpleButtonTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.shelfName">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.shelfName.hidden, TextBlock.shelfFallback">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyMutedTextBrush}"/>
    </Style>
    <Style Selector="Border#SpotlightHero.spot">
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource RhiSpotlightHeroBrush}"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border#SpotlightHero.spot Border#SpotlightHeroContent">
      <Setter Property="Padding" Value="28"/>
    </Style>
    <Style Selector="Border#SpotlightHero.spot TextBlock#TabsTitle">
      <Setter Property="FontSize" Value="40"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Ellipse.statusDot">
      <Setter Property="Fill" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
    </Style>
    <Style Selector="Ellipse.statusDot.installed">
      <Setter Property="Fill" Value="{DynamicResource RhiInstalledBrush}"/>
    </Style>
    <Style Selector="Ellipse.statusDot.update">
      <Setter Property="Fill" Value="{DynamicResource RhiUpdateBrush}"/>
    </Style>
    <Style Selector="Ellipse.statusDot.unsupported">
      <Setter Property="Fill" Value="{DynamicResource RhiNavyDangerTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.statusLine">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavySecondaryTextBrush}"/>
    </Style>
    <Style Selector="Border.spotScrim">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPageBrush}"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="Border.spotSheet">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>
    <Style Selector="TextBlock.spotPanelTitle">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
    </Style>
    <Style Selector="Border.spotCard">
      <Setter Property="Background" Value="{DynamicResource RhiNavyCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="TextBlock.spotMuted">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyMutedTextBrush}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="TextBlock.spotStrong">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Grid.shotCell">
      <Setter Property="Background" Value="{DynamicResource RhiNavyRowHoverBrush}"/>
    </Style>
    <Style Selector="Button.shotThumb">
      <Setter Property="Background" Value="{DynamicResource RhiNavyRowHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Button.shotThumb:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
    </Style>
    <Style Selector="Button.pickTile.chosen">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyAccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.achStrip">
      <Setter Property="Background" Value="{DynamicResource RhiNavyCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>
    <Style Selector="Button.achStrip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RhiNavyRowHoverBrush}"/>
    </Style>
    <Style Selector="ProgressBar.achBar">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyAccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource RhiNavyControlBorderBrush}"/>
    </Style>
    <Style Selector="Border.achIcon">
      <Setter Property="Background" Value="{DynamicResource RhiNavyRowHoverBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Border.achRow">
      <Setter Property="Background" Value="{DynamicResource RhiNavyCardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyCardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="Border.achRow.locked">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <Style Selector="TextBlock.achRarity">
      <Setter Property="Foreground" Value="{DynamicResource RhiUpdateBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- #308: the controller's focus ring (upstream's blue ring) while a controller drives Spotlight. -->
    <Style Selector="TextBlock.padHints">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavySecondaryTextBrush}"/>
    </Style>
    <Style Selector="Window.pad Button:focus-visible, Window.pad ToggleButton:focus-visible, Window.pad ComboBox:focus-visible, Window.pad CheckBox:focus-visible, Window.pad TextBox:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyAccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Window.pad ListBox.shelf ListBoxItem:focus-visible Border.shelfCover">
      <Setter Property="BorderBrush" Value="{DynamicResource RhiNavyAccentBrush}"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Border.pickLabel">
      <Setter Property="Background" Value="{DynamicResource RhiNavyPageBrush}"/>
    </Style>
    <Style Selector="Border.pickLabel TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RhiNavyTextBrush}"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- w14/layouts-a (#303): upstream 2.9.0's top bar, used by every layout. Left: the brand, then Available Mods (with a
         green New tag) and Shaders & Addons; right: when RHI last checked, Refresh, Update All with its count, the layout
         switch (Classic+ | Tabs | Spotlight), Help and Settings. One row (ToolbarPanel): the brand subtitle hides first,
         then the right group moves into the '…' menu from its right end, then (a narrow window at a large size) Shaders &
         Addons and Available Mods follow it; Settings stays pinned at the far right. The bar's
         own size (#306) scales it on top of the interface size; its bottom edge drags. -->
    <Border x:Name="TopBar" Grid.Row="0" Padding="16,10" Background="{DynamicResource RhiToolbarBrush}" BorderBrush="{DynamicResource RhiBorderBrush}" BorderThickness="0,0,0,1">
      <LayoutTransformControl x:Name="TopBarScaleBox">
      <views:ToolbarPanel x:Name="ToolbarRow" Spacing="8" LeadingSpacing="6" MinGap="16">
        <!-- Below 900 px the library column becomes a slide-out overlay opened from here. -->
        <Button x:Name="LibraryToggleButton" views:ToolbarPanel.Slot="Leading" Classes="rhi" Content="{DynamicResource Ui.LibraryToggle}"
                Click="LibraryToggle_Click" ToolTip.Tip="{DynamicResource Ui.LibraryToggleTip}" IsVisible="False"/>
        <StackPanel x:Name="TopBarBrand" views:ToolbarPanel.Slot="Leading" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,14,0">
          <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource RhiAccentTintBrush}" BorderBrush="{DynamicResource RhiAccentBorderBrush}" BorderThickness="1">
            <TextBlock Text="R" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource RhiAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="RHI" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource RhiAccentBrush}"/>
            <TextBlock views:ToolbarPanel.Collapsible="True" Text="{DynamicResource Ui.Tagline}" FontSize="10" Foreground="{DynamicResource RhiTaglineBrush}"/>
          </StackPanel>
        </StackPanel>
        <Button x:Name="NavAvailableMods" views:ToolbarPanel.Slot="Leading" views:ToolbarPanel.Overflows="True" Classes="topNav" Click="NavAvailableMods_Click"
                ToolTip.Tip="{Binding NavAvailableModsTip}" AutomationProperties.Name="{DynamicResource Ui.AvailableMods}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{DynamicResource Ui.AvailableMods}" VerticalAlignment="Center"/>
            <!-- #185: the green New tag while new RenoDX, Luma or Ultra+ mods have arrived since you last looked. -->
            <Border x:Name="NavNewTag" Classes="newTag" IsVisible="{Binding !NewMods.IsHidden, FallbackValue=False}" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Top.New}"/>
            </Border>
          </StackPanel>
        </Button>
        <Button x:Name="NavShadersAddons" views:ToolbarPanel.Slot="Leading" views:ToolbarPanel.Overflows="True" Classes="topNav" Content="{DynamicResource Ui.ShadersAddons}"
                ToolTip.Tip="{DynamicResource Top.ShadersAddonsTip}" AutomationProperties.Name="{DynamicResource Ui.ShadersAddons}">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem x:Name="GlobalShadersItem" Header="{DynamicResource Top.GlobalShaders}" Click="GlobalShaders_Click"/>
              <MenuItem x:Name="GlobalAddonsItem" Header="{DynamicResource Top.GlobalAddons}" Click="GlobalAddons_Click"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <TextBlock x:Name="TopBarCheckedText" Text="{Binding TopBar.CheckedText}" Classes="topChecked" VerticalAlignment="Center"
                   ToolTip.Tip="{DynamicResource Top.CheckedTip}"/>
        <Button x:Name="TopBarRefresh" Classes="rhi topIcon" Content="⟳" Command="{Binding RefreshCommand}"
                ToolTip.Tip="{DynamicResource Top.RefreshTip}" AutomationProperties.Name="{DynamicResource Ui.Refresh}"/>
        <!-- Update All: purple with the number of games that have updates, else "✓ All up to date" once the library-wide check
             (w14/layouts-c) found none; disabled then, as upstream (TopBarPresenter). -->
        <Button x:Name="TopBarUpdateAll" Classes="rhi updateAll" Classes.hasUpdates="{Binding TopBar.HasUpdateCount}" Classes.upToDate="{Binding TopBar.AllUpToDate}"
                Command="{Binding Updates.UpdateAllCommand}"
                ToolTip.Tip="{Binding TopBar.UpdateAllTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding TopBar.UpdateAllText}">
          <Button.IsEnabled>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="Updates.CanUpdateAll"/>
              <Binding Path="!TopBar.AllUpToDate"/>
            </MultiBinding>
          </Button.IsEnabled>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="TopBarUpToDateTick" Classes="upToDateTick" Text="✓" IsVisible="{Binding TopBar.AllUpToDate}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TopBarUpdateAllText" Text="{Binding TopBar.UpdateAllText}" VerticalAlignment="Center"/>
            <Border Classes="countTag" IsVisible="{Binding TopBar.HasUpdateCount}" VerticalAlignment="Center">
              <TextBlock Text="{Binding TopBar.UpdateCountText}"/>
            </Border>
          </StackPanel>
        </Button>
        <!-- Classic+ | Tabs | Spotlight (Spotlight a disabled placeholder until the layouts-b lane, #305). -->
        <views:SegmentedSwitch x:Name="LayoutSwitch" VerticalAlignment="Center"/>
        <Button x:Name="TopBarHelp" Classes="rhi" Click="TopBarHelp_Click" AutomationProperties.Name="{DynamicResource Shell.HelpTitle}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{DynamicResource Shell.HelpTitle}" VerticalAlignment="Center"/>
            <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ToolbarOverflowButton" views:ToolbarPanel.Slot="Overflow" Classes="rhi" Content="…"
                ToolTip.Tip="{DynamicResource Ui.MoreActions}" AutomationProperties.Name="{DynamicResource Ui.MoreActions}">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="ToolbarOverflowMenu_Opening" FlyoutPresenterClasses="toolbarOverflow"/>
          </Button.Flyout>
        </Button>
        <!-- Settings as an icon, lit while Settings is open (upstream). -->
        <Button x:Name="TopBarSettings" views:ToolbarPanel.Slot="Trailing" Classes="rhi topIcon" Content="⚙" Click="Settings_Click"
                ToolTip.Tip="{DynamicResource Top.SettingsTip}" AutomationProperties.Name="{DynamicResource Ui.Settings}"/>
      </views:ToolbarPanel>
      </LayoutTransformControl>
    </Border>

    <Grid x:Name="MainContentGrid" Grid.Row="1" ColumnDefinitions="300,*" RowDefinitions="Auto,*">
      <!-- Below 900 px the column is removed and the same sidebar opens over this dimmed backdrop (MainWindow.Responsive.cs). -->
      <Border x:Name="LibraryBackdrop" Classes="libraryBackdrop" Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="False" ZIndex="10"
              PointerPressed="LibraryBackdrop_PointerPressed"/>
      <!-- Sidebar (#303, upstream's game list in Classic+ and Tabs): search and the green + (add a game), the All | Installed |
           Favourites | Hidden switch, your collections, then the Filters button by the counts; the engine and mod filters
           show behind Filters. Its own size (#306) scales it; its right edge drags. -->
      <Border x:Name="LibrarySidebar" Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource RhiSidebarBrush}" BorderBrush="{DynamicResource RhiBorderBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
        <LayoutTransformControl x:Name="GameListScaleBox">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <Border Grid.Row="0" Padding="10,10,10,6" Background="{DynamicResource RhiFilterBarBrush}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{DynamicResource Ui.SearchGames}" Background="{DynamicResource RhiControlBrush}" Foreground="{DynamicResource RhiSecondaryTextBrush}"
                         BorderBrush="{DynamicResource RhiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" FontSize="12"/>
                <Button x:Name="SidebarAddGame" Grid.Column="1" Classes="rhi addGame" Content="+" Click="AddGame_Click"
                        ToolTip.Tip="{DynamicResource Top.AddGameTip}" AutomationProperties.Name="{DynamicResource Ui.AddGame}"/>
              </Grid>
              <views:SegmentedSwitch x:Name="LibraryMainFilter" Stretch="True"/>
              <!-- #300 game collections: one chip per collection, then "+ Collection" (upstream 2.9.2, under the filter switch). -->
              <views:CollectionsRow x:Name="CollectionsRow"/>
              <!-- #193 saved custom filters: "Save as filter" and one chip per saved filter (hidden while there is neither). -->
              <views:CustomFilterRow/>
            </StackPanel>
          </Border>
          <!-- Behind Filters: the engine and mod filters (upstream 2.9.0). -->
          <Border x:Name="LibraryFilterBar" Grid.Row="1" Padding="10,4,10,8" Background="{DynamicResource RhiFilterBarBrush}" IsVisible="False">
            <WrapPanel Orientation="Horizontal">
              <Button Classes="chip" Classes.active="{Binding LibraryFilterIsUnreal}" Content="Unreal" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Unreal"/>
              <Button Classes="chip" Classes.active="{Binding LibraryFilterIsUnity}" Content="Unity" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Unity"/>
              <Button Classes="chip" Classes.active="{Binding LibraryFilterIsOther}" Content="{DynamicResource Ui.Other}" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Other"/>
              <Button Classes="chip" Classes.active="{Binding LibraryFilterIsRenoDx}" Content="RenoDX" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="RenoDX"/>
              <Button Classes="chip" Classes.active="{Binding LibraryFilterIsLuma}" Content="Luma" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Luma"/>
            </WrapPanel>
          </Border>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="10,6,12,8" Background="Transparent">
            <ToggleButton x:Name="LibraryFiltersButton" Classes="filters" Content="{Binding LibraryFiltersText}" ToolTip.Tip="{Binding LibraryFiltersTip}"
                          IsCheckedChanged="LibraryFilters_Changed"/>
            <TextBlock Grid.Column="1" Text="{Binding GameCountText}" Foreground="{DynamicResource RhiMutedTextBrush}" FontSize="10"
                       VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <ListBox x:Name="GameLibraryList" Grid.Row="3" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGameRow}"
                   SelectionChanged="GameLibrary_SelectionChanged" Tapped="GameLibrary_Tapped" ClipToBounds="True"
                   ContextRequested="GameLibrary_ContextRequested" KeyUp="GameLibrary_KeyUp"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Background="Transparent" BorderThickness="0" Margin="6,0,6,6">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GameRowViewModel">
                <Border Classes="gameRow" Classes.hasUpdate="{Binding HasUpdate}" Padding="10,8" Margin="0,1" CornerRadius="7" Background="{DynamicResource RhiGameRowBrush}" BorderThickness="1"
                        ToolTip.Tip="{Binding ToolTip}">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <StackPanel>
                      <!-- #309: greyed when ReShade isn't installed for the game (upstream 2.8.9); the tooltip says so. -->
                      <TextBlock Text="{Binding Name}" Classes="libraryName" Classes.noReShade="{Binding ShowsNoReShade}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Source}" Foreground="{DynamicResource RhiMutedTextBrush}" FontSize="9"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding LibraryBadge}" Foreground="{DynamicResource RhiWarningBrush}" VerticalAlignment="Center" FontSize="12"/>
                    <!-- w14/layouts-c (upstream: the orange dot): a game with an update has an update-coloured dot and outline. -->
                    <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource RhiInstalledBrush}" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource Ui.DetectedLinuxTip}" IsVisible="{Binding !HasUpdate}"/>
                    <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource RhiUpdateBrush}" VerticalAlignment="Center"
                            ToolTip.Tip="{l:T Lib.UpdateTip}" IsVisible="{Binding HasUpdate}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- #300: why a shown collection's list is empty (upstream's empty-list message). -->
          <TextBlock x:Name="CollectionEmptyText" Grid.Row="3" Margin="16,12,16,0" VerticalAlignment="Top" TextWrapping="Wrap"
                     FontSize="12" Foreground="{DynamicResource RhiMutedTextBrush}" IsHitTestVisible="False"
                     Text="{Binding Collections.EmptyText}" IsVisible="{Binding Collections.HasEmptyText}"/>
        </Grid>
        </LayoutTransformControl>
      </Border>

      <!-- w14/layouts-b (#305, upstream 2.9.0–2.9.4 Spotlight, mockup D): the game list becomes a full-width strip above the
           game page (below it with the strip's ⚙ › Covers below the game page): the search box and the green +, the Filters
           icon, the All | Installed | Favourites | Hidden switch, your collections beside them, the counts and the strip's ⚙;
           behind Filters the engine and mod filters and the saved searches; then a row of game covers. The covers show the
           same filtered list as the game list and pick the same game (MainWindow.Spotlight.cs). -->
      <Border x:Name="SpotlightStrip" Grid.Row="0" Grid.ColumnSpan="2" Classes="spotStrip" IsVisible="False">
        <Grid x:Name="SpotlightStripGrid" RowDefinitions="Auto,Auto,Auto">
          <Grid x:Name="SpotlightSearchRow" Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="24,14,24,6">
            <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="8" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="SpotlightSearch" Width="320" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{DynamicResource Ui.SearchGames}" Background="{DynamicResource RhiControlBrush}" Foreground="{DynamicResource RhiSecondaryTextBrush}"
                         BorderBrush="{DynamicResource RhiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" FontSize="12"/>
                <Button x:Name="SpotlightAddGame" Classes="rhi addGame" Content="+" Click="AddGame_Click"
                        ToolTip.Tip="{DynamicResource Top.AddGameTip}" AutomationProperties.Name="{DynamicResource Ui.AddGame}"/>
              </StackPanel>
              <!-- Upstream 2.9.2: Spotlight's Filters is an icon left of the switch. -->
              <ToggleButton x:Name="SpotlightFiltersButton" Classes="filters spotFilters" ToolTip.Tip="{Binding LibraryFiltersTip}"
                            AutomationProperties.Name="{Binding LibraryFiltersText}" IsCheckedChanged="SpotlightFilters_Changed">
                <PathIcon Width="14" Height="14" Data="M2,3 L22,3 L14,12.5 L14,20 L10,22 L10,12.5 Z"/>
              </ToggleButton>
              <views:SegmentedSwitch x:Name="SpotlightMainFilter" Width="340" VerticalAlignment="Center"/>
              <!-- #300 collections beside Filters (upstream 2.9.2 Spotlight). -->
              <views:CollectionsRow x:Name="SpotlightCollections" VerticalAlignment="Center" Margin="0"/>
            </WrapPanel>
            <TextBlock Grid.Column="1" Text="{Binding GameCountText}" Foreground="{DynamicResource RhiMutedTextBrush}" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="SpotlightShelfOptions" Grid.Column="2" Classes="rhi topIcon" Content="⚙" Click="SpotlightShelfOptions_Click"
                    ToolTip.Tip="{DynamicResource Spot.ShelfOptionsTip}" AutomationProperties.Name="{DynamicResource Spot.ShelfOptionsTip}"/>
          </Grid>
          <Border x:Name="SpotlightFilterBar" Grid.Row="1" Padding="24,0,24,6" IsVisible="False">
            <StackPanel Spacing="4">
              <WrapPanel Orientation="Horizontal">
                <Button Classes="chip" Classes.active="{Binding LibraryFilterIsUnreal}" Content="Unreal" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Unreal"/>
                <Button Classes="chip" Classes.active="{Binding LibraryFilterIsUnity}" Content="Unity" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Unity"/>
                <Button Classes="chip" Classes.active="{Binding LibraryFilterIsOther}" Content="{DynamicResource Ui.Other}" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Other"/>
                <Button Classes="chip" Classes.active="{Binding LibraryFilterIsRenoDx}" Content="RenoDX" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="RenoDX"/>
                <Button Classes="chip" Classes.active="{Binding LibraryFilterIsLuma}" Content="Luma" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Luma"/>
              </WrapPanel>
              <!-- #193 saved searches: behind Filters in Spotlight, as upstream keeps them. -->
              <views:CustomFilterRow/>
            </StackPanel>
          </Border>
          <ListBox x:Name="SpotlightShelf" Grid.Row="2" Classes="shelf" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGameRow}"
                   ContextRequested="GameLibrary_ContextRequested" KeyUp="GameLibrary_KeyUp"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                   Background="Transparent" BorderThickness="0" Padding="20,4,20,10">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GameRowViewModel">
                <views:ShelfTile/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="SpotlightEmptyText" Grid.Row="2" Margin="24,12,24,0" VerticalAlignment="Top" TextWrapping="Wrap"
                     FontSize="12" Foreground="{DynamicResource RhiMutedTextBrush}" IsHitTestVisible="False"
                     Text="{Binding Collections.EmptyText}" IsVisible="{Binding Collections.HasEmptyText}"/>
          <!-- Upstream 2.9.2: drag the strip's edge facing the page to resize the covers; double-click resets. -->
          <Border x:Name="SpotlightCoverGrip" Grid.Row="2" Classes="resizeGrip" Height="10" VerticalAlignment="Bottom" Margin="0,0,0,-5"
                  Background="Transparent" Cursor="SizeNorthSouth" ToolTip.Tip="{DynamicResource Spot.CoverGripTip}"/>
        </Grid>
      </Border>

      <!-- Detail panel -->
      <ScrollViewer x:Name="DetailScroller" Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource RhiBackgroundBrush}">
        <Grid x:Name="DetailRoot" Margin="24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
          <!-- Responsive header: steps typography down, then moves the actions below the title, then trims (DetailHeaderPanel). -->
          <views:DetailHeaderPanel x:Name="ClassicHeader" Grid.Row="0" RowSpacing="8">
            <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center">
              <!-- Identity badges: first = library source, second = launcher/platform. Never shrunk by trimming. -->
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="ShowLibraryProviderBadge"/>
                    <Binding Path="ShowLaunchProviderBadge"/>
                  </MultiBinding>
                </StackPanel.IsVisible>
                <!-- #309: the store badge opens the game's Steam Community page (upstream 2.8.9). -->
                <Border x:Name="StoreBadge" views:DetailHeaderPanel.Role="Badge" Width="50" Height="50" CornerRadius="9" Background="{DynamicResource RhiControlBrush}" BorderBrush="{DynamicResource RhiAccentBorderBrush}" BorderThickness="1"
                        Padding="5" IsVisible="{Binding ShowLibraryProviderBadge}" ToolTip.Tip="{Binding StoreBadgeToolTip}"
                        Classes.storeLink="{Binding StoreBadgeOpensCommunity}" PointerPressed="StoreBadge_PointerPressed">
                  <Image Source="{Binding SelectedLibraryProviderIcon}" Stretch="Uniform"/>
                </Border>
                <Border views:DetailHeaderPanel.Role="Badge" Width="50" Height="50" CornerRadius="9" Background="{DynamicResource RhiControlBrush}" BorderBrush="{DynamicResource RhiAccentBorderBrush}" BorderThickness="1"
                        Padding="5" IsVisible="{Binding ShowLaunchProviderBadge}" ToolTip.Tip="{Binding LaunchProviderToolTip}">
                  <Image Source="{Binding SelectedLaunchProviderIcon}" Stretch="Uniform"/>
                </Border>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <!-- Upstream 2.9.4 Game settings: a ⚙ beside the title (Block Steam updates; Remove from RHI is in Management). -->
                <DockPanel>
                  <Button x:Name="GameSettingsButton" DockPanel.Dock="Right" Classes="rhi" Content="⚙" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                          IsVisible="{Binding ShowGameSettings}" ToolTip.Tip="{Binding GameSettingsTitle}" Click="GameSettings_Click"/>
                  <TextBlock x:Name="SelectedTitleText" views:DetailHeaderPanel.Role="Title" Text="{Binding SelectedTitle}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource RhiTextBrush}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedTitle}"/>
                </DockPanel>
                <TextBlock x:Name="SelectedSourceText" views:DetailHeaderPanel.Role="Subtitle" Text="{Binding SelectedSource}" FontSize="12" Foreground="{DynamicResource RhiAccentBrush}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedSource}"/>
              </StackPanel>
            </DockPanel>
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
              <!-- #309: quieter, amber "Favourited" once on (upstream 2.8.9). -->
              <Button x:Name="FavouriteButton" views:DetailHeaderPanel.Role="Action" Classes="rhi favourite" Classes.on="{Binding SelectedGameIsFavourite}"
                      Content="{Binding FavouriteActionText}" Command="{Binding ToggleFavouriteCommand}" IsEnabled="{Binding HasSelectedGame}"
                      ToolTip.Tip="{Binding FavouriteActionTip}"/>
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{Binding HideActionText}" Command="{Binding ToggleHiddenCommand}" IsEnabled="{Binding HasSelectedGame}"/>
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{DynamicResource Ui.Edit}" Click="EditGame_Click" IsEnabled="{Binding CanEditSelectedGame}"
                      ToolTip.Tip="{DynamicResource Ui.EditTip}"/>
              <!-- w14/layouts-a (#304): a game added by hand is removed with Management › Remove from RHI, as upstream. -->
              <!-- Only shown when RHI's records still point to the folder the game was moved from. -->
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{DynamicResource Ui.RepairMove}" Command="{Binding RepairAfterMoveCommand}"
                      IsVisible="{Binding ShowRepairAfterMove}"
                      ToolTip.Tip="{DynamicResource Ui.RepairMoveTip}"/>
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{DynamicResource Ui.OpenFolder}" Command="{Binding OpenGameFolderCommand}" IsEnabled="{Binding HasConfirmedPatchTarget}"/>
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{DynamicResource Ui.OpenPrefix}" Command="{Binding OpenPrefixCommand}" IsEnabled="{Binding HasSelectedGame}"/>
              <Button views:DetailHeaderPanel.Role="Action" Content="{DynamicResource Ui.Play}" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}"
                      ToolTip.Tip="{Binding LaunchToolTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000"
                      Background="{DynamicResource RhiButtonBrush}" Foreground="{DynamicResource RhiButtonTextBrush}" BorderBrush="{DynamicResource RhiButtonBorderBrush}" BorderThickness="1"
                      CornerRadius="8" Padding="16,8"/>
            </WrapPanel>
          </views:DetailHeaderPanel>

          <!-- w14/layouts-a (#304, upstream 2.9.0 Tabs header): the name in large type with the favourite star, Hide and the Game
               settings ⚙; quiet tags (store, runner, graphics API, engine); the install path with Open folder and Open prefix (the
               Linux stand-in for Config folder); the game's links; a large Launch button with its menu; HDR on launch, the
               resolution switch and the display mode switch (#311). Shown in Tabs instead of the Classic+ header; every control calls what the Classic+ one does. -->
          <!-- w14/layouts-b (#305, upstream 2.9.0 Spotlight hero): in Spotlight the Tabs header sits in a banner over the game's
               Steam art (or its own banner) with dark fades so the text stays readable; a plain banner for games not on Steam. Its
               bottom edge drags its height (double-click: automatic again); right-click opens the game menu (Artwork). In Tabs
               the banner's layers are hidden and the header shows as before. -->
          <Border x:Name="SpotlightHero" Grid.Row="0" Classes="spotHero" IsVisible="False" ContextRequested="SpotlightHero_ContextRequested">
            <Grid x:Name="SpotlightHeroLayers">
              <Border x:Name="SpotlightHeroArt" IsVisible="False" IsHitTestVisible="False" Opacity="0"/>
              <Border x:Name="SpotlightHeroFadeBottom" IsVisible="False" IsHitTestVisible="False"/>
              <Border x:Name="SpotlightHeroFadeSide" IsVisible="False" IsHitTestVisible="False"/>
              <Border x:Name="SpotlightHeroContent" VerticalAlignment="Bottom">
          <!-- w14 final review m4 (upstream 2.9.4 DetailLayoutHost.Header): two columns. Left: the name with the star, Hide and
               the ⚙; the tags; the path; the links. Right, at its own width: Launch, then HDR on launch, the resolution switch, the
               display modes and (Spotlight) the achievements strip. A narrow page puts the right column under the left. -->
          <StackPanel x:Name="TabsHeader" Spacing="10" IsVisible="False">
            <views:HeaderColumnsPanel x:Name="TabsHeaderColumns" Spacing="20" LeftMinWidth="340">
              <StackPanel x:Name="TabsHeaderLeft" Spacing="10">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="TabsFavourite" Classes="tabsStar" Classes.on="{Binding SelectedGameIsFavourite}" Content="★"
                            Command="{Binding ToggleFavouriteCommand}" IsEnabled="{Binding HasSelectedGame}" ToolTip.Tip="{Binding FavouriteActionTip}"/>
                    <Button x:Name="TabsHide" Classes="rhi" Content="{Binding HideActionText}" Command="{Binding ToggleHiddenCommand}" IsEnabled="{Binding HasSelectedGame}"/>
                    <!-- w14/layouts-b (#305, upstream 2.9.3): Spotlight's Screenshots (the side panel), beside the Game settings ⚙. -->
                    <Button x:Name="SpotlightScreenshots" Classes="rhi" Padding="10,4" IsVisible="False" IsEnabled="{Binding HasSelectedGame}"
                            Click="SpotlightScreenshots_Click" ToolTip.Tip="{DynamicResource Spot.Screenshots}" AutomationProperties.Name="{DynamicResource Spot.Screenshots}">
                      <PathIcon Width="15" Height="15" Data="M3,5 H21 V19 H3 Z M5,17 L10,11 L13,14 L16,10 L19,17 Z M7,8.5 A1.5,1.5 0 1 0 7.01,8.5"/>
                    </Button>
                    <Button x:Name="TabsGameSettings" Classes="rhi" Content="⚙" Padding="10,4" IsVisible="{Binding ShowGameSettings}"
                            ToolTip.Tip="{Binding GameSettingsTitle}" Click="GameSettings_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="TabsTitle" Text="{Binding SelectedTitle}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource RhiTextBrush}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl x:Name="TabsTags" ItemsSource="{Binding HeaderTags}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Classes="tabsTag"><TextBlock Text="{Binding}"/></Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <views:MiddleEllipsisText FullText="{Binding SelectedInstallPath}" Classes="muted" WrapNonPath="False" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Classes="rhi" Content="{DynamicResource Ui.OpenFolder}" Command="{Binding OpenGameFolderCommand}" IsEnabled="{Binding HasConfirmedPatchTarget}"/>
                  <Button Grid.Column="2" Classes="rhi" Content="{DynamicResource Ui.OpenPrefix}" Command="{Binding OpenPrefixCommand}" IsEnabled="{Binding HasSelectedGame}"/>
                </Grid>
                <ItemsControl x:Name="TabsLinks" ItemsSource="{Binding HeaderLinks}" IsVisible="{Binding HasHeaderLinks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="4"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CardMenuItem">
                      <Button Classes="tabsLink" Content="{Binding Label}" Command="{Binding Command}" ToolTip.Tip="{Binding Tip}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel x:Name="TabsHeaderRight" Spacing="10" MinWidth="260" MaxWidth="440" HorizontalAlignment="Left">
                <Grid x:Name="TabsLaunchSplit" ColumnDefinitions="*,Auto">
                  <Button x:Name="TabsLaunch" Classes="tabsLaunch" Content="{DynamicResource Tabs.Launch}" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          ToolTip.Tip="{Binding LaunchToolTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000"/>
                  <Button x:Name="TabsLaunchMenu" Grid.Column="1" Classes="tabsLaunch menu" Content="▾" IsEnabled="{Binding HasSelectedGame}" Click="TabsLaunchMenu_Click"
                          ToolTip.Tip="{DynamicResource Tabs.LaunchMenuTip}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel" IsVisible="{Binding ShowHdrRow}"
                            VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Tabs.HdrOnLaunch}" Classes="muted" VerticalAlignment="Center"/>
                  <ComboBox x:Name="TabsHdrMode" MinWidth="170" ItemsSource="{Binding HdrModeOptions}" SelectedItem="{Binding SelectedHdrMode, Mode=TwoWay}"
                            IsEnabled="{Binding CanEditHdrProfile}" ToolTip.Tip="{Binding HdrModeTip}" ToolTip.ShowDelay="2000">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Display}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <views:ResolutionToggleRow x:Name="TabsResolution" DataContext="{Binding Runtime}" IsVisible="{Binding ShowResolutionRow}" VerticalAlignment="Center"/>
                <!-- w14/display-modes (#311, upstream 2.9.3/2.9.4: beside the HDR and resolution buttons in every layout): the same
                     reusable switch as Classic+'s Game Overrides row, attached in MainWindow.DisplayModes.cs. -->
                <StackPanel x:Name="TabsDisplayModes" Orientation="Horizontal" Spacing="8" IsVisible="{Binding DisplayModes.ShowSwitch}" VerticalAlignment="Center">
                  <TextBlock Text="{l:T Dm.Label}" Classes="muted" VerticalAlignment="Center"/>
                  <views:DisplayModeSwitchView x:Name="TabsDisplayModeSwitch" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- w14/layouts-b (#307, upstream 2.9.2 Spotlight): the Steam achievements strip under Launch — progress, the latest
                     unlock and the recent ones; a click opens the full list in the side panel (Settings › Achievements › Steam). -->
                <Button x:Name="SpotlightAchievementsStrip" Classes="achStrip" IsVisible="False" Click="AchievementsStrip_Click"
                        HorizontalAlignment="Left" ToolTip.Tip="{DynamicResource Ach.StripTip}" AutomationProperties.Name="{DynamicResource Ach.StripTip}">
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                      <TextBlock x:Name="AchProgressText" Classes="glanceTitle"/>
                      <ProgressBar x:Name="AchProgressBar" Classes="achBar" Width="170" Height="4" MinHeight="4" Minimum="0" Maximum="100"/>
                    </StackPanel>
                    <StackPanel x:Name="AchRecentIcons" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AchLatestText" Classes="statusLine" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </views:HeaderColumnsPanel>
          </StackPanel>
              </Border>
              <Border x:Name="SpotlightHeroGrip" Classes="resizeGrip" IsVisible="False" Height="10" VerticalAlignment="Bottom"
                      Background="Transparent" Cursor="SizeNorthSouth" ToolTip.Tip="{DynamicResource Spot.HeroGripTip}"/>
            </Grid>
          </Border>

          <!-- w14/layouts-a (#304): the Tabs layout's tab strip, upstream's fixed order (MainWindow.GameLayout.cs fills it). -->
          <Border x:Name="GameTabStripHost" Grid.Row="1" Classes="tabStrip" IsVisible="False">
            <WrapPanel x:Name="GameTabStrip" Orientation="Horizontal" ItemSpacing="24"/>
          </Border>

          <!-- w14/layouts-b (#305, mockup D): What's installed (a tile per component, like the Overview cards; a click opens the
               component cards in the side panel) and Tune this game (the At a glance tiles; a click opens that section there). -->
          <StackPanel x:Name="SpotlightBody" Grid.Row="1" Spacing="18" IsVisible="False">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource Spot.WhatsInstalled}" Classes="glanceHeading"/>
              <views:AutoFitPanel x:Name="SpotlightStatusTiles" MinColumnWidth="200" Spacing="10"/>
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource Spot.TuneThisGame}" Classes="glanceHeading"/>
              <views:AutoFitPanel x:Name="SpotlightTuneTiles" MinColumnWidth="260" MaxColumns="3" Spacing="10"/>
            </StackPanel>
          </StackPanel>

          <!-- Detail sections are collapsible and drag-reorderable; Linux stores state in XDG_CONFIG_HOME. -->
          <StackPanel x:Name="DetailSectionsPanel" Grid.Row="2" Spacing="14">
            <Border x:Name="RuntimeSection" Tag="Runtime" Classes="card"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="Runtime" FontSize="18" Foreground="{DynamicResource RhiMutedTextBrush}"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Sec.GameOverrides}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource RhiTextBrush}"/>
                    <TextBlock Text="{DynamicResource Sec.GameOverridesNote}" Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RuntimeSectionSummary" FontSize="11" Margin="0,3,0,0" IsVisible="False"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button x:Name="RuntimeSectionToggle" Grid.Column="2" Tag="Runtime" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>
                <!-- Label/value form; labels move above their values below ~760 px of detail width. -->
                <StackPanel x:Name="RuntimeSectionBody" Margin="0,10,0,0" Spacing="14">
                <views:LabelValuePanel x:Name="RuntimeFactsPanel" ColumnSpacing="18" RowSpacing="8" StackBelow="678">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Ui.Launcher}" Classes="muted"/>
                  <views:MiddleEllipsisText Grid.Row="0" Grid.Column="1" FullText="{Binding SelectedLaunchExecutable}" Foreground="{DynamicResource RhiSecondaryTextBrush}"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Ui.TargetSafety}" Classes="muted"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PatchTargetStatusText}" Foreground="{DynamicResource RhiAccentBrush}" TextWrapping="Wrap"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Ui.GameRoot}" Classes="muted"/>
                  <views:MiddleEllipsisText Grid.Row="2" Grid.Column="1" FullText="{Binding SelectedInstallPath}" Foreground="{DynamicResource RhiSecondaryTextBrush}"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Ui.Prefix}" Classes="muted"/>
                  <views:MiddleEllipsisText Grid.Row="3" Grid.Column="1" FullText="{Binding SelectedPrefix}" Foreground="{DynamicResource RhiSecondaryTextBrush}"/>

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Ui.TargetExe}" Classes="muted"/>
                  <views:MiddleEllipsisText Grid.Row="4" Grid.Column="1" FullText="{Binding SelectedExecutable}" Foreground="{DynamicResource RhiSecondaryTextBrush}"/>

                  <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Ui.PatchDirectory}" Classes="muted"/>
                  <views:MiddleEllipsisText Grid.Row="5" Grid.Column="1" FullText="{Binding SelectedBinaryDirectory}" Foreground="{DynamicResource RhiSecondaryTextBrush}"/>

                  <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Ui.GraphicsApi}" Classes="muted"/>
                  <TextBlock Grid.Row="6" Grid.Column="1" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel" Text="{Binding SelectedApi}" Foreground="{DynamicResource RhiSecondaryTextBrush}" TextWrapping="Wrap"/>

                  <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource Ui.ForceApi}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"/>
                  <StackPanel Grid.Row="7" Grid.Column="1" Spacing="4" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel">
                    <ComboBox Width="180" HorizontalAlignment="Left"
                              ItemsSource="{Binding GraphicsApiOverrideOptions}"
                              SelectedItem="{Binding SelectedGraphicsApiOverride, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelectGraphicsApiOverride}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Display}"/></DataTemplate>
                              </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding GraphicsApiOverrideHint}" Foreground="{DynamicResource RhiMutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>

                  <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource Ui.LumaMode}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"/>
                  <StackPanel Grid.Row="8" Grid.Column="1" Spacing="4" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel">
                    <ComboBox Width="180" HorizontalAlignment="Left"
                              ItemsSource="{Binding LumaModeOptions}"
                              SelectedItem="{Binding SelectedLumaModePreference, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelectLumaMode}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Display}"/></DataTemplate>
                              </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding LumaPolicyText}" Foreground="{DynamicResource RhiMutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LumaCoexistenceText}" Foreground="{DynamicResource RhiMutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>

                  <!-- #251: the HDR section only for games that can use HDR; why it shows lives in the label's 2 s tooltip. -->
                  <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource Ui.HdrExecution}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"
                             IsVisible="{Binding Runtime.ShowHdrRow}" ToolTip.Tip="{Binding Runtime.HdrSectionTip}" ToolTip.ShowDelay="2000"/>
                  <StackPanel Grid.Row="9" Grid.Column="1" Spacing="5" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel" IsVisible="{Binding ShowHdrRow}">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                      <ComboBox Width="180" ItemsSource="{Binding HdrModeOptions}" SelectedItem="{Binding SelectedHdrMode, Mode=TwoWay}" IsEnabled="{Binding CanEditHdrProfile}"
                                ToolTip.Tip="{Binding HdrModeTip}" ToolTip.ShowDelay="2000">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Display}"/></DataTemplate>
                              </ComboBox.ItemTemplate>
                      </ComboBox>
                      <CheckBox Content="{DynamicResource Ui.LegacyWsi}" IsChecked="{Binding HdrLegacyWsi, Mode=TwoWay}" IsEnabled="{Binding CanEditHdrProfile}"
                                IsVisible="{Binding ShowHdrLegacyWsi}" ToolTip.Tip="{DynamicResource Ui.LegacyWsiTip}" ToolTip.ShowDelay="2000"/>
                      <Button Classes="rhi" Content="{DynamicResource Ui.CopyLaunchProfile}" Click="CopyHdrLaunchOptions_Click" IsEnabled="{Binding CanCopyHdrLaunchOptions}"
                              IsVisible="{Binding ShowHdrLaunchProfile}" Padding="10,5"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding HdrProfileHint}" Foreground="{DynamicResource RhiMutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding HdrLaunchOptions}" Foreground="{DynamicResource RhiAccentBrush}" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding ShowHdrLaunchProfile}"/>
                  </StackPanel>

                  <!-- #191 resolution auto-toggle (saved with the HDR profile). w12/hdr-wsi (#251 correction): its own row, so it stays
                       wherever a switch can apply when the HDR row above is hidden. -->
                  <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding Runtime.ResolutionRowLabel}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"
                             IsVisible="{Binding Runtime.ShowResolutionRow}"/>
                  <views:ResolutionToggleRow Grid.Row="10" Grid.Column="1" DataContext="{Binding Runtime}"/>

                  <!-- w14/display-modes (#311): the display mode switch beside the HDR / resolution rows (Classic+'s Game Overrides; Tabs
                       hosts the same reusable view in its game header); shown while Settings › Display & HDR › Display modes is on. -->
                  <TextBlock Grid.Row="11" Grid.Column="0" Text="{l:T Dm.Label}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"
                             IsVisible="{Binding DisplayModes.ShowSwitch}"/>
                  <views:DisplayModeSwitchView x:Name="DisplayModeSwitch" Grid.Row="11" Grid.Column="1"/>

                  <!-- w14/layouts-c (upstream 2.9.0+ Game Overrides › Launch arguments and Reset launch options): saved on focus lost or
                       Enter; the line under it says how the arguments reach the game on Linux, or where to add them. -->
                  <TextBlock Grid.Row="12" Grid.Column="0" Text="{l:T LcArgs.Label}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"/>
                  <StackPanel x:Name="LaunchArgumentsRow" Grid.Row="12" Grid.Column="1" Spacing="4" DataContext="{Binding LaunchArguments}" x:DataType="vm:LaunchArgumentsPresenter">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                      <TextBox x:Name="LaunchArgumentsBox" MinWidth="260" Text="{Binding Text, Mode=TwoWay}" PlaceholderText="{l:T LcArgs.Placeholder}"
                               IsEnabled="{Binding HasGame}" ToolTip.Tip="{Binding Tip}" ToolTip.ShowDelay="1000" LostFocus="LaunchArgumentsBox_LostFocus">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}"/>
                        </TextBox.KeyBindings>
                      </TextBox>
                      <Button x:Name="ResetLaunchOptionsButton" Classes="rhi" Content="{l:T LcArgs.Reset}" Command="{Binding ResetCommand}" IsEnabled="{Binding HasGame}"
                              ToolTip.Tip="{l:T LcArgs.ResetTip}" Padding="10,5"/>
                      <!-- w14/launcher-options (#318): Add to Steam launch options / Lutris arguments / Heroic game arguments (or Remove). -->
                      <Button x:Name="LauncherOptionsButton" Classes="rhi" Content="{Binding LauncherButtonText}" Command="{Binding ToggleLauncherOptionsCommand}"
                              IsVisible="{Binding ShowLauncherButton}" ToolTip.Tip="{Binding LauncherButtonTip}" ToolTip.ShowDelay="1000" Padding="10,5"/>
                    </WrapPanel>
                    <TextBlock x:Name="LaunchArgumentsNote" Text="{Binding Note}" Foreground="{DynamicResource RhiMutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LauncherOptionsNote" Text="{Binding LauncherCopyNote}" Foreground="{DynamicResource RhiAccentBrush}" FontSize="11" TextWrapping="Wrap"
                               IsVisible="{Binding LauncherCopyNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>

                  <TextBlock Grid.Row="13" Grid.Column="0" Text="{DynamicResource Ui.EngineArchitecture}" Classes="muted"/>
                  <TextBlock Grid.Row="13" Grid.Column="1" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel" Text="{Binding SelectedEngineHint}" Foreground="{DynamicResource RhiSecondaryTextBrush}" TextWrapping="Wrap"/>

                  <TextBlock Grid.Row="14" Grid.Column="0" Text="{DynamicResource Ui.ApiEvidence}" Classes="muted"/>
                  <TextBlock Grid.Row="14" Grid.Column="1" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel" Text="{Binding SelectedApiEvidence}" Foreground="{DynamicResource RhiMutedTextBrush}" TextWrapping="Wrap"/>
                </views:LabelValuePanel>
                  <!-- w14/layouts-a (#304): upstream Game Overrides' ReShade card (was the ReShade profile section). -->
                  <Border x:Name="GameOverridesReShadeCard" Classes="subCard">
                    <StackPanel Spacing="10">
                      <TextBlock Text="{DynamicResource Sec.ReShadeCard}" Classes="subCardTitle"/>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource Ui.ManagedProfileControls}" Classes="muted" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <Button Classes="rhi" Content="{DynamicResource Ui.CheckUpdate}" Command="{Binding ReShadeProfile.CheckReShadeUpdateCommand}" IsEnabled="{Binding HasConfirmedPatchTarget}"/>
                          <Button Content="{DynamicResource Ui.ApplyUpdate}" Command="{Binding ReShadeProfile.ApplyReShadeProfileCommand}" IsEnabled="{Binding HasConfirmedPatchTarget}"
                                  Background="{DynamicResource RhiButtonBrush}" Foreground="{DynamicResource RhiButtonTextBrush}" BorderBrush="{DynamicResource RhiButtonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7"/>
                        </StackPanel>
                      </Grid>

                      <Grid ColumnDefinitions="120,220,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <TextBlock Grid.Row="0" Text="{DynamicResource Ui.Channel}" Classes="muted" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ReShadeProfile.ReShadeChannels}" SelectedItem="{Binding ReShadeProfile.SelectedReShadeChannel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ReShadeProfile.ReShadeUpdateText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Text="{DynamicResource Ui.LegacyVersion}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding ReShadeProfile.IsReShadeLegacy}"/>
                        <!-- w5/reshade-core (#186): the RHI manifest's legacy versions (ReShadeLegacyPresenter). -->
                        <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ReShadeLegacy.Versions}"
                                  SelectedItem="{Binding ReShadeProfile.ReShadeLegacyVersion, Mode=TwoWay}" IsVisible="{Binding ReShadeProfile.IsReShadeLegacy}"
                                  ToolTip.Tip="{Binding ReShadeLegacy.VersionTip}" ToolTip.ShowDelay="2000"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource Ui.LegacyVersionNote}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding ReShadeProfile.IsReShadeLegacy}"/>

                        <TextBlock Grid.Row="2" Text="{DynamicResource Ui.CustomDll}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding ReShadeProfile.IsReShadeCustom}"/>
                        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ReShadeProfile.IsReShadeCustom}">
                          <TextBox Text="{Binding ReShadeProfile.ReShadeCustomDllPath}" PlaceholderText="{DynamicResource Ui.CustomDllPlaceholder}"/>
                          <Button Grid.Column="1" Content="{DynamicResource Ui.Browse}" Click="BrowseReShadeCustomDll_Click" Padding="12,6"/>
                          <Button Grid.Column="2" Content="{DynamicResource Ui.Clear}" Click="ClearReShadeCustomDll_Click" Padding="12,6"/>
                        </Grid>
                      </Grid>

                      <!-- w5/reshade-core (#186): the RHI manifest's ReShade note for this game (reshadeGameInfo). -->
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ReShadeLegacy.HasNote}">
                        <TextBlock Text="{Binding ReShadeLegacy.Note}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{Binding ReShadeLegacy.NoteLinkLabel}" Command="{Binding ReShadeLegacy.OpenNoteLinkCommand}"
                                IsVisible="{Binding ReShadeLegacy.HasNoteLink}" Padding="12,6" VerticalAlignment="Top"
                                ToolTip.Tip="{Binding ReShadeLegacy.NoteUrl}" ToolTip.ShowDelay="2000"/>
                      </Grid>

                      <!-- w3/dllnames (#120): ReShade's proxy DLL name; DllNamePickerViewModel. w7/reshade (#196): Reset DLL names
                           beside it, wrapping below at narrow widths. -->
                      <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="6" IsVisible="{Binding DllNamePicker.IsAvailable}">
                        <Grid ColumnDefinitions="120,220" ColumnSpacing="10">
                          <TextBlock Text="{Binding DllNamePicker.Label}" Classes="muted" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding DllNamePicker.Options}"
                                    SelectedItem="{Binding DllNamePicker.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding DllNamePicker.CanChoose}"
                                    ToolTip.Tip="{Binding DllNamePicker.Hint}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000"/>
                        </Grid>
                        <Button x:Name="ResetDllNamesButton" Content="{Binding DllNamePicker.ResetLabel}" Command="{Binding DllNamePicker.ResetCommand}"
                                IsVisible="{Binding DllNamePicker.CanReset}" IsEnabled="{Binding !IsBusy}" Padding="12,6" VerticalAlignment="Center"
                                ToolTip.Tip="{Binding DllNamePicker.ResetTip}" ToolTip.ShowDelay="2000"/>
                      </WrapPanel>

                      <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                        <TextBlock Text="D3DCompiler 47" Classes="muted" VerticalAlignment="Top" Margin="0,7,0,0"/>
                        <StackPanel Grid.Column="1" Spacing="7">
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding ReShadeProfile.ReShadeD3DCompiler47Path}"
                                     PlaceholderText="{DynamicResource Ui.D3DCompilerPlaceholder}"/>
                            <Button Grid.Column="1" Content="{DynamicResource Ui.Browse}" Click="BrowseD3DCompiler47_Click" Padding="12,6"/>
                            <Button Grid.Column="2" Content="{DynamicResource Ui.Clear}" Click="ClearD3DCompiler47_Click" Padding="12,6"/>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{DynamicResource Ui.InstallProtontricks}"
                                    Command="{Binding ReShadeProfile.InstallD3DCompilerWithProtontricksCommand}"
                                    IsVisible="{Binding ReShadeProfile.CanInstallD3DCompilerWithProtontricks}"
                                    Padding="12,6"/>
                            <Button Content="{Binding ReShadeProfile.D3DCompilerWinetricksButtonText}"
                                    Command="{Binding ReShadeProfile.InstallD3DCompilerWithWinetricksCommand}"
                                    IsVisible="{Binding ReShadeProfile.CanInstallD3DCompilerWithWinetricks}"
                                    Padding="12,6"/>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding ReShadeProfile.D3DCompilerToolHint}" Classes="muted" TextWrapping="Wrap"/>
                      <TextBlock Text="{DynamicResource Ui.D3DCompilerNote}"
                                 Classes="muted" TextWrapping="Wrap"/>

                      <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="4">
                        <CheckBox Content="{DynamicResource Ui.ManageReShadeIni}" IsChecked="{Binding ReShadeProfile.ReShadeManageIni}"/>
                        <TextBlock Text="{DynamicResource Ui.QuickPackages}" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <CheckBox Content="{DynamicResource Ui.Official}" IsChecked="{Binding ReShadeProfile.ShaderCrosireMaster}" ToolTip.Tip="crosire reshade-shaders master"/>
                        <CheckBox Content="{DynamicResource Ui.OfficialLegacy}" IsChecked="{Binding ReShadeProfile.ShaderCrosireLegacy}"/>
                        <CheckBox Content="clshortfuse HDR" IsChecked="{Binding ReShadeProfile.ShaderClshortfuse}"/>
                        <CheckBox Content="MaxG2D HDR" IsChecked="{Binding ReShadeProfile.ShaderMaxG2D}"/>
                        <Button Classes="rhi" Content="{DynamicResource Ui.FullShaderManager}" Click="ShadersAddons_Click" IsEnabled="{Binding HasConfirmedPatchTarget}" Padding="12,6"/>
                      </WrapPanel>
                      <TextBlock Text="{DynamicResource Ui.XdgSettingsNote}"
                                 Classes="muted" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="DlssStreamlineSection" Tag="DlssStreamline" Classes="card" BorderBrush="{DynamicResource RhiAccentBorderBrush}"
                    DataContext="{Binding Dlss}" x:DataType="vm:DlssPanelViewModel"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="DlssStreamline" FontSize="18" Foreground="{DynamicResource RhiMutedTextBrush}"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Sec.Dlss}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource RhiTextBrush}"/>
                    <TextBlock Text="{Binding DlssStatusSummary}" Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Border Grid.Column="2" Background="{DynamicResource RhiAccentTintBrush}" BorderBrush="{DynamicResource RhiAccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" MaxHeight="40">
                    <TextBlock Text="{DynamicResource Ui.GameDlls}" Foreground="{DynamicResource RhiAccentBrush}" FontSize="11"/>
                  </Border>
                  <Button x:Name="DlssStreamlineSectionToggle" Grid.Column="3" Tag="DlssStreamline" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>

                <StackPanel x:Name="DlssStreamlineSectionBody" Spacing="10">
                  <!-- One Grid-identical row per component; the controls wrap under the status when it would get < 220 px. -->
                  <!-- The version dropdowns are 190 px, wide enough for "310.8.2 (20/30/40/50)" so the five rows stay aligned, and
                       grow to a longer selected label: a closed ComboBox clips a long label with no ellipsis. -->
                  <StackPanel Spacing="7">
                    <views:ResponsiveRow Columns="170,*,145,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="2" MinStarWidth="220">
                      <TextBlock Text="{DynamicResource Ui.SuperResolution}" Foreground="{DynamicResource RhiTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      <views:MiddleEllipsisText Grid.Column="1" FullText="{Binding DlssSrPath}" Classes="muted" WrapNonPath="False" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Background="{DynamicResource RhiBadgeBrush}" BorderBrush="{DynamicResource RhiAccentBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,4">
                        <TextBlock Text="{Binding DlssSrDeploymentState}" Foreground="{DynamicResource RhiButtonTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </Border>
                      <ComboBox Grid.Column="3" MinWidth="190" ItemsSource="{Binding DlssSrVersions}" SelectedItem="{Binding SelectedDlssSrVersion}" IsEnabled="{Binding CanSwapDlssSr}"/>
                      <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Apply}" Command="{Binding SwapDlssComponentCommand}" CommandParameter="SR" IsEnabled="{Binding CanSwapDlssSr}"/>
                      <Button Grid.Column="5" Classes="rhi" Content="{DynamicResource Ui.Restore}" Command="{Binding RestoreDlssComponentCommand}" CommandParameter="SR" IsEnabled="{Binding DlssSrRestoreAvailable}"/>
                    </views:ResponsiveRow>
                    <views:ResponsiveRow Columns="170,*,145,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="2" MinStarWidth="220">
                      <TextBlock Text="{DynamicResource Ui.RayReconstruction}" Foreground="{DynamicResource RhiTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      <views:MiddleEllipsisText Grid.Column="1" FullText="{Binding DlssRrPath}" Classes="muted" WrapNonPath="False" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Background="{DynamicResource RhiBadgeBrush}" BorderBrush="{DynamicResource RhiAccentBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,4">
                        <TextBlock Text="{Binding DlssRrDeploymentState}" Foreground="{DynamicResource RhiButtonTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </Border>
                      <ComboBox Grid.Column="3" MinWidth="190" ItemsSource="{Binding DlssRrVersions}" SelectedItem="{Binding SelectedDlssRrVersion}" IsEnabled="{Binding CanSwapDlssRr}"/>
                      <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Apply}" Command="{Binding SwapDlssComponentCommand}" CommandParameter="RR" IsEnabled="{Binding CanSwapDlssRr}"/>
                      <Button Grid.Column="5" Classes="rhi" Content="{DynamicResource Ui.Restore}" Command="{Binding RestoreDlssComponentCommand}" CommandParameter="RR" IsEnabled="{Binding DlssRrRestoreAvailable}"/>
                    </views:ResponsiveRow>
                    <views:ResponsiveRow Columns="170,*,145,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="2" MinStarWidth="220">
                      <TextBlock Text="{DynamicResource Ui.FrameGeneration}" Foreground="{DynamicResource RhiTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      <views:MiddleEllipsisText Grid.Column="1" FullText="{Binding DlssFgPath}" Classes="muted" WrapNonPath="False" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Background="{DynamicResource RhiBadgeBrush}" BorderBrush="{DynamicResource RhiAccentBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,4">
                        <TextBlock Text="{Binding DlssFgDeploymentState}" Foreground="{DynamicResource RhiButtonTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </Border>
                      <ComboBox Grid.Column="3" MinWidth="190" ItemsSource="{Binding DlssFgVersions}" SelectedItem="{Binding SelectedDlssFgVersion}" IsEnabled="{Binding CanSwapDlssFg}"/>
                      <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Apply}" Command="{Binding SwapDlssComponentCommand}" CommandParameter="FG" IsEnabled="{Binding CanSwapDlssFg}"/>
                      <Button Grid.Column="5" Classes="rhi" Content="{DynamicResource Ui.Restore}" Command="{Binding RestoreDlssComponentCommand}" CommandParameter="FG" IsEnabled="{Binding DlssFgRestoreAvailable}"/>
                    </views:ResponsiveRow>
                    <views:ResponsiveRow Columns="170,*,145,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="2" MinStarWidth="220">
                      <TextBlock Text="{DynamicResource Ui.NeuralRendering}" Foreground="{DynamicResource RhiTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      <views:MiddleEllipsisText Grid.Column="1" FullText="{Binding DlssNrPath}" Classes="muted" WrapNonPath="False" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Background="{DynamicResource RhiBadgeBrush}" BorderBrush="{DynamicResource RhiAccentBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,4">
                        <TextBlock Text="{Binding DlssNrDeploymentState}" Foreground="{DynamicResource RhiButtonTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </Border>
                      <ComboBox Grid.Column="3" MinWidth="190" ItemsSource="{Binding DlssNrVersions}" SelectedItem="{Binding SelectedDlssNrVersion}" IsEnabled="{Binding CanSwapDlssNr}"/>
                      <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Apply}" Command="{Binding SwapDlssComponentCommand}" CommandParameter="NR" IsEnabled="{Binding CanSwapDlssNr}"/>
                      <Button Grid.Column="5" Classes="rhi" Content="{DynamicResource Ui.Restore}" Command="{Binding RestoreDlssComponentCommand}" CommandParameter="NR" IsEnabled="{Binding DlssNrRestoreAvailable}"/>
                    </views:ResponsiveRow>
                    <views:ResponsiveRow Columns="170,*,145,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="2" MinStarWidth="220">
                      <TextBlock Text="{DynamicResource Ui.StreamlineUpdate}" Foreground="{DynamicResource RhiTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                                 ToolTip.Tip="{DynamicResource Ui.StreamlineUpdateNote}"/>
                      <views:MiddleEllipsisText Grid.Column="1" FullText="{Binding StreamlinePath}" Classes="muted" WrapNonPath="False" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Background="{DynamicResource RhiBadgeBrush}" BorderBrush="{DynamicResource RhiAccentBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,4">
                        <TextBlock Text="{Binding StreamlineDeploymentState}" Foreground="{DynamicResource RhiButtonTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </Border>
                      <ComboBox Grid.Column="3" MinWidth="190" ItemsSource="{Binding StreamlineVersions}" SelectedItem="{Binding SelectedStreamlineVersion}" IsEnabled="{Binding CanSwapStreamline}"/>
                      <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Apply}" Command="{Binding SwapStreamlineCommand}" IsEnabled="{Binding CanSwapStreamline}"/>
                      <Button Grid.Column="5" Classes="rhi" Content="{DynamicResource Ui.Restore}" Command="{Binding RestoreStreamlineCommand}" IsEnabled="{Binding StreamlineRestoreAvailable}"/>
                    </views:ResponsiveRow>
                  </StackPanel>

                  <TextBlock Text="{DynamicResource Ui.StreamlineUpdateNote}" Classes="muted" TextWrapping="Wrap"/>

                  <!-- w7/nvapi-launch (#211): a ResponsiveRow (was a Grid) so the third button, NVIDIA settings…, moves under the
                       summary when narrow; shown only where the NVIDIA settings apply. -->
                  <views:ResponsiveRow Columns="*,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="1" MinStarWidth="160">
                    <TextBlock x:Name="DlssDefaultsSummaryText" Text="{Binding DlssDefaultsSummary}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Classes="rhi" Content="{DynamicResource Ui.ApplyDefaults}" Command="{Binding QuickApplyDlssDefaultsCommand}"
                            IsEnabled="{Binding CanQuickApplyDlssDefaults}" Padding="12,6"
                            ToolTip.Tip="{DynamicResource Ui.ApplyDefaultsTip}"/>
                    <Button Grid.Column="2" Classes="rhi" Content="{DynamicResource Ui.RestoreAll}" Command="{Binding RestoreAllDlssCommand}"
                            IsEnabled="{Binding CanRestoreAllDlss}" Padding="12,6"/>
                    <Button Grid.Column="3" x:Name="NvidiaSettingsButton" Classes="rhi" Content="{Binding Nvidia.ButtonText}" Padding="12,6"
                            IsVisible="{Binding Nvidia.IsShown}" Click="NvidiaSettings_Click"
                            ToolTip.Tip="{Binding Nvidia.ButtonTip}" ToolTip.ShowDelay="2000"/>
                  </views:ResponsiveRow>

                  <TextBlock Text="{DynamicResource Ui.DlssNote}" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="DriverSettingsSection" Tag="DriverSettings" Classes="card"
                    DataContext="{Binding Dlss}" x:DataType="vm:DlssPanelViewModel"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="DriverSettings" FontSize="18" Foreground="{DynamicResource RhiMutedTextBrush}"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Sec.Driver}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource RhiTextBrush}"/>
                    <TextBlock Text="{DynamicResource Sec.DriverNote}" Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DriverSettingsSectionSummary" FontSize="11" Margin="0,3,0,0" IsVisible="False"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button x:Name="DriverSettingsSectionToggle" Grid.Column="2" Tag="DriverSettings" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>
                <StackPanel x:Name="DriverSettingsSectionBody" Spacing="10">
                  <!-- w14/ui-logic (#310): the game's FPS Limit (upstream Driver Settings › FPS Limit), set through DXVK /
                       VKD3D-Proton launch variables; shown for Wine/Proton games whose launcher takes them. -->
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding FrameRateLimit.IsShown}">
                    <TextBlock Text="{l:T Fps.Label}" VerticalAlignment="Center" Classes="muted"/>
                    <ComboBox x:Name="FpsLimitCombo" ItemsSource="{Binding FrameRateLimit.Choices}" SelectedItem="{Binding FrameRateLimit.Selected}"
                              MinWidth="220" MaxDropDownHeight="300" ToolTip.Tip="{Binding FrameRateLimit.Tip}" ToolTip.ShowDelay="2000"/>
                    <TextBox x:Name="FpsLimitCustom" Text="{Binding FrameRateLimit.CustomText}" PlaceholderText="20–1000" Width="90"
                             IsVisible="{Binding FrameRateLimit.IsCustomEntry}"/>
                    <Button Classes="rhi" Content="{l:T Fps.Set}" Command="{Binding FrameRateLimit.ApplyCustomCommand}"
                            IsVisible="{Binding FrameRateLimit.IsCustomEntry}"/>
                  </StackPanel>
                  <TextBlock Text="{DynamicResource Sec.DriverNothing}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !FrameRateLimit.IsShown}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="ManagementSection" Tag="Management" Classes="card"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="Management" FontSize="18" Foreground="{DynamicResource RhiMutedTextBrush}"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Sec.Management}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource RhiTextBrush}"/>
                    <TextBlock Text="{DynamicResource Sec.ManagementNote}" Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ManagementSectionSummary" FontSize="11" Margin="0,3,0,0" IsVisible="False"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button x:Name="ManagementSectionToggle" Grid.Column="2" Tag="Management" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>
                <!-- w14/layouts-a (#304, upstream Management): Classic+ lays the actions out in one row in upstream's Classic+ order
                     (as written here); Tabs and Spotlight show them as tiles with a line under each, in upstream's Tabs order and
                     colours (ManagementActions; the window reorders them). -->
                <StackPanel x:Name="ManagementSectionBody" Spacing="8">
                  <views:AutoFitPanel x:Name="ManagementActions" MinColumnWidth="150" Spacing="8">
                    <Button x:Name="ManagementChangeFolder" Classes="rhi managementTile" Click="EditGame_Click" IsEnabled="{Binding CanEditSelectedGame}"
                            ToolTip.Tip="{DynamicResource Mgmt.ChangeFolderTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource Mgmt.ChangeFolder}" Classes="tileTitle"/>
                        <TextBlock Text="{DynamicResource Mgmt.ChangeFolderDesc}" Classes="tileDesc"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="ManagementResetFolder" Classes="rhi managementTile" Click="ResetInstallFolder_Click" IsEnabled="{Binding CanResetInstallFolder}"
                            IsVisible="{Binding ShowResetInstallFolder}" ToolTip.Tip="{Binding ResetInstallFolderTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource Mgmt.ResetFolder}" Classes="tileTitle"/>
                        <TextBlock Text="{DynamicResource Mgmt.ResetFolderDesc}" Classes="tileDesc"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="ManagementRemove" Classes="rhi managementTile remove" Command="{Binding RemoveFromRhiAnyCommand}" IsEnabled="{Binding CanRemoveFromRhiAny}"
                            ToolTip.Tip="{Binding RemoveFromRhiAnyTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource Removed.Remove}" Classes="tileTitle"/>
                        <TextBlock Text="{Binding RemoveFromRhiDesc}" Classes="tileDesc"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="ManagementResetOverrides" Classes="rhi managementTile remove" Command="{Binding ResetOverridesCommand}" IsEnabled="{Binding CanResetOverrides}"
                            ToolTip.Tip="{DynamicResource Mgmt.ResetOverridesTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource Mgmt.ResetOverrides}" Classes="tileTitle"/>
                        <TextBlock Text="{DynamicResource Mgmt.ResetOverridesDesc}" Classes="tileDesc"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="ManagementCopyReport" Classes="rhi managementTile" Command="{Binding CopyReportCommand}" IsEnabled="{Binding HasSelectedGame}"
                            ToolTip.Tip="{DynamicResource Mgmt.CopyReportTip}" ToolTip.ShowDelay="2000">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource Mgmt.CopyReport}" Classes="tileTitle"/>
                        <TextBlock Text="{DynamicResource Mgmt.CopyReportDesc}" Classes="tileDesc"/>
                      </StackPanel>
                    </Button>
                  </views:AutoFitPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="NeuralRenderingSection" Tag="NeuralRendering" Classes="card" BorderBrush="{DynamicResource RhiButtonBorderBrush}"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="NeuralRendering" FontSize="18" Foreground="{DynamicResource RhiMutedTextBrush}"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Sec.NeuralRendering}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource RhiTextBrush}"/>
                    <TextBlock Text="{DynamicResource Sec.NeuralRenderingNote}" Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NeuralRenderingSectionSummary" FontSize="11" Margin="0,3,0,0" IsVisible="False"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button x:Name="NeuralRenderingSectionToggle" Grid.Column="2" Tag="NeuralRendering" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>

                <StackPanel x:Name="NeuralRenderingSectionBody" Spacing="10">
                  <!-- w14/layouts-a (#304): the recommended method and Check… (were the Neural rendering line of Launch / Game). -->
                  <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Ui.NeuralRendering}" Classes="muted"/>
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="12" LineSpacing="6">
                      <TextBlock DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel" Text="{Binding NeuralRenderingRecommendation}" Foreground="{DynamicResource RhiButtonTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      <Button x:Name="NeuralRenderingCheckButton" Classes="rhi" Padding="12,4" VerticalAlignment="Center"
                              Content="{Binding NrCheck.ButtonText}" Command="{Binding NrCheck.OpenCommand}" IsVisible="{Binding NrCheck.IsAvailable}"
                              ToolTip.Tip="{Binding NrCheck.ButtonTip}" ToolTip.ShowDelay="2000"/>
                    </WrapPanel>
                  </Grid>
                  <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                    <TextBlock Text="{DynamicResource Ui.FeederConsumer}" Classes="muted" VerticalAlignment="Top" Margin="0,7,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="7">
                      <ComboBox Width="280" HorizontalAlignment="Left"
                                ItemsSource="{Binding Dlss5FeederConsumerOptions}"
                                SelectedItem="{Binding SelectedDlss5FeederConsumer, Mode=TwoWay}"/>
                      <StackPanel Spacing="7" IsVisible="{Binding IsDeepFriedChickenFeederConsumer}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBox Text="{Binding Dlss5FeederConsumerPackagePath}"
                                   PlaceholderText="{DynamicResource Ui.FeederPackagePlaceholder}"/>
                          <Button Grid.Column="1" Content="{DynamicResource Ui.Browse}" Click="BrowseDlss5FeederConsumer_Click" Padding="12,6"/>
                          <Button Grid.Column="2" Content="{DynamicResource Ui.Clear}" Click="ClearDlss5FeederConsumer_Click" Padding="12,6"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Ui.FeederPackageNote}" Classes="muted" TextWrapping="Wrap"/>
                      </StackPanel>
                      <TextBlock Text="{DynamicResource Ui.FeederRenoDxNote}" Classes="muted" TextWrapping="Wrap"
                                 IsVisible="{Binding IsRenoDxDlss5FeederConsumer}"/>
                    </StackPanel>
                  </Grid>

                  <Border Background="{DynamicResource RhiPanelInsetBrush}" BorderBrush="{DynamicResource RhiPanelInsetBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10"
                          DataContext="{Binding Extras}" x:DataType="vm:ExtrasViewModel">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{DynamicResource Ui.NrVersions}" Classes="muted" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Ui.LatestPinNote}" Classes="muted" TextWrapping="Wrap"/>
                        <Button Grid.Column="2" Content="{DynamicResource Ui.LoadHistory}" Command="{Binding LoadNeuralVersionHistoryCommand}"
                                IsEnabled="{Binding CanLoadNeuralVersionHistory}" Padding="12,6"/>
                      </Grid>
                      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="7">
                        <Grid ColumnDefinitions="120,220" ColumnSpacing="8">
                          <TextBlock Text="Feeder" Classes="muted" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding Dlss5FeederVersionOptions}"
                                    SelectedItem="{Binding SelectedDlss5FeederVersion, Mode=TwoWay}"
                                    IsEnabled="{Binding CanConfigureFeederVersionPin}"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,220" ColumnSpacing="8">
                          <TextBlock Text="DX11 Bridge" Classes="muted" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding Dlss5BridgeVersionOptions}"
                                    SelectedItem="{Binding SelectedDlss5BridgeVersion, Mode=TwoWay}"
                                    IsEnabled="{Binding CanConfigureBridgeVersionPin}"/>
                        </Grid>
                        <Grid ColumnDefinitions="100,220" ColumnSpacing="8">
                          <TextBlock Text="ShortFuse" Classes="muted" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding ShortFuseVersionOptions}"
                                    SelectedItem="{Binding SelectedShortFuseVersion, Mode=TwoWay}"
                                    IsEnabled="{Binding CanConfigureShortFuseVersionPin}"/>
                        </Grid>
                        <!-- w14/nr (#274): GITC Uplift's version (upstream "Uplift Version"; Latest follows updates). -->
                        <Grid ColumnDefinitions="100,220" ColumnSpacing="8" IsVisible="{Binding ShowGitcUplift}">
                          <TextBlock Text="{DynamicResource Ui.UpliftVersion}" Classes="muted" VerticalAlignment="Center"/>
                          <ComboBox x:Name="GitcUpliftVersion" Grid.Column="1" ItemsSource="{Binding GitcUpliftVersionOptions}"
                                    SelectedItem="{Binding SelectedGitcUpliftVersion, Mode=TwoWay}"
                                    IsEnabled="{Binding CanConfigureUpliftVersionPin}"
                                    ToolTip.Tip="{DynamicResource Ui.UpliftVersionTip}" ToolTip.ShowDelay="2000"/>
                        </Grid>
                        <!-- w14/nr-2 (#317/#276): DLSS5 Tool's version (upstream "DLSS5 Tool Version"; the Foveated list while Foveated is on). -->
                        <Grid ColumnDefinitions="Auto,220" ColumnSpacing="8" IsVisible="{Binding ShowDlss5Tool}">
                          <TextBlock Text="{Binding Dlss5ToolVersionLabel}" Classes="muted" VerticalAlignment="Center" MinWidth="100"/>
                          <ComboBox x:Name="Dlss5ToolVersion" Grid.Column="1" ItemsSource="{Binding Dlss5ToolVersionOptions}"
                                    SelectedItem="{Binding SelectedDlss5ToolVersion, Mode=TwoWay}"
                                    IsEnabled="{Binding CanConfigureDlss5ToolVersionPin}"
                                    ToolTip.Tip="{DynamicResource Ui.Dlss5ToolVersionTip}" ToolTip.ShowDelay="2000"/>
                        </Grid>
                      </WrapPanel>
                      <Grid ColumnDefinitions="120,220,*" ColumnSpacing="8">
                        <TextBlock Text="NR DLL" Classes="muted" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding NeuralRenderingDllVersionOptions}"
                                  SelectedItem="{Binding SelectedNeuralRenderingDllVersion, Mode=TwoWay}"
                                  ToolTip.Tip="{Binding NeuralRenderingDllVersionsTip}" ToolTip.ShowDelay="2000"
                                  IsEnabled="{Binding CanConfigureNeuralRenderingDllVersion}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Ui.NrDllVersionNote}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      </Grid>
                      <views:NrCostScalerRow/> <!-- w3/parity hook (#96) -->
                      <!-- w14/nr-2 (#276): the Foveated build of the DLSS5 Tool (upstream: beside the Cost Scaler, DLSS5 Tool methods). -->
                      <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="6" IsVisible="{Binding ShowDlss5Tool}">
                        <CheckBox x:Name="Dlss5ToolFoveated" Content="{DynamicResource Ui.Dlss5ToolFoveated}" IsChecked="{Binding Dlss5ToolFoveated, Mode=TwoWay}"
                                  IsEnabled="{Binding CanConfigureDlss5ToolFoveated}"
                                  ToolTip.Tip="{DynamicResource Ui.Dlss5ToolFoveatedTip}" ToolTip.ShowDelay="2000"/>
                        <Button x:Name="FoveatedDlss5Link" Content="{DynamicResource Ui.Dlss5ToolFoveatedLink}" Command="{Binding OpenFoveatedDlss5LinkCommand}" Padding="12,4"
                                ToolTip.Tip="{DynamicResource Ui.Dlss5ToolFoveatedLinkTip}" ToolTip.ShowDelay="2000"/>
                      </WrapPanel>
                      <!-- w14/nr (#274): GITC Uplift's iMMERSE Launchpad toggle (motion vectors) and its link, upstream's NR section. -->
                      <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="6" IsVisible="{Binding ShowGitcUplift}">
                        <CheckBox x:Name="GitcUpliftLaunchpad" Content="{DynamicResource Ui.UpliftLaunchpad}" IsChecked="{Binding UpliftLaunchpad, Mode=TwoWay}"
                                  IsEnabled="{Binding CanConfigureUpliftLaunchpad}"
                                  ToolTip.Tip="{DynamicResource Ui.UpliftLaunchpadTip}" ToolTip.ShowDelay="2000"/>
                        <Button x:Name="GitcUpliftLink" Content="{DynamicResource Ui.UpliftLink}" Command="{Binding OpenGitcUpliftLinkCommand}" Padding="12,4"
                                ToolTip.Tip="{DynamicResource Ui.UpliftLinkTip}" ToolTip.ShowDelay="2000"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="ManagedComponentsSection" Tag="ManagedComponents" Classes="card"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="ManagedComponents" FontSize="18" Foreground="{DynamicResource RhiMutedTextBrush}"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Sec.Components}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource RhiTextBrush}"/>
                    <TextBlock Text="{DynamicResource Ui.ManagedComponentsNote}"
                               Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ManagedComponentsSectionSummary" FontSize="11" Margin="0,3,0,0" IsVisible="False"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Border Grid.Column="2" Background="{DynamicResource RhiInstalledTintBrush}" BorderBrush="{DynamicResource RhiInstalledBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" MaxHeight="40">
                    <TextBlock Text="{DynamicResource Ui.LinuxBackendActive}" Foreground="{DynamicResource RhiInstalledBrush}" FontSize="11"/>
                  </Border>
                  <Button x:Name="ManagedComponentsSectionToggle" Grid.Column="3" Tag="ManagedComponents" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>
                <!-- w14 final review (upstream 2.9.4 DetailLayoutHost.Overview): Tabs' Overview heads its cards "Components", as
                     it heads the tiles "At a glance" (the section's own header is hidden there). -->
                <TextBlock x:Name="OverviewComponentsHeading" Text="{DynamicResource Sec.Components}" Classes="glanceHeading" IsVisible="False"/>

                <ItemsControl x:Name="ManagedComponentsSectionBody" ItemsSource="{Binding Components}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentRowViewModel">
                      <Border Background="{DynamicResource RhiRowBrush}" BorderBrush="{DynamicResource RhiBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="14,11">
                        <StackPanel Spacing="6">
                          <!-- w12/luma (#245 correction 2): Nexus → ⚙ → Install/Remove → ⓘ, each in its own column. The ⚙ → Install/Remove → ⓘ
                               order and columns are the ones every row had before; only the Nexus column (3) is new, and it takes no
                               spacing when its button is hidden, so every row without it lays out exactly as before. -->
                          <views:ResponsiveRow Columns="220,180,*,Auto,Auto,Auto,Auto" ColumnSpacing="12" LineSpacing="8" HeadColumns="2" MinStarWidth="160" SkipEmptyColumns="3">
                            <!-- Names wider than the 220 px column end in a word ellipsis; the full name is in a 2 s tooltip. -->
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource RhiTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="WordEllipsis" ToolTip.Tip="{Binding Name}" ToolTip.ShowDelay="2000"/>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource RhiInstalledBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Note}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="3" Classes="rhi" Content="{Binding LumaNexus.Label}" IsVisible="{Binding LumaNexus.IsVisible}" Command="{Binding LumaNexus.Command}" CommandParameter="{Binding LumaNexus.Url}" ToolTip.Tip="{Binding LumaNexus.Tip}" ToolTip.ShowDelay="2000" Padding="10,6"/><!-- w12/luma (#245): Nexus-only Luma mod; opens its Nexus page, downloads nothing -->
                            <Button Grid.Column="4" Classes="rhi" Content="⚙" IsVisible="{Binding HasRenoDxSettings}"
                                    Click="RenoDxSettings_Click" ToolTip.Tip="{DynamicResource Ui.RenoDxSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="4" Classes="rhi" Content="⚙" IsVisible="{Binding HasOptiScalerSettings}"
                                    Click="OptiScalerSettings_Click" ToolTip.Tip="{DynamicResource Ui.OptiScalerSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="4" Classes="rhi" Content="⚙" IsVisible="{Binding HasDlssg2030Settings}"
                                    Click="Dlssg2030Settings_Click" ToolTip.Tip="{DynamicResource Ui.Dlssg2030SettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="4" Classes="rhi" Content="⚙" IsVisible="{Binding HasStandaloneDlssEnablerSettings}"
                                    Click="StandaloneDlssEnablerSettings_Click" ToolTip.Tip="{DynamicResource Ui.DlssEnablerStandaloneSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="4" Classes="rhi" Content="⚙" IsVisible="{Binding HasRtx40MfgSettings}"
                                    Click="Rtx40MfgSettings_Click" ToolTip.Tip="{DynamicResource Ui.Rtx40MfgSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="4" Classes="rhi" Content="⚙" IsVisible="{Binding HasRtxEncoreSettings}"
                                    Click="RtxEncoreSettings_Click" ToolTip.Tip="{DynamicResource Ui.RtxEncoreSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="4" Classes="rhi" Content="⚙" IsVisible="{Binding HasMfgUnlockSettings}"
                                    Click="MfgUnlockSettings_Click" ToolTip.Tip="{DynamicResource Mfgu.SettingsTip}" Padding="10,6"/><!-- w14/extras-fg (#279) -->
                            <Button Grid.Column="4" Classes="rhi" Content="⚙" IsVisible="{Binding HasReFrameworkSettings}"
                                    Click="ReFrameworkSettings_Click" ToolTip.Tip="{Binding ReFrameworkSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="4" Classes="rhi" Content="⚙" IsVisible="{Binding HasIniSettings}"
                                    Click="IniSettings_Click" ToolTip.Tip="{Binding IniSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="4" Classes="rhi" Content="⚙" IsVisible="{Binding HasDxvkHdrSettings}"
                                    Click="DxvkHdrSettings_Click" ToolTip.Tip="{Binding DxvkHdrSettingsTip}" ToolTip.ShowDelay="2000" Padding="10,6"/>
                            <Button Grid.Column="4" Classes="rhi" Content="⚙" IsVisible="{Binding HasEmptySettings}"
                                    Click="EmptySettings_Click" ToolTip.Tip="{Binding EmptySettingsTip}" ToolTip.ShowDelay="2000" Padding="10,6"/><!-- w14/ui-settings (#297) -->
                            <Button Grid.Column="5" Classes="rhi" Classes.remove="{Binding IsRemoveAction}"
                                    Content="{Binding Action}" IsEnabled="{Binding IsActionEnabled}" Command="{Binding Command}"
                                    CommandParameter="{Binding CommandParameter}" ToolTip.Tip="{Binding Note}" MinWidth="80" IsVisible="{Binding HasAction}"/>
                            <!-- #210: highlighted (accent border on the pressed-state surface) when the dialog has notes for this game. -->
                            <Button Grid.Column="6" Classes="rhi" Classes.gameNotes="{Binding InfoHighlight.IsGameSpecific}" Content="ⓘ"
                                    IsVisible="{Binding HasInfo}" Click="ComponentInfo_Click"
                                    ToolTip.Tip="{Binding InfoHighlight.Tip}" ToolTip.ShowDelay="2000" Padding="10,6">
                              <Button.Styles>
                                <Style Selector="Button.rhi.gameNotes">
                                  <Setter Property="Background" Value="{DynamicResource RhiControlPressedBrush}"/>
                                  <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
                                </Style>
                                <Style Selector="Button.rhi.gameNotes:pointerover">
                                  <Setter Property="Background" Value="{DynamicResource RhiControlHoverBrush}"/>
                                  <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
                                </Style>
                              </Button.Styles>
                            </Button>
                          </views:ResponsiveRow>
                          <!-- RenoDX/Luma only: installed add-on file name(s) and mod author on one line; a line wider than
                               the row is shortened in the middle, full text in a 2 s tooltip. -->
                          <views:MiddleEllipsisText FullText="{Binding Credit}" IsVisible="{Binding HasCredit}" Classes="muted" FontSize="11"
                                                    WrapNonPath="False" MiddleNonPath="True"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border x:Name="ExtrasSection" Tag="Extras" Classes="card" BorderBrush="{DynamicResource RhiExtrasBorderBrush}"
                    DataContext="{Binding Extras}" x:DataType="vm:ExtrasViewModel"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="Extras" FontSize="18" Foreground="{DynamicResource RhiMutedTextBrush}"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Sec.Extras}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource RhiTextBrush}"/>
                    <TextBlock Text="{DynamicResource Ui.ExtrasNote}" Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ExtrasSectionSummary" FontSize="11" Margin="0,3,0,0" IsVisible="False"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button x:Name="ExtrasSectionToggle" Grid.Column="2" Tag="Extras" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>
                <StackPanel x:Name="ExtrasSectionBody" Spacing="10">
                  <views:ResponsiveRow x:Name="UalRow" Columns="150,150,190,Auto,Auto,Auto,Auto" ColumnSpacing="10" LineSpacing="8" HeadColumns="2">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Ultimate ASI Loader" Foreground="{DynamicResource RhiTextBrush}" FontWeight="SemiBold"/>
                      <TextBlock Text="{DynamicResource Ui.WineProtonProxy}" Classes="muted" FontSize="10"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding UalStatusText}" Foreground="{DynamicResource RhiInstalledBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding UalProxyNames}"
                              SelectedItem="{Binding SelectedUalProxyName}"
                              IsEnabled="{Binding CanSelectUalProxy}"
                              ToolTip.Tip="{DynamicResource Ui.ProxyNameTip}"/>

                    <Button Grid.Column="3" Classes="rhi" Content="{DynamicResource Ui.CheckUpdate}"
                            Command="{Binding CheckUalUpdateCommand}"
                            IsEnabled="{Binding HasSelectedGame}"
                            Padding="12,6"/>

                    <Button Grid.Column="4" Classes="rhi" Content="{Binding UalActionText}"
                            Command="{Binding InstallOrUpdateUalCommand}"
                            IsEnabled="{Binding CanInstallOrUpdateUal}"
                            Padding="12,6"/>

                    <!-- w14/layouts-a (#297 owner decision): ASI Loader's ⚙ with nothing to set, between Install and Remove (upstream 2.9.0). -->
                    <Button x:Name="UalSettingsButton" Grid.Column="5" Classes="rhi" Content="⚙" Click="AsiLoaderSettings_Click"
                            ToolTip.Tip="{Binding UalSettingsTip}" ToolTip.ShowDelay="2000" Padding="10,6"/>

                    <Button Grid.Column="6" Classes="rhi remove" Content="{DynamicResource Ui.Remove}"
                            Command="{Binding RemoveUalCommand}"
                            IsEnabled="{Binding CanRemoveUal}"
                            Padding="12,6"/>
                  </views:ResponsiveRow>

                  <TextBlock Text="{Binding UalProxyHint}" Classes="muted" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding UalLatestVersionText}" Classes="muted" TextWrapping="Wrap"/>

                  <Border Height="1" Background="{DynamicResource RhiDividerBrush}" Margin="0,4"/>
                  <views:ResponsiveRow Columns="150,180,190,Auto,Auto" ColumnSpacing="10" LineSpacing="8" HeadColumns="2">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="ShortFuse / DLSS FG" Foreground="{DynamicResource RhiTextBrush}" FontWeight="SemiBold"/>
                      <TextBlock Text="{DynamicResource Ui.PerGameOrchestration}" Classes="muted" FontSize="10"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ShortFuseStatusText}" Foreground="{DynamicResource RhiInstalledBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <CheckBox Grid.Column="2" Content="{DynamicResource Ui.AutoAsiConfig}" IsChecked="{Binding ShortFuseAutoConfigEnabled}"
                              IsEnabled="{Binding CanConfigureShortFuse}" VerticalAlignment="Center"
                              ToolTip.Tip="{DynamicResource Ui.ShortFuseAutoTip}"/>
                    <Button Grid.Column="3" Classes="rhi" Content="{DynamicResource Ui.CheckUpdate}" Command="{Binding CheckShortFuseUpdateCommand}"
                            IsEnabled="{Binding HasSelectedGame}" Padding="12,6"/>
                    <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Install}" Command="{Binding InstallOrRemoveShortFuseCommand}"
                            IsVisible="{Binding ShortFuseNotInstalled}" IsEnabled="{Binding CanInstallOrRemoveShortFuse}"
                            ToolTip.Tip="{Binding ShortFuseActionHint}" Padding="12,6"/>
                    <Button Grid.Column="4" Classes="rhi remove" Content="{DynamicResource Ui.Remove}" Command="{Binding InstallOrRemoveShortFuseCommand}"
                            IsVisible="{Binding ShortFuseInstalled}" IsEnabled="{Binding CanInstallOrRemoveShortFuse}"
                            ToolTip.Tip="{Binding ShortFuseActionHint}" Padding="12,6"/>
                  </views:ResponsiveRow>
                  <CheckBox Content="{DynamicResource Ui.ShortFuseZzzLoadOrder}" IsChecked="{Binding ShortFuseZzzLoadOrder}"
                            IsEnabled="{Binding CanConfigureShortFuseZzzLoadOrder}"
                            ToolTip.Tip="{DynamicResource Ui.ShortFuseZzzTip}"/>
                  <TextBlock Text="{Binding ShortFuseLatestVersionText}" Classes="muted" TextWrapping="Wrap"/>
                  <views:HsfRow/> <!-- w14/extras-addons (#277): HSF frame generation (upstream Extras › MFG Unlocks) -->
                  <TextBlock Text="{DynamicResource Ui.LinuxPolicyNote}" Classes="muted" TextWrapping="Wrap"/>
                  <TextBlock Text="{DynamicResource Ui.UalPolicyNote}"
                             Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- w14/layouts-a (#304, upstream Overview): At a glance, a tile per other section with its summary; a click opens its tab. -->
          <StackPanel x:Name="GlancePanel" Grid.Row="3" Spacing="10" IsVisible="False">
            <TextBlock Text="{DynamicResource Glance.Title}" Classes="glanceHeading"/>
            <views:AutoFitPanel x:Name="GlanceTiles" MinColumnWidth="220" Spacing="12"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{DynamicResource RhiStatusBarBrush}" Opacity="0.96" IsVisible="{Binding IsBusy}" ZIndex="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="280" Height="4"/>
          <TextBlock Text="{DynamicResource Ui.Processing}" Foreground="{DynamicResource RhiSecondaryTextBrush}"/>
          <!-- Stops the running operation (Refs #77); hidden for operations that cannot stop part-way. -->
          <Button Classes="rhi" Content="{DynamicResource Ui.CancelOperation}" HorizontalAlignment="Center"
                  Command="{Binding Operations.CancelCommand}" IsVisible="{Binding Operations.CanCancel}"/>
        </StackPanel>
      </Border>

      <!-- w14/layouts-b (#305, upstream 2.9.0 Spotlight): the side panel slides in from the right over the page. It holds a
           section as Tabs arranges it (the same section, moved in while open), the component cards, Screenshots, Achievements,
           Game settings or Artwork. A component's ⚙ opens in it with a back button to the section. A click on the dimmed page,
           ✕ or Esc closes it. -->
      <Grid x:Name="SpotlightPanelOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" ZIndex="15" IsVisible="False">
        <Border x:Name="SpotlightPanelScrim" Classes="spotScrim" PointerPressed="SpotlightScrim_PointerPressed"/>
        <Border x:Name="SpotlightPanelSheet" Classes="spotSheet" HorizontalAlignment="Right">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="24,20,20,12">
              <Button x:Name="SpotlightPanelBack" Classes="rhi" IsVisible="False" Click="SpotlightPanelBack_Click" Padding="8,4,12,4"/>
              <TextBlock x:Name="SpotlightPanelTitle" Grid.Column="1" Classes="spotPanelTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Button x:Name="SpotlightPanelClose" Grid.Column="2" Classes="rhi topIcon" Content="✕" Click="SpotlightPanelClose_Click"
                      ToolTip.Tip="{DynamicResource Win.Close}" AutomationProperties.Name="{DynamicResource Win.Close}"/>
            </Grid>
            <ScrollViewer x:Name="SpotlightPanelScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="SpotlightPanelHost" Margin="24,4,24,32" Spacing="20"/>
            </ScrollViewer>
            <ScrollViewer x:Name="SpotlightPanelCogScroll" Grid.Row="1" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <Border x:Name="SpotlightPanelCogHost" Margin="24,4,24,32"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- The overlay backdrop continues over the status bar (same dim); a click there closes the overlay too. -->
    <Border x:Name="StatusBarBackdrop" Classes="libraryBackdrop" Grid.Row="2" IsVisible="False" ZIndex="1"
            PointerPressed="LibraryBackdrop_PointerPressed"/>
    <Border x:Name="StatusBar" Grid.Row="2" Padding="12,6" Background="{DynamicResource RhiStatusBarBrush}" BorderBrush="{DynamicResource RhiBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <!-- #293: games found in the custom game folders; a link, never a modal (upstream 2.9.0's status-bar notice). -->
        <Button x:Name="CustomGamesNotice" Content="{Binding CustomGamesNoticeText}" IsVisible="{Binding ShowCustomGamesNotice}"
                ToolTip.Tip="{Binding CustomGamesNoticeTip}" Click="CustomGamesNotice_Click" Background="Transparent" BorderThickness="0"
                Padding="0" FontSize="10" Foreground="{DynamicResource RhiLinkBrush}" Cursor="Hand" VerticalAlignment="Center"/>
        <!-- #298: background activity, a status line for a while, else when RHI last checked for updates and the next check. -->
        <TextBlock x:Name="StatusBarText" Grid.Column="1" Text="{Binding StatusBar.Text}" Foreground="{DynamicResource RhiMutedTextBrush}" FontSize="10"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusBar.ToolTip}"/>
        <!-- w14/layouts-b (#308, upstream 2.9.0): while a controller drives Spotlight, the footer shows its hints instead. -->
        <TextBlock x:Name="ControllerHintsText" Grid.Column="1" Classes="padHints" IsVisible="False" FontSize="11"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <!-- Hidden below 700 px of window width (MainWindow.Responsive.cs). -->
        <!-- #192: clicking the version opens What's new (the fork's CHANGELOG.md), as upstream's status-bar version does. -->
        <TextBlock x:Name="ProductVersionText" Grid.Column="2" Text="{Binding ProductVersionText}" Foreground="{DynamicResource RhiFaintTextBrush}" FontSize="10"
                   Cursor="Hand" Tapped="ProductVersion_Tapped"/>
      </Grid>
    </Border>
  </Grid>
</Window>
