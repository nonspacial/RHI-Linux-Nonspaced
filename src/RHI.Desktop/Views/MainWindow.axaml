<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RHI.Desktop.ViewModels"
        xmlns:views="using:RHI.Desktop.Views"
        x:Class="RHI.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel" x:CompileBindings="True"
        Width="1450" Height="900" MinWidth="640" MinHeight="480"
        Title="{DynamicResource Ui.WindowTitle}"
        Background="#121518"
        DragDrop.AllowDrop="True" DragDrop.DragOver="GameFiles_DragOver" DragDrop.Drop="GameFiles_Drop">
  <Window.Styles>
    <!-- One dim for the whole library-overlay backdrop: over the main content and over the status bar. -->
    <Style Selector="Border.libraryBackdrop">
      <Setter Property="Background" Value="#0D1015"/>
      <Setter Property="Opacity" Value="0.75"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Toolbar: deliberately mirrors the upstream RHI layout. Always one row (ToolbarPanel): the brand subtitle hides
         first, then buttons move from the right end into the '…' menu; Settings stays pinned at the far right. -->
    <Border Grid.Row="0" Padding="16,10" Background="#0F1318" BorderBrush="#1E2630" BorderThickness="0,0,0,1">
      <views:ToolbarPanel x:Name="ToolbarRow" Spacing="8" LeadingSpacing="10" MinGap="16">
        <!-- Below 900 px the library column becomes a slide-out overlay opened from here. -->
        <Button x:Name="LibraryToggleButton" views:ToolbarPanel.Slot="Leading" Classes="rhi" Content="{DynamicResource Ui.LibraryToggle}"
                Click="LibraryToggle_Click" ToolTip.Tip="{DynamicResource Ui.LibraryToggleTip}" IsVisible="False"/>
        <StackPanel views:ToolbarPanel.Slot="Leading" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="8" Background="#122830" BorderBrush="#1E4858" BorderThickness="1">
            <TextBlock Text="R" FontWeight="Bold" FontSize="20" Foreground="#4DC9E6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="RHI" FontSize="15" FontWeight="Bold" Foreground="#4DC9E6"/>
            <TextBlock views:ToolbarPanel.Collapsible="True" Text="{DynamicResource Ui.Tagline}" FontSize="10" Foreground="#2A7A90"/>
          </StackPanel>
        </StackPanel>

        <Button x:Name="NewModsButton" Classes="rhi" Content="{Binding NewMods.ButtonText}" Click="NewMods_Click" ToolTip.Tip="{Binding NewMods.ButtonTip}"
                views:ToolbarPanel.IsAbsent="{Binding NewMods.IsHidden, FallbackValue=True}"/>
        <Button Classes="rhi" Content="{DynamicResource Ui.QuickStart}" Click="QuickStart_Click" ToolTip.Tip="{DynamicResource Ui.QuickStartTip}"/>
        <Button Classes="rhi" Content="{DynamicResource Ui.AvailableHdrMods}" Click="AvailableHdrMods_Click" ToolTip.Tip="{DynamicResource Ui.AvailableHdrModsTip}"/>
        <Border views:ToolbarPanel.IsSeparator="True" Width="1" Height="20" Background="#1E2630" Margin="4,0"/>
        <Button Classes="rhi" Content="{DynamicResource Ui.Refresh}" Command="{Binding RefreshCommand}"/>
        <Button Classes="rhi" Content="{DynamicResource Ui.AddGame}" Click="AddGame_Click" ToolTip.Tip="{DynamicResource Ui.AddGameTip}"/>
        <Button Classes="rhi" Content="{DynamicResource Ui.ShadersAddons}" Click="ShadersAddons_Click" IsEnabled="{Binding HasConfirmedPatchTarget}"/>
        <Border views:ToolbarPanel.IsSeparator="True" Width="1" Height="20" Background="#1E2630" Margin="4,0"/>
        <Button Classes="rhi" Content="{DynamicResource Ui.UpdateAll}" Command="{Binding Updates.UpdateAllCommand}" IsEnabled="{Binding Updates.CanUpdateAll}"/>
        <Button Classes="rhi" Content="{DynamicResource Ui.BatchDlss}" Click="BatchDlss_Click" IsEnabled="{Binding CanOpenDlssBatch}"
                ToolTip.Tip="{DynamicResource Ui.BatchDlssTip}"/>
        <Border views:ToolbarPanel.IsSeparator="True" Width="1" Height="20" Background="#1E2630" Margin="4,0"/>
        <Button Classes="rhi" Content="{DynamicResource Ui.Links}" Click="Links_Click"/>
        <Button Classes="rhi" Content="{DynamicResource Ui.Motd}" Click="Motd_Click" ToolTip.Tip="{DynamicResource Ui.MotdTip}"/>
        <Button Classes="rhi" Content="{DynamicResource Ui.UpdateHistory}" Click="UpdateHistory_Click" ToolTip.Tip="{DynamicResource Ui.UpdateHistoryTip}"/>
        <Button Classes="rhi" Content="{DynamicResource Ui.Donate}" Click="Donate_Click" ToolTip.Tip="{DynamicResource Ui.DonateTip}"/>
        <Border views:ToolbarPanel.IsSeparator="True" Width="1" Height="20" Background="#1E2630" Margin="4,0"/>
        <Button Classes="rhi" Content="{Binding ViewToggleText}" Click="ViewMode_Click" ToolTip.Tip="{DynamicResource Ui.ViewModeTip}"/>
        <Button x:Name="ToolbarOverflowButton" views:ToolbarPanel.Slot="Overflow" Classes="rhi" Content="…"
                ToolTip.Tip="{DynamicResource Ui.MoreActions}" AutomationProperties.Name="{DynamicResource Ui.MoreActions}">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="ToolbarOverflowMenu_Opening" FlyoutPresenterClasses="toolbarOverflow"/>
          </Button.Flyout>
        </Button>
        <Button views:ToolbarPanel.Slot="Trailing" Classes="rhi" Content="{DynamicResource Ui.Settings}" Click="Settings_Click"/>
      </views:ToolbarPanel>
    </Border>

    <Grid x:Name="MainContentGrid" Grid.Row="1" ColumnDefinitions="300,*">
      <!-- Below 900 px the column is removed and the same sidebar opens over this dimmed backdrop (MainWindow.Responsive.cs). -->
      <Border x:Name="LibraryBackdrop" Classes="libraryBackdrop" Grid.ColumnSpan="2" IsVisible="False" ZIndex="10"
              PointerPressed="LibraryBackdrop_PointerPressed"/>
      <!-- Sidebar -->
      <Border x:Name="LibrarySidebar" Grid.Column="0" Background="#101419" BorderBrush="#1E2630" BorderThickness="0,0,1,0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <Border Grid.Row="0" Padding="10,8,10,4" Background="#131820">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{DynamicResource Ui.SearchGames}" Background="#151A22" Foreground="#A0AABB"
                     BorderBrush="#1E2630" BorderThickness="1" CornerRadius="8" Padding="10,7" FontSize="12"/>
          </Border>
          <Border x:Name="LibraryFilterBar" Grid.Row="1" Padding="10,8" Background="#131820" BorderBrush="#1E2630" BorderThickness="0,0,0,1">
            <StackPanel>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="chip" Content="{DynamicResource Ui.All}" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="All Games"/>
              <Button Classes="chip" Content="{DynamicResource Ui.Favourites}" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Favourites"/>
              <Button Classes="chip" Content="{DynamicResource Ui.Installed}" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Installed"/>
              <Button Classes="chip" Content="Unreal" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Unreal"/>
              <Button Classes="chip" Content="Unity" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Unity"/>
              <Button Classes="chip" Content="{DynamicResource Ui.Other}" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Other"/>
              <Button Classes="chip" Content="RenoDX" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="RenoDX"/>
              <Button Classes="chip" Content="Luma" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Luma"/>
              <Button Classes="chip" Content="{DynamicResource Ui.Hidden}" Margin="0,0,4,4" Command="{Binding SetLibraryFilterCommand}" CommandParameter="Hidden"/>
            </WrapPanel>
            <!-- #193 saved custom filters: "Save as filter" and one chip per saved filter (hidden while there is neither). -->
            <views:CustomFilterRow/>
            </StackPanel>
          </Border>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,8">
            <TextBlock Text="{DynamicResource Ui.Library}" Foreground="#6B7A8E" FontSize="10" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="{Binding GameCountText}" Foreground="#6B7A8E" FontSize="10"/>
          </Grid>
          <ListBox x:Name="GameLibraryList" Grid.Row="3" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGameRow}"
                   SelectionChanged="GameLibrary_SelectionChanged" Tapped="GameLibrary_Tapped" ClipToBounds="True"
                   ContextRequested="GameLibrary_ContextRequested" KeyUp="GameLibrary_KeyUp"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Background="Transparent" BorderThickness="0" Margin="6,0,6,6">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GameRowViewModel">
                <Border Padding="10,8" Margin="0,1" CornerRadius="7" Background="#151C28" BorderBrush="#1E2C40" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Foreground="#E2E8FF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Source}" Foreground="#6B7A8E" FontSize="9"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding LibraryBadge}" Foreground="#D4A856" VerticalAlignment="Center" FontSize="12"/>
                    <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="#5ECB7D" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource Ui.DetectedLinuxTip}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Detail panel -->
      <ScrollViewer x:Name="DetailScroller" Grid.Column="1" Background="#121518">
        <Grid x:Name="DetailRoot" Margin="24" RowDefinitions="Auto,Auto" RowSpacing="14">
          <!-- Responsive header: steps typography down, then moves the actions below the title, then trims (DetailHeaderPanel). -->
          <views:DetailHeaderPanel Grid.Row="0" RowSpacing="8">
            <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center">
              <!-- Identity badges: first = library source, second = launcher/platform. Never shrunk by trimming. -->
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="ShowLibraryProviderBadge"/>
                    <Binding Path="ShowLaunchProviderBadge"/>
                  </MultiBinding>
                </StackPanel.IsVisible>
                <Border views:DetailHeaderPanel.Role="Badge" Width="50" Height="50" CornerRadius="9" Background="#151A22" BorderBrush="#1E4858" BorderThickness="1"
                        Padding="5" IsVisible="{Binding ShowLibraryProviderBadge}" ToolTip.Tip="{Binding LibraryProviderToolTip}">
                  <Image Source="{Binding SelectedLibraryProviderIcon}" Stretch="Uniform"/>
                </Border>
                <Border views:DetailHeaderPanel.Role="Badge" Width="50" Height="50" CornerRadius="9" Background="#151A22" BorderBrush="#1E4858" BorderThickness="1"
                        Padding="5" IsVisible="{Binding ShowLaunchProviderBadge}" ToolTip.Tip="{Binding LaunchProviderToolTip}">
                  <Image Source="{Binding SelectedLaunchProviderIcon}" Stretch="Uniform"/>
                </Border>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SelectedTitleText" views:DetailHeaderPanel.Role="Title" Text="{Binding SelectedTitle}" FontSize="25" FontWeight="SemiBold" Foreground="#E8ECF2"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedTitle}"/>
                <TextBlock x:Name="SelectedSourceText" views:DetailHeaderPanel.Role="Subtitle" Text="{Binding SelectedSource}" FontSize="12" Foreground="#4DC9E6" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedSource}"/>
              </StackPanel>
            </DockPanel>
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{Binding FavouriteActionText}" Command="{Binding ToggleFavouriteCommand}" IsEnabled="{Binding HasSelectedGame}"/>
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{Binding HideActionText}" Command="{Binding ToggleHiddenCommand}" IsEnabled="{Binding HasSelectedGame}"/>
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{DynamicResource Ui.Edit}" Click="EditGame_Click" IsEnabled="{Binding CanEditSelectedGame}"
                      ToolTip.Tip="{DynamicResource Ui.EditTip}"/>
              <!-- Only manually added games can be removed; hide the button for everything else. -->
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{DynamicResource Ui.RemoveManual}" Command="{Binding ManualGames.RemoveManualGameCommand}" IsEnabled="{Binding ManualGames.CanRemoveManualGame}"
                      IsVisible="{Binding SelectedGame.IsManuallyAdded, FallbackValue=False, TargetNullValue=False}"
                      ToolTip.Tip="{DynamicResource Ui.RemoveManualTip}"/>
              <!-- Only shown when RHI's records still point to the folder the game was moved from. -->
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{DynamicResource Ui.RepairMove}" Command="{Binding RepairAfterMoveCommand}"
                      IsVisible="{Binding ShowRepairAfterMove}"
                      ToolTip.Tip="{DynamicResource Ui.RepairMoveTip}"/>
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{DynamicResource Ui.OpenFolder}" Command="{Binding OpenGameFolderCommand}" IsEnabled="{Binding HasConfirmedPatchTarget}"/>
              <Button views:DetailHeaderPanel.Role="Action" Classes="rhi" Content="{DynamicResource Ui.OpenPrefix}" Command="{Binding OpenPrefixCommand}" IsEnabled="{Binding HasSelectedGame}"/>
              <Button views:DetailHeaderPanel.Role="Action" Content="{DynamicResource Ui.Play}" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}"
                      ToolTip.Tip="{Binding LaunchToolTip}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000"
                      Background="#182840" Foreground="#7AACDD" BorderBrush="#2A4468" BorderThickness="1"
                      CornerRadius="8" Padding="16,8"/>
            </WrapPanel>
          </views:DetailHeaderPanel>

          <!-- Detail sections are collapsible and drag-reorderable; Linux stores state in XDG_CONFIG_HOME. -->
          <StackPanel x:Name="DetailSectionsPanel" Grid.Row="1" Spacing="14">
            <Border x:Name="RuntimeSection" Tag="Runtime" Classes="card"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="Runtime" FontSize="18" Foreground="#6B7A8E"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Ui.ExecutionGame}" FontSize="16" FontWeight="SemiBold" Foreground="#E8ECF2"/>
                    <TextBlock Text="{DynamicResource Ui.ExecutionGameNote}" Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RuntimeSectionSummary" FontSize="11" Margin="0,3,0,0" IsVisible="False"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button x:Name="RuntimeSectionToggle" Grid.Column="2" Tag="Runtime" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>
                <!-- Label/value form; labels move above their values below ~760 px of detail width. -->
                <views:LabelValuePanel x:Name="RuntimeSectionBody" Margin="0,10,0,0" ColumnSpacing="18" RowSpacing="8" StackBelow="678">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Ui.Launcher}" Classes="muted"/>
                  <views:MiddleEllipsisText Grid.Row="0" Grid.Column="1" FullText="{Binding SelectedLaunchExecutable}" Foreground="#A0AABB"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Ui.TargetSafety}" Classes="muted"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PatchTargetStatusText}" Foreground="#4DC9E6" TextWrapping="Wrap"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Ui.GameRoot}" Classes="muted"/>
                  <views:MiddleEllipsisText Grid.Row="2" Grid.Column="1" FullText="{Binding SelectedInstallPath}" Foreground="#A0AABB"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Ui.Prefix}" Classes="muted"/>
                  <views:MiddleEllipsisText Grid.Row="3" Grid.Column="1" FullText="{Binding SelectedPrefix}" Foreground="#A0AABB"/>

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Ui.TargetExe}" Classes="muted"/>
                  <views:MiddleEllipsisText Grid.Row="4" Grid.Column="1" FullText="{Binding SelectedExecutable}" Foreground="#A0AABB"/>

                  <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Ui.PatchDirectory}" Classes="muted"/>
                  <views:MiddleEllipsisText Grid.Row="5" Grid.Column="1" FullText="{Binding SelectedBinaryDirectory}" Foreground="#A0AABB"/>

                  <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Ui.GraphicsApi}" Classes="muted"/>
                  <TextBlock Grid.Row="6" Grid.Column="1" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel" Text="{Binding SelectedApi}" Foreground="#A0AABB" TextWrapping="Wrap"/>

                  <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource Ui.ForceApi}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"/>
                  <StackPanel Grid.Row="7" Grid.Column="1" Spacing="4" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel">
                    <ComboBox Width="180" HorizontalAlignment="Left"
                              ItemsSource="{Binding GraphicsApiOverrideOptions}"
                              SelectedItem="{Binding SelectedGraphicsApiOverride, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelectGraphicsApiOverride}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Display}"/></DataTemplate>
                              </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding GraphicsApiOverrideHint}" Foreground="#6B7A8E" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>

                  <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource Ui.LumaMode}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"/>
                  <StackPanel Grid.Row="8" Grid.Column="1" Spacing="4" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel">
                    <ComboBox Width="180" HorizontalAlignment="Left"
                              ItemsSource="{Binding LumaModeOptions}"
                              SelectedItem="{Binding SelectedLumaModePreference, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelectLumaMode}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Display}"/></DataTemplate>
                              </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding LumaPolicyText}" Foreground="#6B7A8E" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LumaCoexistenceText}" Foreground="#6B7A8E" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>

                  <!-- #251: the HDR section only for games that can use HDR; why it shows lives in the label's 2 s tooltip. -->
                  <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource Ui.HdrExecution}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"
                             IsVisible="{Binding Runtime.ShowHdrSection}" ToolTip.Tip="{Binding Runtime.HdrSectionTip}" ToolTip.ShowDelay="2000"/>
                  <StackPanel Grid.Row="9" Grid.Column="1" Spacing="5" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel" IsVisible="{Binding ShowHdrSection}">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                      <ComboBox Width="180" ItemsSource="{Binding HdrModeOptions}" SelectedItem="{Binding SelectedHdrMode, Mode=TwoWay}" IsEnabled="{Binding CanEditHdrProfile}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Display}"/></DataTemplate>
                              </ComboBox.ItemTemplate>
                      </ComboBox>
                      <CheckBox Content="{DynamicResource Ui.LegacyWsi}" IsChecked="{Binding HdrLegacyWsi, Mode=TwoWay}" IsEnabled="{Binding CanEditHdrProfile}"
                                IsVisible="{Binding ShowHdrLegacyWsi}" ToolTip.Tip="{DynamicResource Ui.LegacyWsiTip}" ToolTip.ShowDelay="2000"/>
                      <Button Classes="rhi" Content="{DynamicResource Ui.CopyLaunchProfile}" Click="CopyHdrLaunchOptions_Click" IsEnabled="{Binding CanCopyHdrLaunchOptions}"
                              IsVisible="{Binding ShowHdrLaunchProfile}" Padding="10,5"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding HdrProfileHint}" Foreground="#6B7A8E" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding HdrLaunchOptions}" Foreground="#4DC9E6" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding ShowHdrLaunchProfile}"/>
                  </StackPanel>

                  <!-- #191 resolution auto-toggle (saved with the HDR profile). w12/hdr-wsi (#251 correction): its own row, so it stays
                       wherever a switch can apply when the HDR row above is hidden. -->
                  <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding Runtime.ResolutionRowLabel}" Classes="muted" VerticalAlignment="Top" Margin="0,6,0,0"
                             IsVisible="{Binding Runtime.ShowResolutionToggle}"/>
                  <views:ResolutionToggleRow Grid.Row="10" Grid.Column="1" DataContext="{Binding Runtime}"/>

                  <TextBlock Grid.Row="11" Grid.Column="0" Text="{DynamicResource Ui.NeuralRendering}" Classes="muted"/>
                  <!-- w11/nr-check (#234, owner pick A'): "Check…" right after the recommendation text, wrapping under it when the
                       line is too narrow; hidden where the page would have nothing to show. -->
                  <WrapPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" ItemSpacing="12" LineSpacing="6">
                    <TextBlock DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel" Text="{Binding NeuralRenderingRecommendation}" Foreground="#7AACDD" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="NeuralRenderingCheckButton" Classes="rhi" Padding="12,4" VerticalAlignment="Center"
                            Content="{Binding NrCheck.ButtonText}" Command="{Binding NrCheck.OpenCommand}" IsVisible="{Binding NrCheck.IsAvailable}"
                            ToolTip.Tip="{Binding NrCheck.ButtonTip}" ToolTip.ShowDelay="2000"/>
                  </WrapPanel>

                  <TextBlock Grid.Row="12" Grid.Column="0" Text="{DynamicResource Ui.EngineArchitecture}" Classes="muted"/>
                  <TextBlock Grid.Row="12" Grid.Column="1" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel" Text="{Binding SelectedEngineHint}" Foreground="#A0AABB" TextWrapping="Wrap"/>

                  <TextBlock Grid.Row="13" Grid.Column="0" Text="{DynamicResource Ui.ApiEvidence}" Classes="muted"/>
                  <TextBlock Grid.Row="13" Grid.Column="1" DataContext="{Binding Runtime}" x:DataType="vm:RuntimePanelViewModel" Text="{Binding SelectedApiEvidence}" Foreground="#6B7A8E" TextWrapping="Wrap"/>
                </views:LabelValuePanel>
              </StackPanel>
            </Border>

            <Border x:Name="DlssStreamlineSection" Tag="DlssStreamline" Classes="card" BorderBrush="#1E4858"
                    DataContext="{Binding Dlss}" x:DataType="vm:DlssPanelViewModel"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="DlssStreamline" FontSize="18" Foreground="#6B7A8E"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Ui.DlssStreamline}" FontSize="16" FontWeight="SemiBold" Foreground="#E8ECF2"/>
                    <TextBlock Text="{Binding DlssStatusSummary}" Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Border Grid.Column="2" Background="#122830" BorderBrush="#1E4858" BorderThickness="1" CornerRadius="8" Padding="10,5" MaxHeight="40">
                    <TextBlock Text="{DynamicResource Ui.GameDlls}" Foreground="#4DC9E6" FontSize="11"/>
                  </Border>
                  <Button x:Name="DlssStreamlineSectionToggle" Grid.Column="3" Tag="DlssStreamline" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>

                <StackPanel x:Name="DlssStreamlineSectionBody" Spacing="10">
                  <!-- One Grid-identical row per component; the controls wrap under the status when it would get < 220 px. -->
                  <!-- The version dropdowns are 190 px, wide enough for "310.8.2 (20/30/40/50)" so the five rows stay aligned, and
                       grow to a longer selected label: a closed ComboBox clips a long label with no ellipsis. -->
                  <StackPanel Spacing="7">
                    <views:ResponsiveRow Columns="170,*,145,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="2" MinStarWidth="220">
                      <TextBlock Text="{DynamicResource Ui.SuperResolution}" Foreground="#E8ECF2" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      <views:MiddleEllipsisText Grid.Column="1" FullText="{Binding DlssSrPath}" Classes="muted" WrapNonPath="False" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Background="#102331" BorderBrush="#1E4858" BorderThickness="1" CornerRadius="7" Padding="8,4">
                        <TextBlock Text="{Binding DlssSrDeploymentState}" Foreground="#7AACDD" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </Border>
                      <ComboBox Grid.Column="3" MinWidth="190" ItemsSource="{Binding DlssSrVersions}" SelectedItem="{Binding SelectedDlssSrVersion}" IsEnabled="{Binding CanSwapDlssSr}"/>
                      <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Apply}" Command="{Binding SwapDlssComponentCommand}" CommandParameter="SR" IsEnabled="{Binding CanSwapDlssSr}"/>
                      <Button Grid.Column="5" Classes="rhi" Content="{DynamicResource Ui.Restore}" Command="{Binding RestoreDlssComponentCommand}" CommandParameter="SR" IsEnabled="{Binding DlssSrRestoreAvailable}"/>
                    </views:ResponsiveRow>
                    <views:ResponsiveRow Columns="170,*,145,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="2" MinStarWidth="220">
                      <TextBlock Text="{DynamicResource Ui.RayReconstruction}" Foreground="#E8ECF2" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      <views:MiddleEllipsisText Grid.Column="1" FullText="{Binding DlssRrPath}" Classes="muted" WrapNonPath="False" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Background="#102331" BorderBrush="#1E4858" BorderThickness="1" CornerRadius="7" Padding="8,4">
                        <TextBlock Text="{Binding DlssRrDeploymentState}" Foreground="#7AACDD" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </Border>
                      <ComboBox Grid.Column="3" MinWidth="190" ItemsSource="{Binding DlssRrVersions}" SelectedItem="{Binding SelectedDlssRrVersion}" IsEnabled="{Binding CanSwapDlssRr}"/>
                      <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Apply}" Command="{Binding SwapDlssComponentCommand}" CommandParameter="RR" IsEnabled="{Binding CanSwapDlssRr}"/>
                      <Button Grid.Column="5" Classes="rhi" Content="{DynamicResource Ui.Restore}" Command="{Binding RestoreDlssComponentCommand}" CommandParameter="RR" IsEnabled="{Binding DlssRrRestoreAvailable}"/>
                    </views:ResponsiveRow>
                    <views:ResponsiveRow Columns="170,*,145,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="2" MinStarWidth="220">
                      <TextBlock Text="{DynamicResource Ui.FrameGeneration}" Foreground="#E8ECF2" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      <views:MiddleEllipsisText Grid.Column="1" FullText="{Binding DlssFgPath}" Classes="muted" WrapNonPath="False" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Background="#102331" BorderBrush="#1E4858" BorderThickness="1" CornerRadius="7" Padding="8,4">
                        <TextBlock Text="{Binding DlssFgDeploymentState}" Foreground="#7AACDD" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </Border>
                      <ComboBox Grid.Column="3" MinWidth="190" ItemsSource="{Binding DlssFgVersions}" SelectedItem="{Binding SelectedDlssFgVersion}" IsEnabled="{Binding CanSwapDlssFg}"/>
                      <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Apply}" Command="{Binding SwapDlssComponentCommand}" CommandParameter="FG" IsEnabled="{Binding CanSwapDlssFg}"/>
                      <Button Grid.Column="5" Classes="rhi" Content="{DynamicResource Ui.Restore}" Command="{Binding RestoreDlssComponentCommand}" CommandParameter="FG" IsEnabled="{Binding DlssFgRestoreAvailable}"/>
                    </views:ResponsiveRow>
                    <views:ResponsiveRow Columns="170,*,145,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="2" MinStarWidth="220">
                      <TextBlock Text="{DynamicResource Ui.NeuralRendering}" Foreground="#E8ECF2" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      <views:MiddleEllipsisText Grid.Column="1" FullText="{Binding DlssNrPath}" Classes="muted" WrapNonPath="False" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Background="#102331" BorderBrush="#1E4858" BorderThickness="1" CornerRadius="7" Padding="8,4">
                        <TextBlock Text="{Binding DlssNrDeploymentState}" Foreground="#7AACDD" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </Border>
                      <ComboBox Grid.Column="3" MinWidth="190" ItemsSource="{Binding DlssNrVersions}" SelectedItem="{Binding SelectedDlssNrVersion}" IsEnabled="{Binding CanSwapDlssNr}"/>
                      <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Apply}" Command="{Binding SwapDlssComponentCommand}" CommandParameter="NR" IsEnabled="{Binding CanSwapDlssNr}"/>
                      <Button Grid.Column="5" Classes="rhi" Content="{DynamicResource Ui.Restore}" Command="{Binding RestoreDlssComponentCommand}" CommandParameter="NR" IsEnabled="{Binding DlssNrRestoreAvailable}"/>
                    </views:ResponsiveRow>
                    <views:ResponsiveRow Columns="170,*,145,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="2" MinStarWidth="220">
                      <TextBlock Text="{DynamicResource Ui.StreamlineUpdate}" Foreground="#E8ECF2" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                                 ToolTip.Tip="{DynamicResource Ui.StreamlineUpdateNote}"/>
                      <views:MiddleEllipsisText Grid.Column="1" FullText="{Binding StreamlinePath}" Classes="muted" WrapNonPath="False" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Background="#102331" BorderBrush="#1E4858" BorderThickness="1" CornerRadius="7" Padding="8,4">
                        <TextBlock Text="{Binding StreamlineDeploymentState}" Foreground="#7AACDD" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      </Border>
                      <ComboBox Grid.Column="3" MinWidth="190" ItemsSource="{Binding StreamlineVersions}" SelectedItem="{Binding SelectedStreamlineVersion}" IsEnabled="{Binding CanSwapStreamline}"/>
                      <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Apply}" Command="{Binding SwapStreamlineCommand}" IsEnabled="{Binding CanSwapStreamline}"/>
                      <Button Grid.Column="5" Classes="rhi" Content="{DynamicResource Ui.Restore}" Command="{Binding RestoreStreamlineCommand}" IsEnabled="{Binding StreamlineRestoreAvailable}"/>
                    </views:ResponsiveRow>
                  </StackPanel>

                  <TextBlock Text="{DynamicResource Ui.StreamlineUpdateNote}" Classes="muted" TextWrapping="Wrap"/>

                  <!-- w7/nvapi-launch (#211): a ResponsiveRow (was a Grid) so the third button, NVIDIA settings…, moves under the
                       summary when narrow; shown only where the NVIDIA settings apply. -->
                  <views:ResponsiveRow Columns="*,Auto,Auto,Auto" ColumnSpacing="8" LineSpacing="6" HeadColumns="1" MinStarWidth="160">
                    <TextBlock Text="{Binding DlssDefaultsSummary}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Classes="rhi" Content="{DynamicResource Ui.ApplyDefaults}" Command="{Binding QuickApplyDlssDefaultsCommand}"
                            IsEnabled="{Binding CanQuickApplyDlssDefaults}" Padding="12,6"
                            ToolTip.Tip="{DynamicResource Ui.ApplyDefaultsTip}"/>
                    <Button Grid.Column="2" Classes="rhi" Content="{DynamicResource Ui.RestoreAll}" Command="{Binding RestoreAllDlssCommand}"
                            IsEnabled="{Binding CanRestoreAllDlss}" Padding="12,6"/>
                    <Button Grid.Column="3" x:Name="NvidiaSettingsButton" Classes="rhi" Content="{Binding Nvidia.ButtonText}" Padding="12,6"
                            IsVisible="{Binding Nvidia.IsShown}" Click="NvidiaSettings_Click"
                            ToolTip.Tip="{Binding Nvidia.ButtonTip}" ToolTip.ShowDelay="2000"/>
                  </views:ResponsiveRow>

                  <TextBlock Text="{DynamicResource Ui.DlssNote}" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="ReShadeProfileSection" Tag="ReShadeProfile" Classes="card" BorderBrush="#2A4468"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="ReShadeProfile" FontSize="18" Foreground="#6B7A8E"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Ui.ReShadeProfile}" FontSize="16" FontWeight="SemiBold" Foreground="#E8ECF2"/>
                    <TextBlock Text="{DynamicResource Ui.ReShadeProfileNote}"
                               Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button x:Name="ReShadeProfileSectionToggle" Grid.Column="2" Tag="ReShadeProfile" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>

                <StackPanel x:Name="ReShadeProfileSectionBody" Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Ui.ManagedProfileControls}" Classes="muted" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="rhi" Content="{DynamicResource Ui.CheckUpdate}" Command="{Binding ReShadeProfile.CheckReShadeUpdateCommand}" IsEnabled="{Binding HasConfirmedPatchTarget}"/>
                      <Button Content="{DynamicResource Ui.ApplyUpdate}" Command="{Binding ReShadeProfile.ApplyReShadeProfileCommand}" IsEnabled="{Binding HasConfirmedPatchTarget}"
                              Background="#182840" Foreground="#7AACDD" BorderBrush="#2A4468" BorderThickness="1" CornerRadius="8" Padding="14,7"/>
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="120,220,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Grid.Row="0" Text="{DynamicResource Ui.Channel}" Classes="muted" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ReShadeProfile.ReShadeChannels}" SelectedItem="{Binding ReShadeProfile.SelectedReShadeChannel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ReShadeProfile.ReShadeUpdateText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1" Text="{DynamicResource Ui.LegacyVersion}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding ReShadeProfile.IsReShadeLegacy}"/>
                    <!-- w5/reshade-core (#186): the RHI manifest's legacy versions (ReShadeLegacyPresenter). -->
                    <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ReShadeLegacy.Versions}"
                              SelectedItem="{Binding ReShadeProfile.ReShadeLegacyVersion, Mode=TwoWay}" IsVisible="{Binding ReShadeProfile.IsReShadeLegacy}"
                              ToolTip.Tip="{Binding ReShadeLegacy.VersionTip}" ToolTip.ShowDelay="2000"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource Ui.LegacyVersionNote}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding ReShadeProfile.IsReShadeLegacy}"/>

                    <TextBlock Grid.Row="2" Text="{DynamicResource Ui.CustomDll}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding ReShadeProfile.IsReShadeCustom}"/>
                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding ReShadeProfile.IsReShadeCustom}">
                      <TextBox Text="{Binding ReShadeProfile.ReShadeCustomDllPath}" PlaceholderText="{DynamicResource Ui.CustomDllPlaceholder}"/>
                      <Button Grid.Column="1" Content="{DynamicResource Ui.Browse}" Click="BrowseReShadeCustomDll_Click" Padding="12,6"/>
                      <Button Grid.Column="2" Content="{DynamicResource Ui.Clear}" Click="ClearReShadeCustomDll_Click" Padding="12,6"/>
                    </Grid>
                  </Grid>

                  <!-- w5/reshade-core (#186): the RHI manifest's ReShade note for this game (reshadeGameInfo). -->
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ReShadeLegacy.HasNote}">
                    <TextBlock Text="{Binding ReShadeLegacy.Note}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="{Binding ReShadeLegacy.NoteLinkLabel}" Command="{Binding ReShadeLegacy.OpenNoteLinkCommand}"
                            IsVisible="{Binding ReShadeLegacy.HasNoteLink}" Padding="12,6" VerticalAlignment="Top"
                            ToolTip.Tip="{Binding ReShadeLegacy.NoteUrl}" ToolTip.ShowDelay="2000"/>
                  </Grid>

                  <!-- w3/dllnames (#120): ReShade's proxy DLL name; DllNamePickerViewModel. w7/reshade (#196): Reset DLL names
                       beside it, wrapping below at narrow widths. -->
                  <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="6" IsVisible="{Binding DllNamePicker.IsAvailable}">
                    <Grid ColumnDefinitions="120,220" ColumnSpacing="10">
                      <TextBlock Text="{Binding DllNamePicker.Label}" Classes="muted" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding DllNamePicker.Options}"
                                SelectedItem="{Binding DllNamePicker.SelectedOption, Mode=TwoWay}" IsEnabled="{Binding DllNamePicker.CanChoose}"
                                ToolTip.Tip="{Binding DllNamePicker.Hint}" ToolTip.ShowOnDisabled="True" ToolTip.ShowDelay="2000"/>
                    </Grid>
                    <Button x:Name="ResetDllNamesButton" Content="{Binding DllNamePicker.ResetLabel}" Command="{Binding DllNamePicker.ResetCommand}"
                            IsVisible="{Binding DllNamePicker.CanReset}" IsEnabled="{Binding !IsBusy}" Padding="12,6" VerticalAlignment="Center"
                            ToolTip.Tip="{Binding DllNamePicker.ResetTip}" ToolTip.ShowDelay="2000"/>
                  </WrapPanel>

                  <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                    <TextBlock Text="D3DCompiler 47" Classes="muted" VerticalAlignment="Top" Margin="0,7,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="7">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding ReShadeProfile.ReShadeD3DCompiler47Path}"
                                 PlaceholderText="{DynamicResource Ui.D3DCompilerPlaceholder}"/>
                        <Button Grid.Column="1" Content="{DynamicResource Ui.Browse}" Click="BrowseD3DCompiler47_Click" Padding="12,6"/>
                        <Button Grid.Column="2" Content="{DynamicResource Ui.Clear}" Click="ClearD3DCompiler47_Click" Padding="12,6"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{DynamicResource Ui.InstallProtontricks}"
                                Command="{Binding ReShadeProfile.InstallD3DCompilerWithProtontricksCommand}"
                                IsVisible="{Binding ReShadeProfile.CanInstallD3DCompilerWithProtontricks}"
                                Padding="12,6"/>
                        <Button Content="{Binding ReShadeProfile.D3DCompilerWinetricksButtonText}"
                                Command="{Binding ReShadeProfile.InstallD3DCompilerWithWinetricksCommand}"
                                IsVisible="{Binding ReShadeProfile.CanInstallD3DCompilerWithWinetricks}"
                                Padding="12,6"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding ReShadeProfile.D3DCompilerToolHint}" Classes="muted" TextWrapping="Wrap"/>
                  <TextBlock Text="{DynamicResource Ui.D3DCompilerNote}"
                             Classes="muted" TextWrapping="Wrap"/>

                  <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                    <TextBlock Text="{DynamicResource Ui.FeederConsumer}" Classes="muted" VerticalAlignment="Top" Margin="0,7,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="7">
                      <ComboBox Width="280" HorizontalAlignment="Left"
                                ItemsSource="{Binding Dlss5FeederConsumerOptions}"
                                SelectedItem="{Binding SelectedDlss5FeederConsumer, Mode=TwoWay}"/>
                      <StackPanel Spacing="7" IsVisible="{Binding IsDeepFriedChickenFeederConsumer}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBox Text="{Binding Dlss5FeederConsumerPackagePath}"
                                   PlaceholderText="{DynamicResource Ui.FeederPackagePlaceholder}"/>
                          <Button Grid.Column="1" Content="{DynamicResource Ui.Browse}" Click="BrowseDlss5FeederConsumer_Click" Padding="12,6"/>
                          <Button Grid.Column="2" Content="{DynamicResource Ui.Clear}" Click="ClearDlss5FeederConsumer_Click" Padding="12,6"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Ui.FeederPackageNote}" Classes="muted" TextWrapping="Wrap"/>
                      </StackPanel>
                      <TextBlock Text="{DynamicResource Ui.FeederRenoDxNote}" Classes="muted" TextWrapping="Wrap"
                                 IsVisible="{Binding IsRenoDxDlss5FeederConsumer}"/>
                    </StackPanel>
                  </Grid>

                  <Border Background="#0D141C" BorderBrush="#223247" BorderThickness="1" CornerRadius="7" Padding="10"
                          DataContext="{Binding Extras}" x:DataType="vm:ExtrasViewModel">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{DynamicResource Ui.NrVersions}" Classes="muted" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Ui.LatestPinNote}" Classes="muted" TextWrapping="Wrap"/>
                        <Button Grid.Column="2" Content="{DynamicResource Ui.LoadHistory}" Command="{Binding LoadNeuralVersionHistoryCommand}"
                                IsEnabled="{Binding CanLoadNeuralVersionHistory}" Padding="12,6"/>
                      </Grid>
                      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="7">
                        <Grid ColumnDefinitions="120,220" ColumnSpacing="8">
                          <TextBlock Text="Feeder" Classes="muted" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding Dlss5FeederVersionOptions}"
                                    SelectedItem="{Binding SelectedDlss5FeederVersion, Mode=TwoWay}"
                                    IsEnabled="{Binding CanConfigureFeederVersionPin}"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,220" ColumnSpacing="8">
                          <TextBlock Text="DX11 Bridge" Classes="muted" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding Dlss5BridgeVersionOptions}"
                                    SelectedItem="{Binding SelectedDlss5BridgeVersion, Mode=TwoWay}"
                                    IsEnabled="{Binding CanConfigureBridgeVersionPin}"/>
                        </Grid>
                        <Grid ColumnDefinitions="100,220" ColumnSpacing="8">
                          <TextBlock Text="ShortFuse" Classes="muted" VerticalAlignment="Center"/>
                          <ComboBox Grid.Column="1" ItemsSource="{Binding ShortFuseVersionOptions}"
                                    SelectedItem="{Binding SelectedShortFuseVersion, Mode=TwoWay}"
                                    IsEnabled="{Binding CanConfigureShortFuseVersionPin}"/>
                        </Grid>
                      </WrapPanel>
                      <Grid ColumnDefinitions="120,220,*" ColumnSpacing="8">
                        <TextBlock Text="NR DLL" Classes="muted" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding NeuralRenderingDllVersionOptions}"
                                  SelectedItem="{Binding SelectedNeuralRenderingDllVersion, Mode=TwoWay}"
                                  ToolTip.Tip="{Binding NeuralRenderingDllVersionsTip}" ToolTip.ShowDelay="2000"
                                  IsEnabled="{Binding CanConfigureNeuralRenderingDllVersion}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Ui.NrDllVersionNote}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      </Grid>
                      <views:NrCostScalerRow/> <!-- w3/parity hook (#96) -->
                    </StackPanel>
                  </Border>

                  <WrapPanel Orientation="Horizontal" ItemSpacing="14" LineSpacing="4">
                    <CheckBox Content="{DynamicResource Ui.ManageReShadeIni}" IsChecked="{Binding ReShadeProfile.ReShadeManageIni}"/>
                    <TextBlock Text="{DynamicResource Ui.QuickPackages}" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <CheckBox Content="{DynamicResource Ui.Official}" IsChecked="{Binding ReShadeProfile.ShaderCrosireMaster}" ToolTip.Tip="crosire reshade-shaders master"/>
                    <CheckBox Content="{DynamicResource Ui.OfficialLegacy}" IsChecked="{Binding ReShadeProfile.ShaderCrosireLegacy}"/>
                    <CheckBox Content="clshortfuse HDR" IsChecked="{Binding ReShadeProfile.ShaderClshortfuse}"/>
                    <CheckBox Content="MaxG2D HDR" IsChecked="{Binding ReShadeProfile.ShaderMaxG2D}"/>
                    <Button Classes="rhi" Content="{DynamicResource Ui.FullShaderManager}" Click="ShadersAddons_Click" IsEnabled="{Binding HasConfirmedPatchTarget}" Padding="12,6"/>
                  </WrapPanel>
                  <TextBlock Text="{DynamicResource Ui.XdgSettingsNote}"
                             Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="ManagedComponentsSection" Tag="ManagedComponents" Classes="card"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="ManagedComponents" FontSize="18" Foreground="#6B7A8E"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Ui.ManagedComponents}" FontSize="16" FontWeight="SemiBold" Foreground="#E8ECF2"/>
                    <TextBlock Text="{DynamicResource Ui.ManagedComponentsNote}"
                               Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ManagedComponentsSectionSummary" FontSize="11" Margin="0,3,0,0" IsVisible="False"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Border Grid.Column="2" Background="#122818" BorderBrush="#1E4028" BorderThickness="1" CornerRadius="8" Padding="10,5" MaxHeight="40">
                    <TextBlock Text="{DynamicResource Ui.LinuxBackendActive}" Foreground="#5ECB7D" FontSize="11"/>
                  </Border>
                  <Button x:Name="ManagedComponentsSectionToggle" Grid.Column="3" Tag="ManagedComponents" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>

                <ItemsControl x:Name="ManagedComponentsSectionBody" ItemsSource="{Binding Components}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComponentRowViewModel">
                      <Border Background="#101820" BorderBrush="#1E2630" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="14,11">
                        <StackPanel Spacing="6">
                          <views:ResponsiveRow Columns="220,180,*,Auto,Auto,Auto" ColumnSpacing="12" LineSpacing="8" HeadColumns="2" MinStarWidth="160">
                            <!-- Names wider than the 220 px column end in a word ellipsis; the full name is in a 2 s tooltip. -->
                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#E8ECF2" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="WordEllipsis" ToolTip.Tip="{Binding Name}" ToolTip.ShowDelay="2000"/>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#5ECB7D" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Note}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="3" Classes="rhi" Content="⚙" IsVisible="{Binding HasRenoDxSettings}"
                                    Click="RenoDxSettings_Click" ToolTip.Tip="{DynamicResource Ui.RenoDxSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="3" Classes="rhi" Content="⚙" IsVisible="{Binding HasOptiScalerSettings}"
                                    Click="OptiScalerSettings_Click" ToolTip.Tip="{DynamicResource Ui.OptiScalerSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="3" Classes="rhi" Content="⚙" IsVisible="{Binding HasDlssg2030Settings}"
                                    Click="Dlssg2030Settings_Click" ToolTip.Tip="{DynamicResource Ui.Dlssg2030SettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="3" Classes="rhi" Content="⚙" IsVisible="{Binding HasStandaloneDlssEnablerSettings}"
                                    Click="StandaloneDlssEnablerSettings_Click" ToolTip.Tip="{DynamicResource Ui.DlssEnablerStandaloneSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="3" Classes="rhi" Content="⚙" IsVisible="{Binding HasRtx40MfgSettings}"
                                    Click="Rtx40MfgSettings_Click" ToolTip.Tip="{DynamicResource Ui.Rtx40MfgSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="3" Classes="rhi" Content="⚙" IsVisible="{Binding HasRtxEncoreSettings}"
                                    Click="RtxEncoreSettings_Click" ToolTip.Tip="{DynamicResource Ui.RtxEncoreSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="3" Classes="rhi" Content="⚙" IsVisible="{Binding HasReFrameworkSettings}"
                                    Click="ReFrameworkSettings_Click" ToolTip.Tip="{Binding ReFrameworkSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="3" Classes="rhi" Content="⚙" IsVisible="{Binding HasIniSettings}"
                                    Click="IniSettings_Click" ToolTip.Tip="{Binding IniSettingsTip}" Padding="10,6"/>
                            <Button Grid.Column="3" Classes="rhi" Content="⚙" IsVisible="{Binding HasDxvkHdrSettings}"
                                    Click="DxvkHdrSettings_Click" ToolTip.Tip="{Binding DxvkHdrSettingsTip}" ToolTip.ShowDelay="2000" Padding="10,6"/>
                            <Button Grid.Column="4" Classes="rhi" Classes.remove="{Binding IsRemoveAction}"
                                    Content="{Binding Action}" IsEnabled="{Binding IsActionEnabled}" Command="{Binding Command}"
                                    CommandParameter="{Binding CommandParameter}" ToolTip.Tip="{Binding Note}" MinWidth="80" IsVisible="{Binding HasAction}"/>
                            <!-- #210: highlighted (accent border on the pressed-state surface) when the dialog has notes for this game. -->
                            <Button Grid.Column="5" Classes="rhi" Classes.gameNotes="{Binding InfoHighlight.IsGameSpecific}" Content="ⓘ"
                                    IsVisible="{Binding HasInfo}" Click="ComponentInfo_Click"
                                    ToolTip.Tip="{Binding InfoHighlight.Tip}" ToolTip.ShowDelay="2000" Padding="10,6">
                              <Button.Styles>
                                <Style Selector="Button.rhi.gameNotes">
                                  <Setter Property="Background" Value="{DynamicResource RhiControlPressedBrush}"/>
                                  <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
                                </Style>
                                <Style Selector="Button.rhi.gameNotes:pointerover">
                                  <Setter Property="Background" Value="{DynamicResource RhiControlHoverBrush}"/>
                                  <Setter Property="BorderBrush" Value="{DynamicResource RhiAccentBrush}"/>
                                </Style>
                              </Button.Styles>
                            </Button>
                          </views:ResponsiveRow>
                          <!-- RenoDX/Luma only: installed add-on file name(s) and mod author on one line; a line wider than
                               the row is shortened in the middle, full text in a 2 s tooltip. -->
                          <views:MiddleEllipsisText FullText="{Binding Credit}" IsVisible="{Binding HasCredit}" Classes="muted" FontSize="11"
                                                    WrapNonPath="False" MiddleNonPath="True"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border x:Name="ExtrasSection" Tag="Extras" Classes="card" BorderBrush="#3A3348"
                    DataContext="{Binding Extras}" x:DataType="vm:ExtrasViewModel"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="Section_DragOver" DragDrop.Drop="Section_Drop">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="≡" Tag="Extras" FontSize="18" Foreground="#6B7A8E"
                             VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Ui.DragSectionTip}"
                             PointerPressed="SectionDragHandle_PointerPressed"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Ui.Extras}" FontSize="16" FontWeight="SemiBold" Foreground="#E8ECF2"/>
                    <TextBlock Text="{DynamicResource Ui.ExtrasNote}" Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ExtrasSectionSummary" FontSize="11" Margin="0,3,0,0" IsVisible="False"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Button x:Name="ExtrasSectionToggle" Grid.Column="2" Tag="Extras" Classes="rhi" Content="▼"
                          Click="ToggleSection_Click" ToolTip.Tip="{DynamicResource Ui.CollapseExpandTip}" Padding="8,4"/>
                </Grid>
                <StackPanel x:Name="ExtrasSectionBody" Spacing="10">
                  <views:ResponsiveRow Columns="150,150,190,Auto,Auto,Auto" ColumnSpacing="10" LineSpacing="8" HeadColumns="2">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Ultimate ASI Loader" Foreground="#E8ECF2" FontWeight="SemiBold"/>
                      <TextBlock Text="{DynamicResource Ui.WineProtonProxy}" Classes="muted" FontSize="10"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding UalStatusText}" Foreground="#5ECB7D"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding UalProxyNames}"
                              SelectedItem="{Binding SelectedUalProxyName}"
                              IsEnabled="{Binding CanSelectUalProxy}"
                              ToolTip.Tip="{DynamicResource Ui.ProxyNameTip}"/>

                    <Button Grid.Column="3" Classes="rhi" Content="{DynamicResource Ui.CheckUpdate}"
                            Command="{Binding CheckUalUpdateCommand}"
                            IsEnabled="{Binding HasSelectedGame}"
                            Padding="12,6"/>

                    <Button Grid.Column="4" Classes="rhi" Content="{Binding UalActionText}"
                            Command="{Binding InstallOrUpdateUalCommand}"
                            IsEnabled="{Binding CanInstallOrUpdateUal}"
                            Padding="12,6"/>

                    <Button Grid.Column="5" Classes="rhi remove" Content="{DynamicResource Ui.Remove}"
                            Command="{Binding RemoveUalCommand}"
                            IsEnabled="{Binding CanRemoveUal}"
                            Padding="12,6"/>
                  </views:ResponsiveRow>

                  <TextBlock Text="{Binding UalProxyHint}" Classes="muted" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding UalLatestVersionText}" Classes="muted" TextWrapping="Wrap"/>

                  <Border Height="1" Background="#2A3038" Margin="0,4"/>
                  <views:ResponsiveRow Columns="150,180,190,Auto,Auto" ColumnSpacing="10" LineSpacing="8" HeadColumns="2">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="ShortFuse / DLSS FG" Foreground="#E8ECF2" FontWeight="SemiBold"/>
                      <TextBlock Text="{DynamicResource Ui.PerGameOrchestration}" Classes="muted" FontSize="10"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ShortFuseStatusText}" Foreground="#5ECB7D" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <CheckBox Grid.Column="2" Content="{DynamicResource Ui.AutoAsiConfig}" IsChecked="{Binding ShortFuseAutoConfigEnabled}"
                              IsEnabled="{Binding CanConfigureShortFuse}" VerticalAlignment="Center"
                              ToolTip.Tip="{DynamicResource Ui.ShortFuseAutoTip}"/>
                    <Button Grid.Column="3" Classes="rhi" Content="{DynamicResource Ui.CheckUpdate}" Command="{Binding CheckShortFuseUpdateCommand}"
                            IsEnabled="{Binding HasSelectedGame}" Padding="12,6"/>
                    <Button Grid.Column="4" Classes="rhi" Content="{DynamicResource Ui.Install}" Command="{Binding InstallOrRemoveShortFuseCommand}"
                            IsVisible="{Binding ShortFuseNotInstalled}" IsEnabled="{Binding CanInstallOrRemoveShortFuse}"
                            ToolTip.Tip="{Binding ShortFuseActionHint}" Padding="12,6"/>
                    <Button Grid.Column="4" Classes="rhi remove" Content="{DynamicResource Ui.Remove}" Command="{Binding InstallOrRemoveShortFuseCommand}"
                            IsVisible="{Binding ShortFuseInstalled}" IsEnabled="{Binding CanInstallOrRemoveShortFuse}"
                            ToolTip.Tip="{Binding ShortFuseActionHint}" Padding="12,6"/>
                  </views:ResponsiveRow>
                  <CheckBox Content="{DynamicResource Ui.ShortFuseZzzLoadOrder}" IsChecked="{Binding ShortFuseZzzLoadOrder}"
                            IsEnabled="{Binding CanConfigureShortFuseZzzLoadOrder}"
                            ToolTip.Tip="{DynamicResource Ui.ShortFuseZzzTip}"/>
                  <TextBlock Text="{Binding ShortFuseLatestVersionText}" Classes="muted" TextWrapping="Wrap"/>
                  <TextBlock Text="{DynamicResource Ui.LinuxPolicyNote}" Classes="muted" TextWrapping="Wrap"/>
                  <TextBlock Text="{DynamicResource Ui.UalPolicyNote}"
                             Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border Grid.ColumnSpan="2" Background="#0D1015" Opacity="0.96" IsVisible="{Binding IsBusy}" ZIndex="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="280" Height="4"/>
          <TextBlock Text="{DynamicResource Ui.Processing}" Foreground="#A0AABB"/>
          <!-- Stops the running operation (Refs #77); hidden for operations that cannot stop part-way. -->
          <Button Classes="rhi" Content="{DynamicResource Ui.CancelOperation}" HorizontalAlignment="Center"
                  Command="{Binding Operations.CancelCommand}" IsVisible="{Binding Operations.CanCancel}"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- The overlay backdrop continues over the status bar (same dim); a click there closes the overlay too. -->
    <Border x:Name="StatusBarBackdrop" Classes="libraryBackdrop" Grid.Row="2" IsVisible="False" ZIndex="1"
            PointerPressed="LibraryBackdrop_PointerPressed"/>
    <Border x:Name="StatusBar" Grid.Row="2" Padding="12,6" Background="#0D1015" BorderBrush="#1E2630" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding StatusText}" Foreground="#6B7A8E" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}"/>
        <!-- Hidden below 700 px of window width (MainWindow.Responsive.cs). -->
        <!-- #192: clicking the version opens What's new (the fork's CHANGELOG.md), as upstream's status-bar version does. -->
        <TextBlock x:Name="ProductVersionText" Grid.Column="1" Text="{Binding ProductVersionText}" Foreground="#404858" FontSize="10"
                   Cursor="Hand" Tapped="ProductVersion_Tapped"/>
      </Grid>
    </Border>
  </Grid>
</Window>
