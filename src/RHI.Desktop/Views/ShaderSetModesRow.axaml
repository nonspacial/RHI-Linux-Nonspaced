<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RHI.Desktop.ViewModels"
             xmlns:views="using:RHI.Desktop.Views"
             x:Class="RHI.Desktop.Views.ShaderSetModesRow"
             x:DataType="vm:ReShadeProfileViewModel" x:CompileBindings="True"
             IsVisible="{Binding ShowSetModes}">
  <!-- #179: per game "Shaders: Global / Select / Off" and "Add-ons: Global / Select / Off" (upstream), side by side
       while both fit, the add-on choice below otherwise; each is hidden where it cannot apply. -->
  <views:ResponsiveRow Columns="Auto,Auto" ColumnSpacing="16" LineSpacing="7" HeadColumns="1">
    <Grid x:Name="ShaderModeGroup" ColumnDefinitions="170,180" ColumnSpacing="8" IsVisible="{Binding ShowShaderMode}">
      <TextBlock Text="{Binding ShaderModeLabel}" Foreground="#E8ECF2" FontWeight="SemiBold" VerticalAlignment="Center"
                 TextWrapping="Wrap" ToolTip.Tip="{Binding ShaderModeTip}" ToolTip.ShowDelay="2000"/>
      <ComboBox x:Name="ShaderModeBox" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding ShaderModeOptions}" SelectedItem="{Binding SelectedShaderMode, Mode=TwoWay}"
                ToolTip.Tip="{Binding ShaderModeTip}" ToolTip.ShowDelay="2000">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Display}"/></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <Grid x:Name="AddonModeGroup" Grid.Column="1" ColumnDefinitions="170,180" ColumnSpacing="8" IsVisible="{Binding ShowAddonMode}">
      <TextBlock Text="{Binding AddonModeLabel}" Foreground="#E8ECF2" FontWeight="SemiBold" VerticalAlignment="Center"
                 TextWrapping="Wrap" ToolTip.Tip="{Binding AddonModeTip}" ToolTip.ShowDelay="2000"/>
      <ComboBox x:Name="AddonModeBox" Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding AddonModeOptions}" SelectedItem="{Binding SelectedAddonMode, Mode=TwoWay}"
                ToolTip.Tip="{Binding AddonModeTip}" ToolTip.ShowDelay="2000">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:OptionItem"><TextBlock Text="{Binding Display}"/></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
  </views:ResponsiveRow>
</UserControl>
