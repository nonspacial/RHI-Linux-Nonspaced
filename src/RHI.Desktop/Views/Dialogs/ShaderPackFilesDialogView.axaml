<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RHI.Desktop.ViewModels"
             xmlns:l="using:RHI.Desktop.Localization"
             x:Class="RHI.Desktop.Views.Dialogs.ShaderPackFilesDialogView"
             x:DataType="vm:ShaderPackFilesDialogViewModel">
  <!-- A shader pack's Files dialog (epic #89): ticked = deployed. -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer>
      <StackPanel Spacing="8" Margin="14">
        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.72"/>
        <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding CanSave}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:CatalogHeading">
              <TextBlock Text="{Binding Text}" FontWeight="SemiBold" Foreground="#4DC9E6" Margin="0,8,0,0"/>
            </DataTemplate>
            <DataTemplate DataType="vm:ShaderPackFileRow">
              <CheckBox Content="{Binding DisplayPath}" IsChecked="{Binding IsChecked}" Margin="0,2"/>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="14,4,14,14">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.72"/>
      <Button Grid.Column="1" Content="{l:T Win.SaveSelection}" Padding="14,7" HorizontalAlignment="Right"
              Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"/>
    </Grid>
  </Grid>
</UserControl>
