<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RHI.Desktop.ViewModels"
             x:Class="RHI.Desktop.Views.Dialogs.SettingsDialogView"
             x:DataType="vm:SettingsDialogViewModel">
  <!-- Settings (#296, upstream 2.8.9/2.9.3): the eight sections, the section index with Find a setting and Tabs, and the
       rows are built in the code-behind (SettingsDialogView.axaml.cs) so Find a setting can index them as they are made.
       Settings save as soon as they change; the line below shows the last save or action. -->
  <Grid RowDefinitions="*,Auto">
    <Panel x:Name="PageHost"/>
    <Border Grid.Row="1" Classes="settingsFooter">
      <TextBlock x:Name="StatusLine" Text="{Binding Status}" TextWrapping="Wrap" Classes="settingsHelp" FontSize="12"/>
    </Border>
  </Grid>
</UserControl>
