<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RHI.Desktop.ViewModels"
             xmlns:views="using:RHI.Desktop.Views"
             xmlns:l="using:RHI.Desktop.Localization"
             x:Class="RHI.Desktop.Views.Dialogs.RenoDxSettingsDialogView"
             x:DataType="vm:RenoDxSettingsDialogViewModel">
  <!-- The RenoDX ⚙ (epic #89) on the shared ⚙ layout (#297, upstream 2.9.0 RdxCogButton_Click): the first card holds
       UE-Extended and the maximum nits (code-behind, Views/Cog/RenoDxCogRows.cs) and the Engine.ini rows (#217); the
       Compatibility card keeps upstream's compact two-per-row grid, the explanation in each setting's tooltip. -->
  <StackPanel Spacing="14">
    <TextBlock Text="{l:T Win.ChangesWrittenImmediatelySelectedGameRenodx}" TextWrapping="Wrap" Classes="cogIntro"/>
    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Classes="cogWarning" IsVisible="{Binding HasWarning}"/>
    <views:CogCard x:Name="MainCard" IsVisible="False">
      <StackPanel x:Name="MainRows" Spacing="10"/>
      <!-- w8/renodx (#217): Engine.ini On/Off rows (key name only in the explanation / tooltip). -->
      <ItemsControl ItemsSource="{Binding EngineIniRows}" IsVisible="{Binding HasEngineIniRows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="10"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RenoDxEngineIniRow">
            <views:CogRow Label="{Binding Label}" Help="{Binding Tooltip}">
              <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding IsIdle}" AutomationProperties.AutomationId="{Binding Name}"/>
            </views:CogRow>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </views:CogCard>
    <views:CogCard Header="{l:T Cog.Compatibility}">
      <TextBlock Text="{l:T Cog.RdxCompatibilityNote}" TextWrapping="Wrap" Classes="cogNote"/>
      <TextBlock Text="{Binding EmptyReason}" TextWrapping="Wrap" Classes="cogNote" IsVisible="{Binding HasEmptyReason}"/>
      <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <views:CogCompactGrid/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RenoDxSettingRow">
            <views:CogCell Label="{Binding Label}" Help="{Binding Tooltip}">
              <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}"/>
            </views:CogCell>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </views:CogCard>
    <TextBlock Text="{Binding IniPath}" TextWrapping="Wrap" Classes="cogNote" IsVisible="{Binding HasIniPath}"/>
    <!-- #297: results and errors inside the ⚙ (upstream's status line). -->
    <TextBlock Name="CogStatus" Text="{Binding Message}" TextWrapping="Wrap" Classes="cogStatus" IsVisible="{Binding HasMessage}"/>
  </StackPanel>
</UserControl>
