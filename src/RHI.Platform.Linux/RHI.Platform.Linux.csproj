<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RHI.Platform.Linux</RootNamespace>
    <AssemblyName>RHI.Platform.Linux</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RHI.Core/RHI.Core.csproj" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
  </ItemGroup>
  <ItemGroup>
    <!-- #97: upstream RHI 2.8.7's per-GPU OptiScaler.ini templates (GPL-3, as this project), seeded once, never overwritten. -->
    <EmbeddedResource Include="Deployment/OptiScalerTemplates/*.ini" LogicalName="OptiScalerTemplates.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RHI.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <!-- Linux-only assembly: clears the CA1416 class for Unix-only APIs (File.SetUnixFileMode, UnixCreateMode). -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
