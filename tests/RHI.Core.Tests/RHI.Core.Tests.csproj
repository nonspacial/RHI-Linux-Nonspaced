<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/RHI.Core/RHI.Core.csproj" />
    <ProjectReference Include="../../src/RHI.Platform.Linux/RHI.Platform.Linux.csproj" />
    <ProjectReference Include="../../src/RHI.Desktop/RHI.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linux-only assembly: clears the CA1416 class for Unix-only APIs (File.SetUnixFileMode, UnixCreateMode). -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
